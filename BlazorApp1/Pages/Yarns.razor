@* =====================================================================
   Pages/Yarns.razor  —  실 창고
   ===================================================================== *@
@page "/yarns"
@using KnitLog.Models
@using KnitLog.Services
@inject StorageService Storage
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject HttpClient Http
@inject AuthService Auth

<div class="page-header">
    <div>
        <h1 class="page-title"><img src="icons/yarn.svg" class="icon-line" style="width:36px;height:36px;" />실 창고</h1>
        <p class="page-subtitle">보유중인 실 목록</p>
    </div>
    <button class="btn btn-primary" @onclick="OpenAddModal" style="display:inline-flex;align-items:center;gap:5px;"><img src="icons/plus.svg" class="icon-line" style="width:14px;height:14px;flex-shrink:0;" />실 추가</button>
</div>

@if (_loading)
{
    <div class="loading">불러오는 중...</div>
}
else if (_yarns.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon"><img src="icons/yarn.svg" class="icon-line" style="width:48px;height:48px;" /></div>
        <p>보유한 실이 없어요.<br/>실 정보를 추가해 보세요!</p>
    </div>
}
else
{
    <!-- 검색 + 뷰 전환 -->
    <div style="display:flex; align-items:center; gap:8px; margin-bottom:12px; flex-wrap:wrap;">
        <div style="display:flex; align-items:center; gap:8px; position:relative; flex:1; min-width:140px; max-width:320px;">
            <img src="icons/magnifying-glass.svg" class="icon-line" style="width:15px;height:15px;flex-shrink:0;opacity:0.45;" />
            <input class="form-control" @bind-value="_searchText" @bind-value:event="oninput"
                   placeholder="실 이름, 브랜드, 색상으로 검색..." style="flex:1; min-width:0;" />
            @if (!string.IsNullOrEmpty(_searchText))
            {
                <button @onclick="ClearSearch" style="position:absolute; right:8px; top:50%; transform:translateY(-50%); background:none; border:none; cursor:pointer; padding:2px; display:flex; align-items:center; color:var(--text-light);">
                    <img src="icons/x.svg" class="icon-line" style="width:13px;height:13px;" />
                </button>
            }
        </div>
        <div style="display:flex; gap:6px; flex-shrink:0; margin-left:auto;">
            <button class="btn btn-sm @(_isListView ? "btn-ghost" : "btn-sage")" style="flex-shrink:0;"
                    @onclick='async () => { _isListView = false; await JS.InvokeVoidAsync("localStorage.setItem", "yarn_listview", "false"); }' title="카드형">
                <img src="icons/squares-four.svg" class="icon-line" style="width:16px;height:16px;" />
            </button>
            <button class="btn btn-sm @(_isListView ? "btn-sage" : "btn-ghost")" style="flex-shrink:0;"
                    @onclick='async () => { _isListView = true; await JS.InvokeVoidAsync("localStorage.setItem", "yarn_listview", "true"); }' title="리스트형">
                <img src="icons/list.svg" class="icon-line" style="width:16px;height:16px;" />
            </button>
        </div>
    </div>

    <!-- 필터 + 정렬 (태블릿 이상: 한 줄) -->
    <div class="filter-sort-bar" style="margin-bottom:16px;">
        <div class="filter-sort-group">
            <img src="icons/funnel.svg" class="icon-line" style="width:14px;height:14px;flex-shrink:0;opacity:0.45;" />
            @foreach (var (label, val) in new[]{("전체","all"),("미사용","unlinked"),("사용 중","linked"),("부족","low"),("소진","empty")})
            {
                <button class="btn btn-sm @(_filter==val?"btn-primary":"btn-ghost")" style="flex-shrink:0;"
                        @onclick='async ()=>{ _filter=val; await JS.InvokeVoidAsync("localStorage.setItem", "yarn_filter", val); }'>@label</button>
            }
        </div>
        <div class="filter-sort-divider"></div>
        <div class="filter-sort-group">
            <img src="icons/arrows-down-up.svg" class="icon-line" style="width:14px;height:14px;flex-shrink:0;opacity:0.45;" />
            @foreach (var (label, baseVal) in new[]{("등록일","created"),("이름순","name"),("브랜드순","brand")})
            {
                var ascVal  = baseVal + "_asc";
                var descVal = baseVal + "_desc";
                var isActive = _yarnSort == ascVal || _yarnSort == descVal;
                var isAsc   = _yarnSort == ascVal;
                <button class="btn btn-sm @(isActive?"btn-sage":"btn-ghost")" style="flex-shrink:0;"
                        @onclick="async () => await SetYarnSort(isActive ? (isAsc ? descVal : ascVal) : descVal)">
                    @label @if (isActive) { <img src="@(isAsc?"icons/arrow-up.svg":"icons/arrow-down.svg")" class="icon-line" style="width:11px;height:11px;margin-left:2px;" /> }
                </button>
            }
        </div>
    </div>

    @if (_isListView)
    {
        <!-- 리스트형 -->
        <div style="display:flex; flex-direction:column; gap:8px;">
            @foreach (var yarn in FilteredYarns)
            {
                <div class="card" style="cursor:pointer; display:flex; align-items:center; gap:14px; padding:12px 16px;"
                     @onclick="() => OpenEditModal(yarn)">
                    @if (!string.IsNullOrEmpty(yarn.ColorCode))
                    {
                        <span style="width:36px; height:36px; border-radius:50%; background:@yarn.ColorCode; border:1px solid var(--border); flex-shrink:0;"></span>
                    }
                    else
                    {
                        <div style="width:36px; height:36px; background:var(--ivory-dark); border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0;"><img src="icons/yarn.svg" class="icon-line" style="width:18px;height:18px;" /></div>
                    }

                    <div style="flex:1; min-width:0;">
                        <div style="display:flex; align-items:center; gap:8px; margin-bottom:2px;">
                            <span style="font-weight:700; font-size:0.95rem; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@yarn.Name</span>
                            <span style="font-size:0.78rem; color:var(--text-light); flex-shrink:0;">@yarn.Brand</span>
                        </div>
                        <div style="font-size:0.78rem; color:var(--text-mid); overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                            @GetYarnRemainingLabel(yarn)
                        </div>
                    </div>

                    <div style="display:flex; gap:6px; flex-shrink:0;" @onclick:stopPropagation="true">
                        <button class="btn btn-secondary btn-sm" @onclick="() => DuplicateYarn(yarn)" title="복제"><img src="icons/copy.svg" class="icon-line" style="width:14px;height:14px;" /></button>
                        <button class="btn btn-danger btn-sm"
                                @onclick='() => Confirm($"\"{yarn.Name}\" 실을 삭제하면 복구할 수 없어요.", async () => await DeleteYarn(yarn.Id))'>
                            <img src="icons/trash.svg" class="icon-line" style="width:14px;height:14px;" />
                        </button>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
    <div class="grid-3">
        @foreach (var yarn in FilteredYarns)
        {
            <div class="card">
                <div class="flex-between mb-1">
                    <div style="display:flex; align-items:center; gap:8px; min-width:0; flex:1 1 auto; overflow:hidden;">
                        <span class="color-dot" style="background:@yarn.ColorCode; flex-shrink:0;"></span>
                        <div class="card-title" style="margin-bottom:0; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@yarn.Name</div>
                        @if (_completedYarnIds.Contains(yarn.Id))
                        {
                            <span style="font-size:0.7rem;background:var(--ivory-dark);color:var(--text-light);padding:2px 6px;border-radius:99px;white-space:nowrap;flex-shrink:0;">완성작</span>
                        }
                    </div>
                    @{
                        decimal _used = _usedQty.TryGetValue(yarn.Id, out var _u) ? _u : 0;
                        decimal _remain = yarn.Quantity - _used;
                        string _qtyUnit = yarn.YarnType == YarnType.콘사 ? "콘" : "볼";
                    }
                    @if (yarn.Quantity > 0)
                    {
                        @if (_used > 0)
                        {
                            <span class="badge @(GetRemainBadge(_remain, yarn.Quantity))" style="font-size:0.75rem; white-space:nowrap; flex-shrink:0;">
                                @if (yarn.YarnType == YarnType.콘사 && yarn.WeightGram > 0)
                                {
                                    @((yarn.WeightGram * _remain).ToString("0"))
                                    <text>g / </text>
                                    @((yarn.WeightGram * yarn.Quantity).ToString("0"))
                                    <text>g</text>
                                }
                                else
                                {
                                    @(_remain.ToString("0.##"))
                                    <text> / </text>
                                    @(yarn.Quantity.ToString("0.##"))
                                    <text> @_qtyUnit</text>
                                }
                            </span>
                        }
                        else
                        {
                            @if (yarn.YarnType == YarnType.콘사 && yarn.WeightGram > 0)
                            {
                                <span class="badge badge-cable" style="white-space:nowrap; flex-shrink:0;">@((yarn.WeightGram * yarn.Quantity).ToString("0"))g</span>
                            }
                            else
                            {
                                <span class="badge badge-cable" style="white-space:nowrap; flex-shrink:0;">x @(yarn.Quantity.ToString("0.##")) @_qtyUnit</span>
                            }
                        }
                    }
                </div>

                @if (!string.IsNullOrEmpty(yarn.Brand))
                {
                    <div style="font-size:0.82rem; color:var(--text-mid);">@yarn.Brand</div>
                }
                @* 카드에서 워스티드(굵기 정보) 제거 - YarnType과 색상만 표시 *@
                <div style="font-size:0.82rem; color:var(--text-mid);">@yarn.Color · @yarn.YarnType</div>

                @if (!string.IsNullOrEmpty(yarn.Material))
                {
                    <div style="font-size:0.8rem; color:var(--text-light);">@yarn.Material</div>
                }
                @{
                    // 콘사인 경우 콘당 단위, 그 외 볼당 단위
                    bool isCone = yarn.YarnType == YarnType.콘사;
                    string weightUnit = isCone ? "g/콘" : "g/볼";
                    string lengthUnit = isCone ? "m/콘" : "m/볼";
                    // 총 보유 길이 계산
                    decimal totalLength = yarn.LengthMeter * yarn.Quantity;
                }
                <div style="display:flex; gap:12px; font-size:0.78rem; color:var(--text-light); margin:6px 0 2px;">
                    @if (yarn.Ply > 0) { <span>@(yarn.Ply)합</span> }
                    @if (yarn.WeightGram > 0) { <span>@yarn.WeightGram @weightUnit</span> }
                    @if (yarn.LengthMeter > 0) { <span>@yarn.LengthMeter @lengthUnit</span> }
                    @if (yarn.Price > 0) { <span>₩@yarn.Price.ToString("N0")</span> }
                </div>
                @if (!string.IsNullOrEmpty(yarn.LotNumber))
                {
                    <div style="font-size:0.78rem; color:var(--text-light);">Lot: @yarn.LotNumber</div>
                }
                @if (totalLength > 0)
                {
                    <div style="font-size:0.8rem; color:var(--sage-dark); font-weight:600; margin-bottom:6px;">
                        @{ var __usedLen = (_usedQty.TryGetValue(yarn.Id, out var __ul) ? __ul : 0) * yarn.LengthMeter; }
                        @if (__usedLen > 0)
                        {
                            <span>보유 길이: @((totalLength - __usedLen).ToString("0.##")) / @(totalLength.ToString("0.##")) m</span>
                        }
                        else
                        {
                            <span>보유 길이: @(totalLength.ToString("0.##")) m</span>
                        }
                    </div>
                }

                @if (!string.IsNullOrEmpty(yarn.PurchasePlace))
                {
                    <div style="font-size:0.78rem; color:var(--text-light); margin-bottom:10px;">
                        <span style="display:inline-flex;align-items:center;gap:4px;"><img src="icons/storefront.svg" class="icon-line" style="width:13px;height:13px;flex-shrink:0;" />@yarn.PurchasePlace</span>
                        @if (yarn.PurchaseDate.HasValue)
                        {
                            <span> · @yarn.PurchaseDate.Value.ToString("yyyy.MM.dd")</span>
                        }
                    </div>
                }

                @{
                    var connectedProjects = GetConnectedProjects(yarn.Id);
                }
                @if (connectedProjects.Count > 0)
                {
                    <div style="display:flex; flex-wrap:wrap; gap:4px; margin-bottom:10px;">
                        @foreach (var cp in connectedProjects)
                        {
                            var usage = cp.YarnUsages.FirstOrDefault(u => u.YarnId == yarn.Id);
                            <span style="font-size:0.72rem; background:var(--ivory-dark); color:var(--text-mid); padding:2px 8px; border-radius:99px; cursor:pointer; white-space:nowrap;"
                                  @onclick='() => Nav.NavigateTo($"/projects/{cp.Id}")'>
                                @(string.IsNullOrEmpty(cp.PatternName) ? "제목 없음" : cp.PatternName)
                                @if (usage != null && usage.BallsUsed > 0)
                                {
                                    @if (yarn.YarnType == YarnType.콘사 && yarn.WeightGram > 0)
                                    {
                                        <text> · @((usage.BallsUsed * yarn.WeightGram).ToString("0"))g</text>
                                    }
                                    else
                                    {
                                        <text> · @(usage.BallsUsed.ToString("0.##")) @_qtyUnit</text>
                                    }
                                }
                            </span>
                        }
                    </div>
                }

                <div class="flex gap-1">
                    <button class="btn btn-secondary btn-sm" @onclick="() => OpenEditModal(yarn)" style="display:inline-flex;align-items:center;gap:5px;"><img src="icons/pencil.svg" class="icon-line" style="width:14px;height:14px;flex-shrink:0;" />수정</button>
                    <button class="btn btn-secondary btn-sm" @onclick="() => DuplicateYarn(yarn)" style="display:inline-flex;align-items:center;gap:5px;" title="복제"><img src="icons/copy.svg" class="icon-line" style="width:14px;height:14px;flex-shrink:0;" />복제</button>
                    <button class="btn btn-danger btn-sm" @onclick='() => Confirm($"\"{yarn.Name}\" 실을 삭제하면 복구할 수 없어요.", async () => await DeleteYarn(yarn.Id))' style="display:inline-flex;align-items:center;"><img src="icons/trash.svg" class="icon-line" style="width:14px;height:14px;flex-shrink:0;" /></button>
                </div>
            </div>
        }
    </div>
    }
}

<!-- 추가/수정 모달 -->
@if (_showModal && _editingYarn != null)
{
    <div class="modal-backdrop">
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2 class="modal-title">@(_editingYarn.Id == Guid.Empty ? "실 추가" : "실 수정")</h2>
                <button class="btn btn-ghost btn-sm" @onclick="CloseModal">✕</button>
            </div>

            <div class="form-group" style="position:relative;">
                <label class="form-label">실 이름 *</label>
                <input class="form-control" value="@_editingYarn.Name" autocomplete="off"
                       @oninput="OnYarnNameInput" @onfocus="OnYarnNameFocus" @onblur="OnYarnNameBlur"
                       placeholder="예: 러스크" />
                @if (_showYarnSuggestions && _yarnSuggestions.Count > 0)
                {
                    <div style="position:absolute; top:100%; left:0; right:0; z-index:30; margin-top:2px; background:var(--white); border:1px solid var(--border); border-radius:8px; box-shadow:0 4px 14px rgba(0,0,0,0.14); max-height:220px; overflow-y:auto;">
                        @foreach (var p in _yarnSuggestions)
                        {
                            <div style="padding:8px 12px; cursor:pointer; font-size:0.85rem; border-bottom:1px solid var(--border);"
                                 @onmousedown="() => SelectYarnDbProduct(p)" @onmousedown:preventDefault="true">
                                <span style="font-weight:600; color:var(--text-dark);">@p.Name</span>
                                <span style="color:var(--text-light); margin-left:6px; font-size:0.78rem;">@p.Brand</span>
                            </div>
                        }
                    </div>
                }
                @if (_plyPickerProduct != null)
                {
                    <div style="margin-top:6px; padding:8px 10px; background:var(--mint-pale); border:1px solid var(--mint-light); border-radius:8px;">
                        <div style="font-size:0.76rem; color:var(--text-mid); margin-bottom:6px;">합수를 선택하면 무게/길이/가격이 자동입력돼요</div>
                        <div style="display:flex; flex-wrap:wrap; gap:6px;">
                            @foreach (var entry in _plyPickerProduct.Entries)
                            {
                                <button type="button" class="btn btn-secondary btn-sm" @onclick="() => ApplyYarnDbEntry(_plyPickerProduct!, entry)">@(entry.Ply)합 · @(entry.WeightGram)g · @(entry.LengthMeter)m</button>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">브랜드</label>
                    <input class="form-control" @bind="_editingYarn.Brand" placeholder="예: 솜솜뜨개" />
                </div>
                <div class="form-group">
                    <label class="form-label">실 종류</label>
                    <select class="form-control" @bind="_editingYarn.YarnType">
                        @foreach (var t in Enum.GetValues<YarnType>())
                        { <option value="@t">@t</option> }
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">소재</label>
                <input class="form-control" @bind="_editingYarn.Material" placeholder="예: 울 100%" />
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Lot 번호</label>
                    <input class="form-control" @bind="_editingYarn.LotNumber" placeholder="예: 1234" />
                </div>
                <div class="form-group">
                    <label class="form-label">합수</label>
                    <input type="number" class="form-control" min="0" placeholder="예: 2"
                           value="@(_editingYarn.Ply == 0 ? "" : _editingYarn.Ply.ToString())"
                           @onchange="e => _editingYarn.Ply = int.TryParse(e.Value?.ToString(), out var v) ? v : 0" />
                </div>
            </div>

            @* ── 무게 / 길이 / 가격 ── *@
            @if (_editingYarn.YarnType == YarnType.콘사)
            {
                <div class="form-row-3">
                    <div class="form-group">
                        <label class="form-label">무게 (g/콘)</label>
                        <input type="number" class="form-control" min="0" placeholder="예: 100"
                               value="@(_editingYarn.WeightGram == 0 ? "" : _editingYarn.WeightGram.ToString())"
                               @onchange="e => _editingYarn.WeightGram = int.TryParse(e.Value?.ToString(), out var v) ? v : 0" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">길이 (m/콘)</label>
                        <input type="number" class="form-control" min="0" placeholder="예: 225"
                               value="@(_editingYarn.LengthMeter == 0 ? "" : _editingYarn.LengthMeter.ToString())"
                               @onchange="e => _editingYarn.LengthMeter = int.TryParse(e.Value?.ToString(), out var v) ? v : 0" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">가격 (원/콘)</label>
                        <input type="number" class="form-control" min="0" placeholder="예: 10000"
                               value="@(_editingYarn.Price == 0 ? "" : _editingYarn.Price.ToString())"
                               @onchange="e => _editingYarn.Price = decimal.TryParse(e.Value?.ToString(), out var v) ? v : 0" />
                    </div>
                </div>
            }
            else
            {
                <div class="form-row-3">
                    <div class="form-group">
                        <label class="form-label">무게 (g/볼)</label>
                        <input type="number" class="form-control" min="0" placeholder="예: 100"
                               value="@(_editingYarn.WeightGram == 0 ? "" : _editingYarn.WeightGram.ToString())"
                               @onchange="e => _editingYarn.WeightGram = int.TryParse(e.Value?.ToString(), out var v) ? v : 0" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">길이 (m/볼)</label>
                        <input type="number" class="form-control" min="0" placeholder="예: 225"
                               value="@(_editingYarn.LengthMeter == 0 ? "" : _editingYarn.LengthMeter.ToString())"
                               @onchange="e => _editingYarn.LengthMeter = int.TryParse(e.Value?.ToString(), out var v) ? v : 0" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">가격 (원/볼)</label>
                        <input type="number" class="form-control" min="0" placeholder="예: 10000"
                               value="@(_editingYarn.Price == 0 ? "" : _editingYarn.Price.ToString())"
                               @onchange="e => _editingYarn.Price = decimal.TryParse(e.Value?.ToString(), out var v) ? v : 0" />
                    </div>
                </div>
            }

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">색상명</label>
                    <input class="form-control" @bind="_editingYarn.Color" placeholder="예: 아이보리" />
                </div>
                <div class="form-group">
                    <label class="form-label">색상 코드</label>
                    <div style="display:flex; gap:8px; align-items:center;">
                        <input type="color" class="form-control" style="width:50px; padding:4px; height:40px;"
                               @bind="_editingYarn.ColorCode" />
                        <input class="form-control" @bind="_editingYarn.ColorCode" placeholder="#ffffff" style="flex:1;" />
                    </div>
                </div>
            </div>

            @{
                bool isConeType = _editingYarn.YarnType == YarnType.콘사;
                string qtyUnitLabel = isConeType ? "콘" : "볼";
            }
            <div class="form-group">
                <label class="form-label">수량 (@qtyUnitLabel)</label>
                <input type="number" class="form-control" min="0" placeholder="예: 5"
                       value="@(_editingYarn.Quantity == 0 ? "" : _editingYarn.Quantity.ToString())"
                       @onchange="e => _editingYarn.Quantity = decimal.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var q) ? q : 0" />
            </div>


            @{
                decimal previewTotal = _editingYarn.LengthMeter * _editingYarn.Quantity;
            }
            @if (previewTotal > 0)
            {
                <div style="font-size:0.85rem; color:var(--text-dark); font-weight:600; margin-bottom:12px; padding:8px 12px; background:var(--mint-pale); border-radius:var(--radius-sm); border:1px solid var(--mint-light);">
                    총 보유 길이: @previewTotal m
                </div>
            }

            <div class="date-row" style="margin-bottom:16px;">
                <div class="form-group" style="margin-bottom:0;">
                    <label class="form-label">구매처</label>
                    <input class="form-control" @bind="_editingYarn.PurchasePlace" placeholder="예: 솜솜뜨개" />
                </div>
                <div class="form-group" style="margin-bottom:0; min-width:0; overflow:hidden;">
                    <label class="form-label">구매일</label>
                    <input type="date" class="form-control"
                           value="@_editingYarn.PurchaseDate?.ToString("yyyy-MM-dd")"
                           @onchange="e => _editingYarn.PurchaseDate = string.IsNullOrEmpty(e.Value?.ToString()) ? null : DateTime.Parse(e.Value.ToString()!)" />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">메모</label>
                <textarea class="form-control" rows="2" @bind="_editingYarn.Memo" placeholder="기타 메모"></textarea>
            </div>

            @if (_projects.Count > 0)
            {
                <div class="form-group">
                    <label class="form-label">연결된 프로젝트 (여러 개 추가 가능)</label>
                    <select class="form-control" style="margin-bottom:8px;" @onchange="OnProjectChanged">
                        <option value="">+ 프로젝트 연결</option>
                        @foreach (var proj in _projects.OrderByDescending(p => p.UpdatedAt))
                        {
                            var alreadyAdded = _editingProjectAmounts.ContainsKey(proj.Id);
                            <option value="@proj.Id" disabled="@alreadyAdded">
                                @(string.IsNullOrEmpty(proj.PatternName) ? "제목 없음" : proj.PatternName) (@proj.Status)@(alreadyAdded ? " ✓" : "")
                            </option>
                        }
                    </select>
                    @{
                        bool editIsCone       = _editingYarn.YarnType == YarnType.콘사;
                        bool editHasConeWeight = editIsCone && _editingYarn.WeightGram > 0;
                        string editUnitLabel   = editHasConeWeight ? "g" : editIsCone ? "콘" : "볼";
                    }
                    @foreach (var pid in _editingProjectAmounts.Keys.ToList())
                    {
                        var ep = _projects.Find(p => p.Id == pid);
                        if (ep != null)
                        {
                            decimal rawAmt     = _editingProjectAmounts[pid];
                            decimal displayAmt = editHasConeWeight ? rawAmt * _editingYarn.WeightGram : rawAmt;
                            // 이 프로젝트 자신의 사용량은 빼고, 다른 프로젝트에서 이미 쓴 양만 반영해 잔여량 계산
                            decimal editUsedElsewhere = _projects.Where(p => p.Id != pid)
                                                                  .SelectMany(p => p.YarnUsages)
                                                                  .Where(u => u.YarnId == _editingYarn.Id)
                                                                  .Sum(u => u.BallsUsed);
                            decimal editRemainRaw = _editingYarn.Quantity - editUsedElsewhere;
                            decimal editRemainQty = editHasConeWeight ? editRemainRaw * _editingYarn.WeightGram : editRemainRaw;
                            <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;padding:6px 10px;border-radius:9px;background:#f8f8f8;border:1px solid var(--border);">
                                <span style="flex:1;font-size:0.88rem;">@(string.IsNullOrEmpty(ep.PatternName) ? "제목 없음" : ep.PatternName)</span>
                                <span style="font-size:0.72rem;color:var(--text-light);">@ep.Status</span>
                                <input class="form-control" type="number" min="0" style="width:70px;flex-shrink:0;"
                                       value='@displayAmt.ToString(editHasConeWeight ? "0" : "0.##")'
                                       @onchange="e => { if (decimal.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var n)) _editingProjectAmounts[pid] = Math.Round(editHasConeWeight ? n / _editingYarn.WeightGram : n, 6); }" />
                                <span style="font-size:0.78rem;color:var(--text-light);flex-shrink:0;">@editUnitLabel (잔여 @(editRemainQty.ToString(editHasConeWeight ? "0" : "0.##"))@editUnitLabel)</span>
                                <button class="btn btn-danger btn-sm" @onclick="() => _editingProjectAmounts.Remove(pid)"><img src="icons/x.svg" class="icon-line" style="width:12px;height:12px;" /></button>
                            </div>
                        }
                    }
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_editingYarn.Brand) && !string.IsNullOrWhiteSpace(_editingYarn.Name)
                 && _editingYarn.Ply > 0
                 && !_yarnDbAll.Any(p => p.Brand.Trim() == _editingYarn.Brand.Trim() && p.Name.Trim() == _editingYarn.Name.Trim()
                                          && p.Entries.Any(e => e.Ply == _editingYarn.Ply)))
            {
                <label style="display:flex; align-items:flex-start; gap:8px; margin:4px 0 10px; padding:10px 12px; background:var(--mint-pale); border:1px solid var(--mint-light); border-radius:8px; cursor:pointer;">
                    <input type="checkbox" @bind="_reportOnSave" style="margin-top:2px; flex-shrink:0;" />
                    <span style="font-size:0.8rem; color:var(--text-mid); line-height:1.5;">
                        지금 입력한 실 정보를 DB에도 제보할게요 — 위에 입력하신 브랜드·소재·합수·무게·길이·가격이 그대로 전달되고,
                        승인되면 다른 사용자들 자동완성에도 도움이 돼요. (로그인 여부와 무관)
                    </span>
                </label>
            }

            <div class="modal-footer">
                <button class="btn btn-ghost" @onclick="CloseModal">취소</button>
                <button class="btn btn-primary" @onclick="SaveYarn" disabled="@_saving">@(_saving ? "저장 중..." : "저장")</button>
            </div>
        </div>
    </div>
}

<!-- 삭제 확인 모달 -->
@if (_showConfirm)
{
    <div style="position:fixed;top:0;left:0;right:0;bottom:0;z-index:9999;background:rgba(0,0,0,0.45);display:flex;align-items:center;justify-content:center;padding:20px;">
        <div style="background:var(--white);border-radius:16px;max-width:320px;width:100%;padding:24px 20px;text-align:center;box-shadow:0 8px 32px rgba(0,0,0,0.18);" @onclick:stopPropagation="true">
            <div style="margin-bottom:12px;display:flex;justify-content:center;"><img src="icons/trash.svg" class="icon-line" style="width:32px;height:32px;" /></div>
            <div style="font-size:1rem; font-weight:600; margin-bottom:8px; color:var(--text-dark);">정말 삭제할까요?</div>
            <div style="font-size:0.88rem; color:var(--text-mid); margin-bottom:20px;">@_confirmMsg</div>
            <div style="display:flex; gap:10px; justify-content:center;">
                <button class="btn btn-ghost" @onclick="() => _showConfirm = false">취소</button>
                <button class="btn btn-danger" @onclick="ExecuteConfirm">삭제</button>
            </div>
        </div>
    </div>
}

@code {
    // ── 실 DB 자동완성 (실_DB.xlsx → wwwroot/data/yarn-db.json) ──
    class YarnDbEntry
    {
        public string YarnType { get; set; } = "";
        public string Material { get; set; } = "";
        public int Ply { get; set; }
        public int WeightGram { get; set; }
        public int LengthMeter { get; set; }
        public decimal Price { get; set; }
    }
    class YarnDbProduct
    {
        public string Brand { get; set; } = "";
        public string Name { get; set; } = "";
        public List<YarnDbEntry> Entries { get; set; } = new();
    }

    List<YarnDbProduct> _yarnDbAll = new();
    List<YarnDbProduct> _yarnSuggestions = new();
    bool _showYarnSuggestions = false;
    YarnDbProduct? _plyPickerProduct = null;

    async Task LoadYarnDbAsync()
    {
        List<YarnDbProduct> staticDb = new();
        try { staticDb = await Http.GetFromJsonAsync<List<YarnDbProduct>>("data/yarn-db.json") ?? new(); }
        catch { staticDb = new(); }

        // 관리자가 승인한 제보 항목(Firestore yarnDbApproved 컬렉션)을 정적 DB와 병합.
        // 로그인 여부와 무관하게 누구나 읽을 수 있는 공개 컬렉션이라 실패해도 조용히 무시.
        try
        {
            var json = await JS.InvokeAsync<string?>("firebaseStore.getCollection", "yarnDbApproved");
            if (!string.IsNullOrWhiteSpace(json))
            {
                var approved = System.Text.Json.JsonSerializer.Deserialize<List<YarnDbApprovedDoc>>(json,
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
                foreach (var a in approved)
                {
                    if (string.IsNullOrWhiteSpace(a.Brand) || string.IsNullOrWhiteSpace(a.Name)) continue;
                    var existing = staticDb.FirstOrDefault(p => p.Brand == a.Brand && p.Name == a.Name);
                    var entry = new YarnDbEntry
                    {
                        YarnType = a.YarnType ?? "",
                        Material = a.Material ?? "",
                        Ply = a.Ply,
                        WeightGram = a.WeightGram,
                        LengthMeter = a.LengthMeter,
                        Price = a.Price
                    };
                    if (existing != null) existing.Entries.Add(entry);
                    else staticDb.Add(new YarnDbProduct { Brand = a.Brand!, Name = a.Name!, Entries = new() { entry } });
                }
            }
        }
        catch (Exception ex) { Console.Error.WriteLine($"승인된 제보 병합 실패: {ex.Message}"); }

        _yarnDbAll = staticDb;
    }

    // Firestore yarnDbApproved 문서 매핑용
    class YarnDbApprovedDoc
    {
        public string? Brand { get; set; }
        public string? Name { get; set; }
        public string? YarnType { get; set; }
        public string? Material { get; set; }
        public int Ply { get; set; }
        public int WeightGram { get; set; }
        public int LengthMeter { get; set; }
        public decimal Price { get; set; }
    }

    // ── 실 정보 제보 (로그인 여부 무관, Firestore yarnSubmissions에 저장) ──
    // 별도 입력폼 없이, "실 추가" 폼에서 이미 입력한 _editingYarn 값을 그대로 재사용해요.
    bool _reportOnSave = false;

    async Task SubmitYarnReportIfChecked(Yarn yarn)
    {
        if (!_reportOnSave) return;
        _reportOnSave = false; // 다음 실 추가 때 체크 상태가 이어지지 않도록 초기화
        try
        {
            var payload = new
            {
                brand = yarn.Brand?.Trim() ?? "",
                name = yarn.Name.Trim(),
                yarnType = yarn.YarnType.ToString(),
                material = yarn.Material?.Trim() ?? "",
                ply = yarn.Ply,
                weightGram = yarn.WeightGram,
                lengthMeter = yarn.LengthMeter,
                price = yarn.Price,
                memo = "",
                status = "pending",
                submittedByUid = Auth.IsLoggedIn ? Auth.CurrentUser!.Uid : null,
                submittedAt = DateTime.UtcNow.ToString("o")
            };
            var json = System.Text.Json.JsonSerializer.Serialize(payload);
            var ok = await JS.InvokeAsync<bool>("firebaseStore.addDocument", "yarnSubmissions", json);
            if (ok) await JS.InvokeVoidAsync("showToast", "실 정보도 함께 제보됐어요. 감사해요!");
        }
        catch (Exception ex)
        {
            // 제보 실패는 실 저장 자체를 막을 이유가 없으므로 조용히 로그만 남김
            Console.Error.WriteLine($"실 정보 제보 실패: {ex.Message}");
        }
    }

    void FilterYarnSuggestions(string q)
    {
        q = q.Trim();
        if (string.IsNullOrEmpty(q)) { _yarnSuggestions = new(); _showYarnSuggestions = false; return; }
        _yarnSuggestions = _yarnDbAll
            .Where(p => p.Name.Contains(q, StringComparison.OrdinalIgnoreCase) || p.Brand.Contains(q, StringComparison.OrdinalIgnoreCase))
            .Take(6).ToList();
        _showYarnSuggestions = _yarnSuggestions.Count > 0;
    }

    void OnYarnNameInput(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        _editingYarn!.Name = val;
        _plyPickerProduct = null;
        FilterYarnSuggestions(val);
    }

    void OnYarnNameFocus()
    {
        if (!string.IsNullOrWhiteSpace(_editingYarn?.Name))
            FilterYarnSuggestions(_editingYarn!.Name);
    }

    async Task OnYarnNameBlur()
    {
        await Task.Delay(150);
        _showYarnSuggestions = false;
        StateHasChanged();
    }

    void SelectYarnDbProduct(YarnDbProduct p)
    {
        _editingYarn!.Name = p.Name;
        _editingYarn.Brand = p.Brand;
        _showYarnSuggestions = false;
        _yarnSuggestions = new();
        if (p.Entries.Count == 1)
        {
            ApplyYarnDbEntry(p, p.Entries[0]);
        }
        else
        {
            // 합수마다 무게/길이/가격은 다르지만 실종류·소재는 공통이므로 먼저 채워두고,
            // 합수 선택은 합수 입력란 아래 칩에서 하도록 대기 상태로 전환
            var first = p.Entries[0];
            if (first.YarnType == "콘사") _editingYarn.YarnType = YarnType.콘사;
            _editingYarn.Material = first.Material;
            _plyPickerProduct = p;
        }
    }

    void ApplyYarnDbEntry(YarnDbProduct p, YarnDbEntry entry)
    {
        _editingYarn!.Name = p.Name;
        _editingYarn.Brand = p.Brand;
        if (entry.YarnType == "콘사") _editingYarn.YarnType = YarnType.콘사;
        _editingYarn.Material = entry.Material;
        _editingYarn.Ply = entry.Ply;
        _editingYarn.WeightGram = entry.WeightGram;
        _editingYarn.LengthMeter = entry.LengthMeter;
        _editingYarn.Price = entry.Price;
        _plyPickerProduct = null;
    }

    bool _saving = false;
    bool _showConfirm = false;
    string _confirmMsg = "";
    Func<Task>? _confirmAction;

    void Confirm(string msg, Func<Task> action)
    {
        _confirmMsg    = msg;
        _confirmAction = action;
        _showConfirm   = true;
    }

    async Task ExecuteConfirm()
    {
        _showConfirm = false;
        if (_confirmAction != null)
            await _confirmAction();
        _confirmAction = null;
    }

    bool _loading = true;
    bool _showModal = false;
    string _searchText = "";
    void ClearSearch() { _searchText = ""; }
    string _filter = "all";
    string _yarnSort = "created_desc";
    bool _isListView = false;
    List<Yarn> _yarns = new();
    Yarn? _editingYarn;
    Dictionary<Guid, decimal> _editingProjectAmounts = new(); // 프로젝트ID → 소요량(원시 BallsUsed 단위)

    IEnumerable<Yarn> FilteredYarns
    {
        get
        {
            var list = _yarns.AsEnumerable();

            // 텍스트 검색
            if (!string.IsNullOrWhiteSpace(_searchText))
                list = list.Where(y =>
                    y.Name.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
                    y.Brand.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
                    y.Color.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
                    y.Material.Contains(_searchText, StringComparison.OrdinalIgnoreCase));

            // 통합 필터
            list = _filter switch
            {
                "linked"   => list.Where(y => _usedQty.ContainsKey(y.Id)),
                "unlinked" => list.Where(y => !_usedQty.ContainsKey(y.Id)),
                "low"      => list.Where(y =>
                {
                    decimal used = _usedQty.TryGetValue(y.Id, out var u) ? u : 0;
                    decimal remain = y.Quantity - used;
                    return _usedQty.ContainsKey(y.Id) && y.Quantity > 0 && remain > 0 && (remain / y.Quantity) < 0.5m;
                }),
                "empty"    => list.Where(y =>
                {
                    decimal used = _usedQty.TryGetValue(y.Id, out var u) ? u : 0;
                    return (y.Quantity - used) <= 0;
                }),
                _          => list
            };

            return _yarnSort switch
            {
                "name_asc"   => list.OrderBy(y => y.Name),
                "name_desc"  => list.OrderByDescending(y => y.Name),
                "brand_asc"  => list.OrderBy(y => y.Brand).ThenBy(y => y.Name),
                "brand_desc" => list.OrderByDescending(y => y.Brand).ThenByDescending(y => y.Name),
                "created_asc"=> list.OrderBy(y => y.CreatedAt),
                _            => list.OrderByDescending(y => y.CreatedAt),
            };
        }
    }

    List<KnitProject> _projects = new();
    // yarnId → 총 사용량 (모든 프로젝트 합산)
    Dictionary<Guid, decimal> _usedQty = new();
    HashSet<Guid> _completedYarnIds = new(); // 완성작에만 연결된 실 ID

    protected override async Task OnInitializedAsync()
    {
        _yarns = await Storage.GetYarnsAsync();
        _projects = await Storage.GetProjectsAsync();
        _CalcUsed();
        _filter    = await JS.InvokeAsync<string?>("localStorage.getItem", "yarn_filter") ?? "all";
        _yarnSort  = await JS.InvokeAsync<string?>("localStorage.getItem", "yarn_sort")   ?? "created_desc";
        var listview = await JS.InvokeAsync<string?>("localStorage.getItem", "yarn_listview");
        if (!string.IsNullOrEmpty(listview)) _isListView = listview == "true";
        await LoadYarnDbAsync();
        _loading = false;
    }

    async Task SetYarnSort(string val)
    {
        _yarnSort = val;
        await JS.InvokeVoidAsync("localStorage.setItem", "yarn_sort", val);
    }

    void _CalcUsed()
    {
        _usedQty = new();
        var activeYarnIds = new HashSet<Guid>(); // 진행중/일시중단 프로젝트에 쓰인 실
        var allUsedYarnIds = new HashSet<Guid>(); // 완성작 포함 전체 사용 실

        foreach (var p in _projects)
        {
            foreach (var u in p.YarnUsages)
            {
                _usedQty[u.YarnId] = (_usedQty.TryGetValue(u.YarnId, out var v) ? v : 0) + u.BallsUsed;
                allUsedYarnIds.Add(u.YarnId);
                if (p.Status != ProjectStatus.완료)
                    activeYarnIds.Add(u.YarnId);
            }
        }
        // 완성작에만 연결된 실 = 전체 사용 - 진행중 사용
        _completedYarnIds = new HashSet<Guid>(allUsedYarnIds.Except(activeYarnIds));
    }

    // 실 ID로 연결된 프로젝트 목록 조회 (프로젝트의 YarnUsages 기준 — 프로젝트 상세 페이지와 동일한 데이터라 자동 동기화됨)
    List<KnitProject> GetConnectedProjects(Guid yarnId)
        => _projects.Where(p => p.YarnUsages.Any(u => u.YarnId == yarnId))
                    .OrderByDescending(p => p.UpdatedAt)
                    .ToList();

    bool _scrollModalTop = false;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scrollModalTop) { _scrollModalTop = false; await JS.InvokeVoidAsync("scrollModalToTop"); }
    }
    string GetRemainBadge(decimal remain, decimal qty)
    {
        if (remain <= 0) return "badge-pause";
        if (qty > 0 && remain / qty < 0.5m) return "badge-progress";
        return "badge-done";
    }

    string GetYarnRemainingLabel(Yarn yarn)
    {
        decimal used = _usedQty.TryGetValue(yarn.Id, out var u) ? u : 0;
        decimal remain = yarn.Quantity - used;
        string qtyUnit = yarn.YarnType == YarnType.콘사 ? "콘" : "볼";
        if (yarn.Quantity <= 0) return yarn.Color;

        string qtyLabel;
        if (yarn.YarnType == YarnType.콘사 && yarn.WeightGram > 0)
        {
            qtyLabel = used > 0
                ? $"{(yarn.WeightGram * remain):0}g / {(yarn.WeightGram * yarn.Quantity):0}g"
                : $"{(yarn.WeightGram * yarn.Quantity):0}g";
        }
        else
        {
            qtyLabel = used > 0
                ? $"{remain:0.##} / {yarn.Quantity:0.##} {qtyUnit}"
                : $"x {yarn.Quantity:0.##} {qtyUnit}";
        }
        return string.IsNullOrEmpty(yarn.Color) ? qtyLabel : $"{yarn.Color} · {qtyLabel}";
    }

    async Task DuplicateYarn(Yarn source)
    {
        _editingYarn = new Yarn
        {
            Id = Guid.Empty,
            Name = source.Name,
            Brand = source.Brand,
            Color = source.Color,
            ColorCode = source.ColorCode,
            YarnType = source.YarnType,
            Ply = source.Ply,
            Material = source.Material,
            WeightGram = source.WeightGram,
            LengthMeter = source.LengthMeter,
            PurchasePlace = source.PurchasePlace,
            Price = source.Price,
            Memo = source.Memo,
        };
        _editingProjectAmounts = new();
        _yarnSuggestions = new(); _showYarnSuggestions = false; _plyPickerProduct = null; _reportOnSave = false;
        _showModal = true;
        _scrollModalTop = true;
        await JS.InvokeVoidAsync("lockBodyScroll");
    }
    async Task OpenAddModal()
    {
        _editingYarn = new Yarn { Id = Guid.Empty, YarnType = YarnType.콘사 };
        _editingProjectAmounts = new();
        _yarnSuggestions = new(); _showYarnSuggestions = false; _plyPickerProduct = null; _reportOnSave = false;
        _showModal = true; _scrollModalTop = true;
        await JS.InvokeVoidAsync("lockBodyScroll");
    }
    async Task OpenEditModal(Yarn yarn)
    {
        // 취소 시 원본이 오염되지 않도록 JSON 딥카피해서 편집 (저장 버튼을 눌러야만 실제 반영됨)
        var json = System.Text.Json.JsonSerializer.Serialize(yarn);
        _editingYarn = System.Text.Json.JsonSerializer.Deserialize<Yarn>(json)!;
        _editingProjectAmounts = GetConnectedProjects(yarn.Id)
            .ToDictionary(p => p.Id, p => p.YarnUsages.FirstOrDefault(u => u.YarnId == yarn.Id)?.BallsUsed ?? 1);
        _yarnSuggestions = new(); _showYarnSuggestions = false; _plyPickerProduct = null; _reportOnSave = false;
        _showModal = true;
        _scrollModalTop = true;
        await JS.InvokeVoidAsync("lockBodyScroll");
    }
    async Task CloseModal()
    {
        _showModal = false; _editingYarn = null; _editingProjectAmounts = new();
        _yarnSuggestions = new(); _showYarnSuggestions = false; _plyPickerProduct = null; _reportOnSave = false;
        await JS.InvokeVoidAsync("unlockBodyScroll");
    }

    void OnProjectChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (string.IsNullOrEmpty(val)) return;
        if (!Guid.TryParse(val, out var pid)) return;
        if (!_editingProjectAmounts.ContainsKey(pid))
            _editingProjectAmounts[pid] = 1;
        StateHasChanged();
    }

    async Task SaveYarn()
    {
        _saving = true; StateHasChanged();
        if (_editingYarn == null || string.IsNullOrWhiteSpace(_editingYarn.Name)) { _saving = false; return; }
        if (_editingYarn.Id == Guid.Empty) _editingYarn.Id = Guid.NewGuid();
        await Storage.SaveYarnAsync(_editingYarn);

        // 프로젝트 연결 동기화: 콤보박스에서 선택/해제하고 입력한 수량을 각 프로젝트의 YarnUsages에 반영
        // (저장 버튼을 눌러야 실제로 커밋됨 — 신규 실도 이 시점에 실제 ID가 생기므로 바로 연결 가능)
        var yarnId = _editingYarn.Id;
        foreach (var proj in _projects)
        {
            var existingUsage = proj.YarnUsages.FirstOrDefault(u => u.YarnId == yarnId);
            var shouldConnect = _editingProjectAmounts.TryGetValue(proj.Id, out var amount);
            if (shouldConnect)
            {
                if (existingUsage != null)
                {
                    if (existingUsage.BallsUsed != amount)
                    {
                        existingUsage.BallsUsed = amount;
                        await Storage.SaveProjectAsync(proj);
                    }
                }
                else
                {
                    proj.YarnUsages.Add(new ProjectYarnUsage { YarnId = yarnId, BallsUsed = amount });
                    await Storage.SaveProjectAsync(proj);
                }
            }
            else if (existingUsage != null)
            {
                proj.YarnUsages.RemoveAll(u => u.YarnId == yarnId);
                await Storage.SaveProjectAsync(proj);
            }
        }

        _yarns = await Storage.GetYarnsAsync();
        _projects = await Storage.GetProjectsAsync();
        _CalcUsed();
        await SubmitYarnReportIfChecked(_editingYarn);
        await CloseModal();
        _saving = false;
        await JS.InvokeVoidAsync("showToast", "저장됐어요");
    }

    async Task DeleteYarn(Guid id)
    {
        await Storage.DeleteYarnAsync(id);
        _yarns = await Storage.GetYarnsAsync();
    }
}
