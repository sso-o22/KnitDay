@* =====================================================================
   Pages/Wishlist.razor  —  위시리스트
   ===================================================================== *@
@page "/wishlist"
@using KnitLog.Models
@using KnitLog.Services
@inject StorageService Storage
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="page-header">
    <div>
        <h1 class="page-title"><img src="icons/shooting-star.svg" class="icon-line" style="width:36px;height:36px;" />위시리스트</h1>
        <p class="page-subtitle">언젠가 꼭 뜨고 싶은 작품들</p>
    </div>
    <button class="btn btn-primary" @onclick="OpenAddModal" style="display:inline-flex;align-items:center;gap:5px;"><img src="icons/plus.svg" class="icon-line" style="width:14px;height:14px;flex-shrink:0;" />위시 추가</button>
</div>

@if (_loading)
{
    <div class="loading">불러오는 중...</div>
}
else if (_projects.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon"><img src="icons/shooting-star.svg" class="icon-line" style="width:48px;height:48px;" /></div>
        <p>위시리스트가 비어 있어요.<br/>뜨고 싶은 작품을 추가해 보세요!</p>
    </div>
}
else
{
    <div style="display:flex; gap:6px; margin-bottom:16px; align-items:center;">
        <img src="icons/arrows-down-up.svg" class="icon-line" style="width:14px;height:14px;flex-shrink:0;opacity:0.45;" />
        @foreach (var (label, baseVal) in new[]{("등록일","created"),("이름순","name"),("출처순","source")})
        {
            var ascVal  = baseVal + "_asc";
            var descVal = baseVal + "_desc";
            var isActive = _wishSort == ascVal || _wishSort == descVal;
            var isAsc   = _wishSort == ascVal;
            <button class="btn btn-sm @(isActive?"btn-sage":"btn-ghost")"
                    @onclick="async () => await SetWishSort(isActive ? (isAsc ? descVal : ascVal) : descVal)">
                @label @if (isActive) { <img src="@(isAsc?"icons/arrow-up.svg":"icons/arrow-down.svg")" class="icon-line" style="width:11px;height:11px;margin-left:2px;" /> }
            </button>
        }
    </div>
    <div class="grid-3">
        @foreach (var proj in SortedWishes)
        {
            <div class="card">
                <div class="flex-between mb-1">
                    <div class="card-title" style="margin-bottom:0;">@proj.PatternName</div>
                    <span class="badge badge-wish">위시</span>
                </div>

                @if (!string.IsNullOrEmpty(proj.OriginalNeedle) || !string.IsNullOrEmpty(proj.OriginalGauge) || !string.IsNullOrEmpty(proj.OriginalYarn) || !string.IsNullOrEmpty(proj.OriginalYarnAmount) || proj.OriginalYarnAmountG > 0 || !string.IsNullOrEmpty(proj.OriginalSize) || !string.IsNullOrEmpty(proj.OriginalOther))
                {
                    <div style="font-size:0.78rem; color:var(--text-mid); margin-bottom:8px; display:flex; flex-direction:column; gap:2px;">
                        @if (!string.IsNullOrEmpty(proj.OriginalNeedle)) { <span>바늘: @proj.OriginalNeedle</span> }
                        @if (!string.IsNullOrEmpty(proj.OriginalGauge))  { <span>게이지: @proj.OriginalGauge</span> }
                        @if (!string.IsNullOrEmpty(proj.OriginalYarn))   { <span>실: @proj.OriginalYarn@(proj.OriginalYarnWeightG > 0 && proj.OriginalYarnLengthM > 0 ? $" ({proj.OriginalYarnWeightG.ToString("0")}g/{proj.OriginalYarnLengthM.ToString("0")}m)" : "")</span> }
                        @if (proj.OriginalYarnAmountG > 0 || !string.IsNullOrEmpty(proj.OriginalSize))
                        {
                            <span>소요량: @(!string.IsNullOrEmpty(proj.OriginalSize) ? proj.OriginalSize + " " : "")@(proj.OriginalYarnAmountG > 0 ? $"{proj.OriginalYarnAmountG.ToString("0")}{proj.OriginalYarnAmountUnit}" : "")</span>
                        }
                        else if (!string.IsNullOrEmpty(proj.OriginalYarnAmount))
                        {
                            <span>소요량: @proj.OriginalYarnAmount</span>
                        }
                        @if (!string.IsNullOrEmpty(proj.OriginalOther))  { <span>부자재: @proj.OriginalOther</span> }
                    </div>
                }
                @if (!string.IsNullOrEmpty(proj.WishMemo))
                {
                    <p style="font-size:0.84rem; color:var(--text-mid); margin-bottom:12px; white-space:pre-wrap;">@proj.WishMemo</p>
                }
                @if (!string.IsNullOrEmpty(proj.PatternSource))
                {
                    <div style="font-size:0.78rem; color:var(--text-light); margin-bottom:10px; display:flex; align-items:flex-start; gap:4px; min-width:0;"><img src="icons/link-simple.svg" class="icon-line" style="width:13px;height:13px;flex-shrink:0;margin-top:2px;" /><span style="word-break:break-all; overflow-wrap:break-word;">@proj.PatternSource</span></div>
                }

                <div class="flex gap-1" style="flex-wrap:wrap;">
                    <button class="btn btn-sm btn-primary" @onclick="() => StartProject(proj.Id)">시작하기</button>
                    <button class="btn btn-secondary btn-sm" @onclick="() => OpenYarnCalc(proj)" style="display:inline-flex;align-items:center;" title="소요량 계산기"><img src="icons/calculator.svg" class="icon-line" style="width:14px;height:14px;flex-shrink:0;" /></button>
                    <button class="btn btn-secondary btn-sm" @onclick="() => OpenEditModal(proj)" style="display:inline-flex;align-items:center;"><img src="icons/pencil.svg" class="icon-line" style="width:14px;height:14px;flex-shrink:0;" /></button>
                    <button class="btn btn-danger btn-sm" @onclick='() => Confirm("위시리스트에서 삭제하면 복구할 수 없어요.", async () => await DeleteProject(proj.Id))' style="display:inline-flex;align-items:center;"><img src="icons/trash.svg" class="icon-line" style="width:14px;height:14px;flex-shrink:0;" /></button>
                </div>
            </div>
        }
    </div>
}

<!-- 추가/수정 모달 -->
@if (_showModal && _editingProject != null)
{
    <div class="modal-backdrop">
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2 class="modal-title">@(_editingProject.Id == Guid.Empty ? "위시 추가" : "위시 수정")</h2>
                <button class="btn btn-ghost btn-sm" @onclick="CloseModal">✕</button>
            </div>


            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">도안명</label>
                    <input class="form-control" @bind="_editingProject.PatternName" placeholder="예: 올드패션드 가디건" />
                </div>
                <div class="form-group">
                    <label class="form-label">도안 출처</label>
                    <input class="form-control" @bind="_editingProject.PatternSource" placeholder="작가명, 책 이름 등" />
                </div>
            </div>

            <div class="form-label" style="margin-bottom:8px;">도안 정보</div>
            <div style="padding:10px 12px; background:var(--ivory-dark); border-radius:var(--radius-sm); margin-bottom:14px;">
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label" style="font-size:0.78rem;">원작 바늘</label>
                        <input class="form-control" @bind="_editingProject.OriginalNeedle" placeholder="예: 5mm 대바늘" />
                    </div>
                    <div class="form-group">
                        <label class="form-label" style="font-size:0.78rem;">원작 게이지</label>
                        <input class="form-control" @bind="_editingProject.OriginalGauge" placeholder="예: 22코 × 30단 / 10cm * 10cm" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label" style="font-size:0.78rem;">원작 실</label>
                        <input class="form-control" @bind="_editingProject.OriginalYarn" placeholder="예: 솜솜뜨개 러스크 2합" />
                    </div>
                    <div class="form-group">
                        <label class="form-label" style="font-size:0.78rem;">원작실 규격 (소요량 계산기용)</label>
                        <div style="display:flex; gap:6px; align-items:center;">
                            <input class="form-control" type="number" step="1" style="flex:1; min-width:0;"
                                   value="@(_editingProject.OriginalYarnWeightG == 0 ? "" : _editingProject.OriginalYarnWeightG.ToString())"
                                   @onchange="e => { if (double.TryParse(e.Value?.ToString(), out var v)) _editingProject.OriginalYarnWeightG = v; else _editingProject.OriginalYarnWeightG = 0; }" placeholder="g" />
                            <span style="font-size:0.78rem; color:var(--text-light); flex-shrink:0;">g /</span>
                            <input class="form-control" type="number" step="1" style="flex:1; min-width:0;"
                                   value="@(_editingProject.OriginalYarnLengthM == 0 ? "" : _editingProject.OriginalYarnLengthM.ToString())"
                                   @onchange="e => { if (double.TryParse(e.Value?.ToString(), out var v)) _editingProject.OriginalYarnLengthM = v; else _editingProject.OriginalYarnLengthM = 0; }" placeholder="m" />
                            <span style="font-size:0.78rem; color:var(--text-light); flex-shrink:0;">m</span>
                        </div>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label" style="font-size:0.78rem;">사이즈</label>
                        <input class="form-control" @bind="_editingProject.OriginalSize" placeholder="예: M, 95, Free" />
                    </div>
                    <div class="form-group">
                        <label class="form-label" style="font-size:0.78rem;">소요량</label>
                        <div style="display:flex; gap:6px;">
                            <input class="form-control" type="number" step="1" style="flex:1; min-width:0;"
                                   value="@(_editingProject.OriginalYarnAmountG == 0 ? "" : _editingProject.OriginalYarnAmountG.ToString())"
                                   @onchange="e => { if (double.TryParse(e.Value?.ToString(), out var v)) _editingProject.OriginalYarnAmountG = v; else _editingProject.OriginalYarnAmountG = 0; }" placeholder="예: 400" />
                            <select class="form-control" style="width:64px; flex-shrink:0;" @bind="_editingProject.OriginalYarnAmountUnit">
                                <option value="g">g</option>
                                <option value="m">m</option>
                                <option value="볼">볼</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-group" style="margin-bottom:0;">
                    <label class="form-label" style="font-size:0.78rem;">기타 부자재</label>
                    <input class="form-control" @bind="_editingProject.OriginalOther" placeholder="예: 단추 7개, 50cm 지퍼" />
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">메모</label>
                <textarea class="form-control" rows="3" @bind="_editingProject.WishMemo"
                          placeholder="뜨고 싶은 이유, 사용할 실 아이디어 등 자유롭게!"></textarea>
            </div>

            <div class="modal-footer">
                <button class="btn btn-ghost" @onclick="CloseModal">취소</button>
                <button class="btn btn-primary" @onclick="SaveProject" disabled="@_saving">@(_saving ? "저장 중..." : "저장")</button>
            </div>
        </div>
    </div>
}

<!-- 실 소요량 계산기 모달 -->
@if (_showYarnCalc && _ycProject != null)
{
    <div class="modal-backdrop" @onclick="CloseYarnCalc">
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2 class="modal-title">실 소요량 계산기</h2>
                <button class="btn btn-ghost btn-sm" @onclick="CloseYarnCalc">✕</button>
            </div>
            <p style="font-size:0.78rem; color:var(--text-mid); margin-bottom:14px;">원작실 기준 소요량을, 내가 쓰려는 실의 규격에 맞춰 몇 g(또는 몇 볼/콘)이 필요한지 계산해요.</p>

            <div style="background:var(--ivory-mid); border-radius:var(--radius-sm); padding:14px; margin-bottom:14px;">
                <div style="font-size:0.88rem; font-weight:600; color:var(--theme-active); margin-bottom:8px;">① 원작실 정보 (참고용)</div>
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
                    <div class="form-group" style="margin-bottom:0;">
                        <label class="form-label" style="font-size:0.78rem;">원작 g당</label>
                        <input class="form-control" type="number" step="1"
                               value="@(_ycOrigWeight == 0 ? "" : _ycOrigWeight.ToString())"
                               @onchange="e => { if (double.TryParse(e.Value?.ToString(), out var v)) _ycOrigWeight = v; else _ycOrigWeight = 0; }" placeholder="예: 100" />
                    </div>
                    <div class="form-group" style="margin-bottom:0;">
                        <label class="form-label" style="font-size:0.78rem;">원작 m당</label>
                        <input class="form-control" type="number" step="1"
                               value="@(_ycOrigLength == 0 ? "" : _ycOrigLength.ToString())"
                               @onchange="e => { if (double.TryParse(e.Value?.ToString(), out var v)) _ycOrigLength = v; else _ycOrigLength = 0; }" placeholder="예: 220" />
                    </div>
                </div>
                <div class="form-group" style="margin-top:10px; margin-bottom:0;">
                    <label class="form-label" style="font-size:0.78rem;">원작 총 소요g (도안에 g으로 적혀있을 때)</label>
                    <input class="form-control" type="number" step="1"
                           value="@(_ycOrigTotalG == 0 ? "" : _ycOrigTotalG.ToString())"
                           @onchange="e => { if (double.TryParse(e.Value?.ToString(), out var v)) _ycOrigTotalG = v; else _ycOrigTotalG = 0; }" placeholder="예: 650" />
                </div>
                @if (_ycOrigWeight > 0 && _ycOrigLength > 0 && _ycOrigTotalG > 0)
                {
                    <div style="margin-top:10px; font-size:0.8rem; color:var(--text-mid); display:flex; align-items:center; justify-content:space-between; gap:8px;">
                        <span>→ 총 약 <strong>@((_ycOrigTotalG / _ycOrigWeight * _ycOrigLength).ToString("0"))m</strong> 필요</span>
                        <button type="button" class="btn btn-sage btn-sm" @onclick="ApplyYarnCalcOrigMeters">이 값으로 적용</button>
                    </div>
                }
            </div>

            <div style="background:var(--ivory-mid); border-radius:var(--radius-sm); padding:14px; margin-bottom:14px;">
                <div style="font-size:0.88rem; font-weight:600; color:var(--theme-active); margin-bottom:8px;">② 총 필요 길이</div>
                <div class="form-group" style="margin-bottom:0;">
                    <label class="form-label" style="font-size:0.78rem;">총 필요 길이 (m)</label>
                    <input class="form-control" type="number" step="1"
                           value="@(_ycTotalMeters == 0 ? "" : _ycTotalMeters.ToString())"
                           @onchange="e => { if (double.TryParse(e.Value?.ToString(), out var v)) _ycTotalMeters = v; else _ycTotalMeters = 0; }" placeholder="예: 1450 (직접 입력 또는 ①에서 적용)" />
                </div>
            </div>

            <div style="background:var(--ivory-mid); border-radius:var(--radius-sm); padding:14px; margin-bottom:16px;">
                <div style="font-size:0.88rem; font-weight:600; color:var(--theme-active); margin-bottom:8px;">③ 내가 쓰려는 실</div>
                <div class="form-group" style="margin-bottom:10px;">
                    <label class="form-label" style="font-size:0.78rem;">실 창고에서 선택 (선택 사항)</label>
                    <select class="form-control" @onchange="OnYarnCalcSubYarnChanged">
                        <option value="">직접 입력</option>
                        @foreach (var y in _yarns)
                        {
                            <option value="@y.Id" selected="@(_ycSubYarnId == y.Id)">@y.Brand @y.Name (@y.Color)</option>
                        }
                    </select>
                </div>
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
                    <div class="form-group" style="margin-bottom:0;">
                        <label class="form-label" style="font-size:0.78rem;">g당</label>
                        <input class="form-control" type="number" step="1"
                               value="@(_ycSubWeight == 0 ? "" : _ycSubWeight.ToString())"
                               @onchange="e => { if (double.TryParse(e.Value?.ToString(), out var v)) _ycSubWeight = v; else _ycSubWeight = 0; }" placeholder="예: 100" />
                    </div>
                    <div class="form-group" style="margin-bottom:0;">
                        <label class="form-label" style="font-size:0.78rem;">m당</label>
                        <input class="form-control" type="number" step="1"
                               value="@(_ycSubLength == 0 ? "" : _ycSubLength.ToString())"
                               @onchange="e => { if (double.TryParse(e.Value?.ToString(), out var v)) _ycSubLength = v; else _ycSubLength = 0; }" placeholder="예: 250" />
                    </div>
                </div>
                @if (YarnCalcResult != null)
                {
                    <div style="display:flex; gap:8px; margin-top:14px;">
                        <div style="flex:1; background:var(--ivory-dark); border-radius:var(--radius-sm); padding:10px; text-align:center;">
                            <div style="font-size:0.72rem; color:var(--text-light); margin-bottom:4px;">필요 수량</div>
                            <div style="font-size:1.3rem; font-weight:700; color:#4e3290;">@YarnCalcResult.Value.skeins.ToString("0.##") @YarnCalcUnitLabel</div>
                        </div>
                        <div style="flex:1; background:var(--ivory-dark); border-radius:var(--radius-sm); padding:10px; text-align:center;">
                            <div style="font-size:0.72rem; color:var(--text-light); margin-bottom:4px;">필요량</div>
                            <div style="font-size:1.3rem; font-weight:700; color:#1a5276;">@YarnCalcResult.Value.totalG.ToString("0") g</div>
                        </div>
                    </div>
                    <p style="font-size:0.72rem; color:var(--text-light); margin-top:8px;">※ 계산된 값 그대로예요. 실제 구매 단위(보통 100g 단위)에 맞춰 얼마나 올려 살지는 직접 판단해주세요.</p>
                }
                else
                {
                    <p style="font-size:0.78rem; color:var(--text-light); margin-top:12px;">②의 총 필요 길이와, 내가 쓰려는 실의 g당/m당을 모두 입력하면 결과가 나와요.</p>
                }
            </div>

            <div class="modal-footer">
                <button class="btn btn-ghost" @onclick="CloseYarnCalc">닫기</button>
            </div>
        </div>
    </div>
}

<!-- 삭제 확인 모달 -->
@if (_showConfirm)
{
    <div style="position:fixed;inset:0;background:rgba(0,0,0,0.32);display:flex;align-items:center;justify-content:center;z-index:9999;padding:20px;box-sizing:border-box;">
        <div style="background:var(--white);border-radius:16px;max-width:320px;width:100%;padding:24px 20px;text-align:center;box-shadow:0 8px 32px rgba(0,0,0,0.18);" @onclick:stopPropagation="true">
            <div style="margin-bottom:12px;display:flex;justify-content:center;"><img src="icons/trash.svg" class="icon-line" style="width:32px;height:32px;" /></div>
            <div style="font-size:1rem; font-weight:600; margin-bottom:8px; color:var(--text-dark);">정말 삭제할까요?</div>
            <div style="font-size:0.88rem; color:var(--text-mid); margin-bottom:20px;">@_confirmMsg</div>
            <div style="display:flex; gap:10px; justify-content:center;">
                <button class="btn btn-ghost" @onclick="() => _showConfirm = false">취소</button>
                <button class="btn btn-danger" @onclick="ExecuteConfirm">삭제</button>
            </div>
        </div>
    </div>
}

@code {
    bool _saving = false;
    bool _showConfirm = false;
    string _confirmMsg = "";
    Func<Task>? _confirmAction;

    void Confirm(string msg, Func<Task> action)
    {
        _confirmMsg    = msg;
        _confirmAction = action;
        _showConfirm   = true;
    }

    async Task ExecuteConfirm()
    {
        _showConfirm = false;
        if (_confirmAction != null)
            await _confirmAction();
        _confirmAction = null;
    }

    bool _loading = true;
    string _wishSort = "created_desc";
    IEnumerable<KnitProject> SortedWishes => _wishSort switch
    {
        "name_asc"      => _projects.OrderBy(p => p.PatternName),
        "name_desc"     => _projects.OrderByDescending(p => p.PatternName),
        "created_asc"   => _projects.OrderBy(p => p.CreatedAt),
        "source_asc"    => _projects.OrderBy(p => p.PatternSource).ThenBy(p => p.PatternName),
        "source_desc"   => _projects.OrderByDescending(p => p.PatternSource).ThenBy(p => p.PatternName),
        _               => _projects.OrderByDescending(p => p.CreatedAt),
    };
    bool _showModal = false;
    List<KnitProject> _projects = new();
    List<Yarn> _yarns = new();
    KnitProject? _editingProject;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        _yarns = await Storage.GetYarnsAsync();
        _wishSort = await JS.InvokeAsync<string?>("localStorage.getItem", "wish_sort") ?? "created_desc";
        _loading = false;
    }

    async Task SetWishSort(string val)
    {
        _wishSort = val;
        await JS.InvokeVoidAsync("localStorage.setItem", "wish_sort", val);
    }

    async Task LoadData()
    {
        var all = await Storage.GetProjectsAsync();
        // 데이터 표시 시에도 Title 대신 PatternName을 우선적으로 보여주려면 
        // 여기서 정렬이나 가공을 할 수 있습니다.
        _projects = all.Where(p => p.Status == ProjectStatus.위시리스트).ToList();
    }

    void OpenAddModal()
    {
        // 초기화 시 빈 문자열이라도 넣어둡니다.
        _editingProject = new KnitProject { 
            Id = Guid.Empty, 
            Status = ProjectStatus.위시리스트,
            PatternName = "" 
        };
        _showModal = true;
        _scrollModalTop = true;
        _ = JS.InvokeVoidAsync("lockBodyScroll");
    }

    bool _scrollModalTop = false;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scrollModalTop) { _scrollModalTop = false; await JS.InvokeVoidAsync("scrollModalToTop"); }
    }

    void OpenEditModal(KnitProject proj)
    {
        // 취소 시 원본이 오염되지 않도록 JSON 딥카피해서 편집 (저장 버튼을 눌러야만 실제 반영됨)
        var json = System.Text.Json.JsonSerializer.Serialize(proj);
        _editingProject = System.Text.Json.JsonSerializer.Deserialize<KnitProject>(json)!;
        _showModal = true; _scrollModalTop = true;
        _ = JS.InvokeVoidAsync("lockBodyScroll");
    }
    void CloseModal() { _showModal = false; _editingProject = null; _ = JS.InvokeVoidAsync("unlockBodyScroll"); }

    async Task SaveProject()
    {
        if (_editingProject == null) return;
        _saving = true; StateHasChanged();

        // [수정 포인트] Title 대신 PatternName이 있는지 확인합니다.
        if (string.IsNullOrWhiteSpace(_editingProject.PatternName))
        {
            // 도안명이 비어있으면 저장되지 않도록 하거나, 기본값을 넣어줍니다.
            _saving = false;
            return;
        }

        if (_editingProject.Id == Guid.Empty) _editingProject.Id = Guid.NewGuid();
        
        await Storage.SaveProjectAsync(_editingProject);
        _saving = false;
        await JS.InvokeVoidAsync("showToast", "저장됐어요");
        CloseModal();
        await LoadData();
    }

    async Task StartProject(Guid id)
    {
        await Storage.StartProjectAsync(id);
        await JS.InvokeVoidAsync("localStorage.setItem", "knitlog_edit_popup", id.ToString());
        Nav.NavigateTo("projects");
    }

    async Task DeleteProject(Guid id)
    {
        await JS.InvokeVoidAsync("showToast", "삭제하는 중...", "info");
        await Storage.DeleteProjectAsync(id);
        await LoadData();
    }

    // ── 실 소요량 계산기 (원작실 대비 내가 쓰려는 실의 필요량 계산 — 프로젝트에 저장하지 않는 임시 계산기) ──
    bool _showYarnCalc = false;
    KnitProject? _ycProject;
    double _ycOrigWeight = 100;   // 원작실 g당
    double _ycOrigLength = 0;     // 원작실 m당
    double _ycOrigTotalG = 0;     // 원작 총 소요g (선택 입력)
    double _ycTotalMeters = 0;    // 총 필요 길이(m)
    Guid? _ycSubYarnId = null;    // 대체실(실창고에서 선택 시)
    double _ycSubWeight = 100;    // 대체실 g당
    double _ycSubLength = 0;      // 대체실 m당

    (double skeins, double totalG)? YarnCalcResult
    {
        get
        {
            if (_ycTotalMeters <= 0 || _ycSubLength <= 0 || _ycSubWeight <= 0) return null;
            var skeins = _ycTotalMeters / _ycSubLength;
            var totalG = skeins * _ycSubWeight;
            return (skeins, totalG);
        }
    }

    // 선택된(또는 직접 입력한) 실의 종류에 맞춰 "콘"/"볼" 단위 표시, 알 수 없으면 "개"
    string YarnCalcUnitLabel
    {
        get
        {
            var y = _ycSubYarnId != null ? _yarns.Find(x => x.Id == _ycSubYarnId) : null;
            if (y != null) return y.YarnType == YarnType.콘사 ? "콘" : "볼";
            return "개";
        }
    }

    void OpenYarnCalc(KnitProject proj)
    {
        _ycProject = proj;
        // 초기화 후, 위시 항목에 저장된 원작실 정보가 있으면 자동 입력
        _ycOrigWeight = 100; _ycOrigLength = 0; _ycOrigTotalG = 0; _ycTotalMeters = 0;
        _ycSubYarnId = null; _ycSubWeight = 100; _ycSubLength = 0;
        if (proj.OriginalYarnWeightG > 0) _ycOrigWeight = proj.OriginalYarnWeightG;
        if (proj.OriginalYarnLengthM > 0) _ycOrigLength = proj.OriginalYarnLengthM;
        if (proj.OriginalYarnAmountUnit == "m")
        {
            // 소요량이 m 단위로 저장돼있으면 g당/m당 환산 없이 바로 총 필요 길이로 사용
            if (proj.OriginalYarnAmountG > 0) _ycTotalMeters = proj.OriginalYarnAmountG;
        }
        else if (proj.OriginalYarnAmountUnit == "볼")
        {
            // 소요량이 볼 단위로 저장돼있으면 볼수 × 원작 m당 = 총 필요 길이
            if (proj.OriginalYarnAmountG > 0 && _ycOrigLength > 0)
                _ycTotalMeters = Math.Round(proj.OriginalYarnAmountG * _ycOrigLength);
        }
        else
        {
            if (proj.OriginalYarnAmountG > 0) _ycOrigTotalG = proj.OriginalYarnAmountG;
            if (_ycOrigWeight > 0 && _ycOrigLength > 0 && _ycOrigTotalG > 0)
                _ycTotalMeters = Math.Round(_ycOrigTotalG / _ycOrigWeight * _ycOrigLength);
        }

        // 이미 연결된 실이 있으면 "내가 쓰려는 실"에 자동 선택
        var firstUsage = proj.YarnUsages.FirstOrDefault();
        if (firstUsage != null)
        {
            var y = _yarns.Find(x => x.Id == firstUsage.YarnId);
            if (y != null)
            {
                _ycSubYarnId = y.Id;
                _ycSubWeight = y.WeightGram;
                _ycSubLength = y.LengthMeter;
            }
        }
        _showYarnCalc = true;
    }

    void CloseYarnCalc() { _showYarnCalc = false; _ycProject = null; }

    void ApplyYarnCalcOrigMeters()
    {
        if (_ycOrigWeight > 0 && _ycOrigLength > 0 && _ycOrigTotalG > 0)
            _ycTotalMeters = Math.Round(_ycOrigTotalG / _ycOrigWeight * _ycOrigLength);
    }

    void OnYarnCalcSubYarnChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (string.IsNullOrEmpty(val) || !Guid.TryParse(val, out var yid))
        {
            _ycSubYarnId = null;
            return;
        }
        _ycSubYarnId = yid;
        var y = _yarns.Find(x => x.Id == yid);
        if (y != null)
        {
            _ycSubWeight = y.WeightGram;
            _ycSubLength = y.LengthMeter;
        }
    }
}
