@page "/stats"
@using KnitLog.Models
@using KnitLog.Services
@inject StorageService Storage
@inject IJSRuntime JS

<div class="page-header">
    <div>
        <h1 class="page-title"><img src="icons/chart-bar.svg" class="icon-line" style="width:36px;height:36px;" />통계</h1>
        <p class="page-subtitle">나의 뜨개 기록을 돌아봐요</p>
    </div>
</div>

@if (_loading)
{
    <div class="loading">불러오는 중...</div>
}
else
{
    <!-- 요약 카드 -->
    <div class="stats-grid" style="margin-bottom:28px;">
        <div class="card" style="display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center;">
            <div style="margin-bottom:6px;"><img src="icons/t-shirt.svg" class="icon-line" style="width:28px;height:28px;" /></div>
            <div style="font-size:2rem; font-weight:800; color:var(--theme-active);">@_totalFinished</div>
            <div style="font-size:0.82rem; color:var(--text-mid);">완성작</div>
        </div>
        <div class="card" style="display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center;">
            <div style="margin-bottom:6px;"><img src="icons/paw-print.svg" class="icon-line" style="width:28px;height:28px;" /></div>
            <div style="font-size:2rem; font-weight:800; color:var(--theme-active);">@_totalInProgress</div>
            <div style="font-size:0.82rem; color:var(--text-mid);">진행중</div>
        </div>
        <div class="card" style="display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center;">
            <div style="margin-bottom:6px;"><img src="icons/clock.svg" class="icon-line" style="width:28px;height:28px;" /></div>
            <div style="font-size:1.3rem; font-weight:800; color:var(--theme-active);">@_totalTimeStr</div>
            <div style="font-size:0.82rem; color:var(--text-mid);">총 뜨개 시간</div>
        </div>

    </div>

    <!-- 기간 탭 -->
    <div style="display:flex; gap:8px; margin-bottom:14px; flex-wrap:wrap;">
        @foreach (var p in new[] { ("day","오늘"), ("week","이번 주"), ("month","이번 달") })
        {
            <button class="btn @(_period == p.Item1 ? "btn-sage" : "btn-secondary")"
                    @onclick="() => SetPeriod(p.Item1)">@p.Item2</button>
        }
    </div>

    <!-- 기간 세부 선택: day/week는 날짜 이동, month는 연월 콤보박스 -->
    <div style="display:flex; align-items:center; gap:8px; margin-bottom:20px; flex-wrap:wrap;">
        @if (_period == "day" || _period == "week")
        {
            <button class="btn btn-ghost btn-sm" @onclick="GoPrevRef">‹</button>
            <span style="font-size:0.92rem; font-weight:600; color:var(--text-dark); min-width:120px; text-align:center;">@RefRangeLabel()</span>
            <button class="btn btn-ghost btn-sm" @onclick="GoNextRef">›</button>
            <input type="date" class="form-control" style="max-width:160px;"
                   value="@_refDate.ToString("yyyy-MM-dd")"
                   @onchange="OnRefDateInput" />
            @if (!IsRefToday())
            {
                <button class="btn btn-ghost btn-sm" @onclick="GoToToday">오늘로</button>
            }
        }
        else
        {
            <select class="form-control" style="max-width:110px;" @onchange="OnYearSelect">
                @foreach (var y in _yearOptions)
                {
                    <option value="@y" selected="@(y == _refDate.Year)">@(y)년</option>
                }
            </select>
            <select class="form-control" style="max-width:90px;" @onchange="OnMonthSelect">
                @for (int m = 1; m <= 12; m++)
                {
                    <option value="@m" selected="@(m == _refDate.Month)">@(m)월</option>
                }
            </select>
            @if (!IsRefThisMonth())
            {
                <button class="btn btn-ghost btn-sm" @onclick="GoToToday">이번 달로</button>
            }
        }
    </div>

    <!-- 뜨개 시간 그래프 -->
    <div class="card" style="margin-bottom:20px;">
        <div class="card-title" style="margin-bottom:16px; display:flex; align-items:center; gap:6px;"><img src="icons/clock.svg" class="icon-line" style="width:24px;height:24px; flex-shrink:0;" /> 뜨개 시간</div>
        @if (_chartData.Count == 0)
        {
            <div style="text-align:center; padding:32px; color:var(--text-light);">이 기간에 기록이 없어요</div>
        }
        else if (_period == "month")
        {
            @* 월 단위: 추세를 보기 좋은 꺾은선 그래프 *@
            <div style="position:relative; height:180px; padding-bottom:4px;">
                <svg viewBox="0 0 100 100" preserveAspectRatio="none" style="position:absolute; left:0; top:0; width:100%; height:100%; overflow:visible;">
                    <polyline points="@MonthPolylinePoints()" fill="none" stroke="var(--theme-active)" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke" />
                    @for (int i = 0; i < _chartData.Count; i++)
                    {
                        var idx = i;
                        var d = _chartData[idx];
                        var cx = MonthXAt(idx);
                        var cy = MonthYAt(d.Seconds);
                        <circle cx="@cx.ToString("F2")" cy="@cy.ToString("F2")" r="@(d.Seconds > 0 ? "1.4" : "0.9")" fill="var(--theme-active)" vector-effect="non-scaling-stroke" />
                    }
                </svg>
                @for (int i = 0; i < _chartData.Count; i++)
                {
                    var idx = i;
                    var d = _chartData[idx];
                    var cxPct = MonthXAt(idx);
                    var cyPct = MonthYAt(d.Seconds);
                    var showDateLabel = _chartData.Count <= 10 || idx % 5 == 0 || idx == _chartData.Count - 1;
                    @if (d.Seconds > 0 && _chartData.Count <= 14)
                    {
                        <div style="position:absolute; left:@(cxPct.ToString("F2"))%; top:@(cyPct.ToString("F2"))%; transform:translate(-50%,-130%); font-size:0.62rem; font-weight:600; color:var(--theme-active); white-space:nowrap;">@FormatTime(d.Seconds)</div>
                    }
                    @if (showDateLabel)
                    {
                        <div style="position:absolute; left:@(cxPct.ToString("F2"))%; top:97%; transform:translate(-50%,0); font-size:0.6rem; color:var(--text-light); white-space:nowrap;">@d.Label</div>
                    }
                }
            </div>
        }
        else
        {
            @* 일/주 단위: 각 구간이 독립적인 합계라 막대그래프가 더 직관적 *@
            <div style="display:flex; align-items:flex-end; gap:6px; height:160px; padding-bottom:8px;">
                @{ var maxVal = _chartData.Max(d => d.Seconds); maxVal = maxVal == 0 ? 1 : maxVal; }
                @foreach (var d in _chartData)
                {
                    var heightPct = maxVal > 0 ? (double)d.Seconds / maxVal * 100 : 0;
                    <div style="flex:1; display:flex; flex-direction:column; align-items:center; gap:4px; height:100%;">
                        <div style="flex:1; display:flex; align-items:flex-end; width:100%;">
                            <div style="width:100%; height:@(heightPct.ToString("F1"))%; background:var(--theme-light); border-radius:4px 4px 0 0; min-height:@(d.Seconds > 0 ? "3px" : "0"); transition:height 0.3s;"></div>
                        </div>
                        @if (d.Seconds > 0)
                        {
                            <div style="font-size:0.6rem; color:var(--theme-active); font-weight:600; text-align:center; line-height:1.2;">
                                @FormatTime(d.Seconds)
                            </div>
                        }
                        <div style="font-size:0.65rem; color:var(--text-light); white-space:nowrap;">@d.Label</div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- 세션 기록 -->
    <div class="card">
        <div class="card-title" style="margin-bottom:16px; display:flex; align-items:center; gap:6px;"><img src="icons/notebook.svg" class="icon-line" style="width:24px;height:24px; flex-shrink:0;" /> 최근 뜨개 기록</div>
        @if (_recentSessions.Count == 0)
        {
            <div style="color:var(--text-light); font-size:0.88rem;">기록이 없어요</div>
        }
        else
        {
            @foreach (var (session, projectTitle) in _recentSessions)
            {
                <div style="display:flex; align-items:center; gap:12px; padding:10px 0; border-bottom:1px solid var(--border);">
                    <div style="flex:1; min-width:0;">
                        <div style="font-weight:600; font-size:0.88rem; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@projectTitle</div>
                        <div style="font-size:0.78rem; color:var(--text-light);">@session.StartTime.ToString("M월 d일 HH:mm")</div>
                    </div>
                    <div style="font-weight:700; color:var(--theme-active); font-size:0.9rem; flex-shrink:0;">
                        @FormatTime((int)((session.EndTime ?? DateTime.Now) - session.StartTime).TotalSeconds)
                    </div>
                </div>
            }
        }
    </div>
}

@code {
    bool _loading = true;
    string _period = "week";
    DateTime _refDate = DateTime.Now.Date; // 통계 기준 날짜 (오늘/이번 주/이번 달의 기준점)
    int _totalFinished, _totalInProgress;
    string _totalTimeStr = "0분";
    List<(string Label, int Seconds)> _chartData = new();
    List<(KnitSession Session, string ProjectTitle)> _recentSessions = new();
    List<KnitProject> _projects = new();

    // 연도 콤보박스 옵션: 기록이 있는 최소 연도 ~ 현재 연도 (+1년 여유)
    List<int> _yearOptions = new();

    protected override async Task OnInitializedAsync()
    {
        _projects  = await Storage.GetProjectsAsync();
        _totalFinished   = _projects.Count(p => p.Status == ProjectStatus.완료);
        _totalInProgress = _projects.Count(p => p.Status == ProjectStatus.진행중);
        var allSecs = _projects.SelectMany(p => p.Sessions)
            .Where(s => s.EndTime.HasValue)
            .Sum(s => (int)((s.EndTime!.Value) - s.StartTime).TotalSeconds);
        _totalTimeStr = FormatTime(allSecs);

        var thisYear = DateTime.Now.Year;
        var earliestYear = _projects.SelectMany(p => p.Sessions).Where(s => s.EndTime.HasValue)
            .Select(s => s.StartTime.Year).DefaultIfEmpty(thisYear).Min();
        _yearOptions = Enumerable.Range(Math.Min(earliestYear, thisYear), thisYear - Math.Min(earliestYear, thisYear) + 1)
            .OrderByDescending(y => y).ToList();

        BuildChart();
        BuildRecentSessions();
        _loading = false;
    }

    string FormatTime(int secs)
    {
        var h = secs / 3600; var m = (secs % 3600) / 60; var s = secs % 60;
        if (h > 0) return $"{h}시간 {m:D2}분";
        if (m > 0) return $"{m}분 {s:D2}초";
        return secs > 0 ? $"{s}초" : "0분";
    }

    void SetPeriod(string period) { _period = period; BuildChart(); }

    // ── 기간 기준일 이동/선택 ──────────────────────────────────
    bool IsRefToday() => _refDate.Date == DateTime.Now.Date;
    bool IsRefThisMonth() => _refDate.Year == DateTime.Now.Year && _refDate.Month == DateTime.Now.Month;

    void GoToToday() { _refDate = DateTime.Now.Date; BuildChart(); }

    void GoPrevRef()
    {
        _refDate = _period == "week" ? _refDate.AddDays(-7) : _refDate.AddDays(-1);
        BuildChart();
    }

    void GoNextRef()
    {
        _refDate = _period == "week" ? _refDate.AddDays(7) : _refDate.AddDays(1);
        BuildChart();
    }

    void OnRefDateInput(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var d))
        {
            _refDate = d.Date;
            BuildChart();
        }
    }

    void OnYearSelect(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var y))
        {
            var day = Math.Min(_refDate.Day, DateTime.DaysInMonth(y, _refDate.Month));
            _refDate = new DateTime(y, _refDate.Month, day);
            BuildChart();
        }
    }

    void OnMonthSelect(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var m))
        {
            var day = Math.Min(_refDate.Day, DateTime.DaysInMonth(_refDate.Year, m));
            _refDate = new DateTime(_refDate.Year, m, day);
            BuildChart();
        }
    }

    string RefRangeLabel()
    {
        if (_period == "day") return _refDate.ToString("M월 d일");
        // week: 월요일 시작 기준 주간 범위
        var monday = _refDate.Date.AddDays(-((int)_refDate.DayOfWeek == 0 ? 6 : (int)_refDate.DayOfWeek - 1));
        var sunday = monday.AddDays(6);
        return monday.Month == sunday.Month
            ? $"{monday:M월 d일} ~ {sunday:d일}"
            : $"{monday:M월 d일} ~ {sunday:M월 d일}";
    }

    void BuildChart()
    {
        _chartData.Clear();
        var refD = _refDate;

        if (_period == "day")
        {
            // 선택한 날짜를 2시간 단위로
            for (int h = 0; h < 24; h += 2)
            {
                var from = refD.Date.AddHours(h);
                var to   = from.AddHours(2);
                var secs = GetSeconds(from, to);
                _chartData.Add(($"{h:D2}", secs));
            }
        }
        else if (_period == "week")
        {
            // 선택한 날짜가 속한 주 7일 (월요일 시작)
            var monday = refD.Date.AddDays(-((int)refD.DayOfWeek == 0 ? 6 : (int)refD.DayOfWeek - 1));
            var dayNames = new[] { "월","화","수","목","금","토","일" };
            for (int i = 0; i < 7; i++)
            {
                var day = monday.AddDays(i);
                var secs = GetSeconds(day, day.AddDays(1));
                _chartData.Add((dayNames[i], secs));
            }
        }
        else
        {
            // 선택한 연/월 — 일 단위로 표시 (꺾은선 그래프와 함께 추세를 보기 좋게)
            var firstDay = new DateTime(refD.Year, refD.Month, 1);
            var daysInMonth = DateTime.DaysInMonth(refD.Year, refD.Month);
            for (int day = 1; day <= daysInMonth; day++)
            {
                var cur = firstDay.AddDays(day - 1);
                var secs = GetSeconds(cur, cur.AddDays(1));
                _chartData.Add(($"{day}", secs));
            }
        }
    }

    // ── 월 단위 꺾은선 그래프 좌표 계산 ──────────────────────────
    double MonthXAt(int i)
    {
        var n = _chartData.Count;
        double padX = 4, svgW = 100;
        return n <= 1 ? svgW / 2 : padX + (svgW - padX * 2) * i / (n - 1);
    }

    double MonthYAt(int secs)
    {
        var maxVal = _chartData.Count > 0 ? _chartData.Max(d => d.Seconds) : 0;
        maxVal = maxVal == 0 ? 1 : maxVal;
        double padTop = 12, padBottom = 18, svgH = 100;
        return padTop + (svgH - padTop - padBottom) * (1 - (double)secs / maxVal);
    }

    string MonthPolylinePoints()
    {
        var points = _chartData.Select((d, i) =>
            $"{MonthXAt(i).ToString("F2")},{MonthYAt(d.Seconds).ToString("F2")}");
        return string.Join(" ", points);
    }

    int GetSeconds(DateTime from, DateTime to) =>
        _projects.SelectMany(p => p.Sessions)
            .Where(s => s.EndTime.HasValue && s.StartTime >= from && s.StartTime < to)
            .Sum(s => (int)(s.EndTime!.Value - s.StartTime).TotalSeconds);

    void BuildRecentSessions()
    {
        _recentSessions = _projects
            .SelectMany(p => p.Sessions
                .Where(s => s.EndTime.HasValue)
                .Select(s => (s, p.Title)))
            .OrderByDescending(x => x.s.StartTime)
            .Take(10)
            .ToList();
    }
}
