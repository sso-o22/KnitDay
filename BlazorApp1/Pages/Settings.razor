                        <div style="width:16px;height:16px;border-radius:50%;border:2px solid @(_exportIncludePhotos ? "var(--border)" : "var(--theme-active)");background:@(_exportIncludePhotos ? "transparent" : "var(--theme-active)");flex-shrink:0;"></div>
                        <div>
                            <div style="font-size:0.85rem;font-weight:600;color:var(--text-dark);">사진 제외</div>
                            <div style="font-size:0.72rem;color:var(--text-light);">파일 작음 · 빠름</div>
                        </div>
                    </div>
                    <div style="display:flex;align-items:center;gap:10px;padding:10px 14px;border:1.5px solid @(_exportIncludePhotos ? "var(--theme-active)" : "var(--border)");border-radius:10px;cursor:pointer;"
                         @onclick="() => _exportIncludePhotos = true">
                        <div style="width:16px;height:16px;border-radius:50%;border:2px solid @(_exportIncludePhotos ? "var(--theme-active)" : "var(--border)");background:@(_exportIncludePhotos ? "var(--theme-active)" : "transparent");flex-shrink:0;"></div>
                        <div>
                            <div style="font-size:0.85rem;font-weight:600;color:var(--text-dark);">사진 포함</div>
                            <div style="font-size:0.72rem;color:var(--text-light);">파일 클 수 있음 · 완전 백업</div>
                        </div>
                    </div>
                </div>
                }

                <div style="display:flex;gap:8px;justify-content:center;">
                    <button class="btn btn-ghost" @onclick="() => _exportStep = 1">뒤로</button>
                    <button class="btn btn-primary" @onclick="ExecuteExport"
