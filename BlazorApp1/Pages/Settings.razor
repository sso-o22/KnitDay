            }
            else if (_exportStep == 2)
            {
                <!-- 2단계: 옵션 (전체 or 선택 공통) -->
                <div style="font-size:1rem;font-weight:700;margin-bottom:4px;color:var(--text-dark);text-align:center;">
                    @(_exportIsSelectMode ? $"프로젝트 {_exportSelectedIds.Count}개 선택됨" : _exportExcludeProjects ? "실·도구·스와치만" : "전체 내보내기")
