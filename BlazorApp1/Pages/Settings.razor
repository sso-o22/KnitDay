@page "/settings"
@implements IDisposable
@using KnitLog.Layout
@inject HttpClient Http
@inject IJSRuntime JS
@inject AuthService Auth
@inject StorageService Storage

<div class="page-header">
    <div>
        <h1 class="page-title"><img src="icons/gear.svg" class="icon-line" style="width:36px;height:36px;" />설정</h1>
        <p class="page-subtitle">앱 환경을 설정해요</p>
    </div>
</div>

<div class="settings-wrapper">

    <!-- 계정 (프리미엄 전용) -->
    @if (_isPremium || Auth.IsLoggedIn)
    {
    <div class="card">
        <div class="card-title" style="margin-bottom:4px; display:flex; align-items:center; gap:6px;">
            @if (Auth.IsLoggedIn)
            {
                <img src="icons/user-check.svg" class="icon-line" style="width:20px;height:20px;flex-shrink:0;" />
            }
            else
            {
                <img src="icons/user.svg" class="icon-line" style="width:20px;height:20px;flex-shrink:0;" />
            }
            계정
            <span style="margin-left:auto; font-size:0.7rem; font-weight:700; letter-spacing:0.04em; padding:2px 8px; border-radius:99px; background:var(--theme-active); color:var(--white);">PREMIUM</span>
        </div>
        @if (Auth.IsLoggedIn)
        {
            <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px;">
                @if (!string.IsNullOrEmpty(Auth.CurrentUser?.PhotoURL))
                {
                    <img src="@Auth.CurrentUser.PhotoURL" style="width:44px;height:44px;border-radius:50%;object-fit:cover;" />
                }
                <div>
                    <div style="font-weight:600;">@Auth.CurrentUser?.DisplayName</div>
                    <div style="font-size:0.82rem;color:var(--text-mid);">@Auth.CurrentUser?.Email</div>
                    <div style="font-size:0.75rem;color:var(--text-light);margin-top:2px;display:flex;align-items:center;gap:4px;"><img src="icons/cloud-check.svg" class="icon-line" style="width:13px;height:13px;flex-shrink:0;" />Firebase 동기화 중</div>
                </div>
            </div>
            <div style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:12px;">
                <button class="btn btn-secondary" style="display:inline-flex;align-items:center;gap:6px;" @onclick="ManualPush" disabled="@_manualSyncing"><img src="icons/cloud-arrow-up.svg" class="icon-line" style="width:15px;height:15px;flex-shrink:0;" />@(_manualSyncing ? "업로드 중..." : "DB에 업로드")</button>
                <button class="btn btn-secondary" style="display:inline-flex;align-items:center;gap:6px;" @onclick="ManualPull" disabled="@_manualSyncing"><img src="icons/cloud-arrow-down.svg" class="icon-line" style="width:15px;height:15px;flex-shrink:0;" />@(_manualSyncing ? "다운로드 중..." : "DB에서 가져오기")</button>
            </div>
            @if (!string.IsNullOrEmpty(_manualSyncMsg))
            {
                <div style="font-size:0.78rem; color:@(_manualSyncError ? "#c03030" : "var(--theme-active)"); margin-bottom:8px; display:flex; align-items:center; gap:5px;">
                    @if (_manualSyncError)
                    {
                        <img src="icons/warning-circle.svg" class="icon-line" style="width:14px;height:14px;flex-shrink:0;" />
                    }
                    else
                    {
                        <img src="icons/check-circle.svg" class="icon-line" style="width:14px;height:14px;flex-shrink:0;" />
                    }
                    @_manualSyncMsg
                </div>
            }
            <button class="btn btn-secondary" style="display:inline-flex;align-items:center;gap:6px;" @onclick="SignOut"><img src="icons/sign-out.svg" class="icon-line" style="width:15px;height:15px;flex-shrink:0;" />로그아웃</button>
            @if (Auth.CurrentUser?.Uid == "xAz2xO8kulWUgoHnaaxCkzZV2nG2")
            {
                <a href="admin" style="display:inline-flex;align-items:center;gap:6px;margin-top:10px;margin-left:16px;font-size:0.78rem;color:var(--text-light);text-decoration:none;">
                    <img src="icons/key.svg" class="icon-line" style="width:13px;height:13px;flex-shrink:0;" />관리자 페이지
                </a>
            }
        }
        else
        {
            <p style="font-size:0.85rem;color:var(--text-mid);margin-bottom:12px;">
                구글 계정으로 로그인하면 여러 기기에서 데이터를 동기화할 수 있어요.
            </p>
            <button class="btn btn-primary" style="display:inline-flex;align-items:center;gap:6px;" @onclick="SignIn"><img src="icons/key.svg" class="icon-line" style="width:15px;height:15px;flex-shrink:0;" />구글 로그인</button>
        }
    </div>
    } @* _isPremium || IsLoggedIn *@

    <!-- 테마 -->
    <div class="card">
        <div class="card-title" style="margin-bottom:4px; display:flex; align-items:center; gap:6px;"><img src="icons/palette.svg" class="icon-line" style="width:20px;height:20px;flex-shrink:0;" />테마 색상</div>
        @if (_isDark)
        {
            <p style="font-size:0.82rem; color:var(--text-mid); margin-bottom:12px;">다크 모드에서는 흑백 테마만 적용돼요</p>
        }
        else
        {
            <div style="margin-bottom:12px;"></div>
        }
        <div style="display:grid; grid-template-columns:repeat(5,1fr); gap:12px;">
            @foreach (var t in _themes)
            {
                var isDisabled = _isDark && t.Id != "mono";
                <button class="settings-theme-btn @((!_isDark && _currentTheme == t.Id) || (_isDark && t.Id == "mono") ? "active" : "")"
                        style="@(isDisabled ? "opacity:0.3; cursor:not-allowed;" : "")"
                        @onclick="async () => { if (!isDisabled) await SetTheme(t.Id); }">
                    <div class="settings-theme-dot" style="background:@t.DotColor;"></div>
                    <span class="settings-theme-name">@t.Name</span>
                </button>
            }
        </div>
    </div>

    <!-- 다크모드 -->
    <div class="card">
        <div style="display:flex; align-items:center; justify-content:space-between;">
            <div>
                <div class="card-title" style="margin-bottom:4px; display:flex; align-items:center; gap:6px;">
                    @if (_isDark)
                    {
                        <img src="icons/moon.svg" class="icon-line" style="width:20px;height:20px;flex-shrink:0;" /><span>다크 모드</span>
                    }
                    else
                    {
                        <img src="icons/sun.svg" class="icon-line" style="width:20px;height:20px;flex-shrink:0;" /><span>라이트 모드</span>
                    }
                </div>
                <p style="font-size:0.85rem; color:var(--text-mid);">@(_isDark ? "배경/글자가 반전되고 흑백 테마로 표시돼요" : "테마 색상이 적용된 라이트 모드예요")</p>
            </div>
            <button class="dark-toggle-btn @(_isDark ? "on" : "")" @onclick="ToggleDark">
                <div class="dark-toggle-thumb"></div>
            </button>
        </div>
    </div>

    <!-- 데이터 -->
    <div class="card">
        <div class="card-title" style="margin-bottom:4px; display:flex; align-items:center; gap:6px;"><img src="icons/floppy-disk.svg" class="icon-line" style="width:20px;height:20px;flex-shrink:0;" />데이터</div>
        <p style="font-size:0.85rem; color:var(--text-mid); margin-bottom:8px;">
            프로젝트, 실 창고, 도구, 스와치 데이터가 저장돼요.
        </p>

        @* ── 저장공간 게이지 (로그인: 클라우드 / 비로그인: 기기) ── *@
        @if (Auth.IsLoggedIn)
        {
            <div style="margin-bottom:16px; padding:14px 16px; background:var(--ivory-dark); border-radius:var(--radius-sm);">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                    <span style="font-size:0.82rem; font-weight:600; color:var(--text-dark);">클라우드 저장공간</span>
                    <div style="display:flex; align-items:center; gap:8px;">
                        @if (!_usageLoaded)
                        {
                            <span style="font-size:0.75rem; color:var(--text-light);">불러오는 중...</span>
                        }
                        else
                        {
                            <span style="font-size:0.75rem; color:var(--text-light);">@FmtSize(_photoBytes + _pdfBytes) / @FmtSize(UsageLimitBytes)</span>
                        }
                        <button class="btn btn-ghost btn-sm" style="padding:2px 8px; font-size:0.72rem;"
                                @onclick="RefreshUsageAsync">↺</button>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(_usageDebugMsg))
                {
                    <div style="font-size:0.7rem; color:#c03030; margin-bottom:6px; word-break:break-all;">@_usageDebugMsg</div>
                }
                @* 전체 게이지바 *@
                <div style="height:10px; background:var(--border); border-radius:99px; overflow:hidden; margin-bottom:10px; position:relative;">
                    <div style="position:absolute;left:0;top:0;height:100%;width:@(UsagePdfPct.ToString("F2"))%;background:var(--text-light);border-radius:99px;opacity:0.5;"></div>
                    <div style="position:absolute;left:0;top:0;height:100%;width:@(UsagePhotoPct.ToString("F2"))%;background:@((_photoBytes+_pdfBytes)>=UsageLimitBytes?"#c03030":"var(--theme-active)");border-radius:99px;transition:width 0.4s;"></div>
                </div>
                @* 범례 *@
                <div style="display:flex; gap:14px; flex-wrap:wrap; margin-bottom:4px;">
                    <div style="display:flex; align-items:center; gap:5px; font-size:0.75rem; color:var(--text-mid);">
                        <span style="width:10px;height:10px;border-radius:3px;background:var(--theme-active);flex-shrink:0;"></span>
                        사진 @FmtSize(_photoBytes)
                    </div>
                    <div style="display:flex; align-items:center; gap:5px; font-size:0.75rem; color:var(--text-mid);">
                        <span style="width:10px;height:10px;border-radius:3px;background:var(--text-light);opacity:0.5;flex-shrink:0;"></span>
                        도안 @FmtSize(_pdfBytes)
                    </div>
                    <div style="font-size:0.75rem; color:var(--text-light); margin-left:auto;">
                        @if (_photoBytes + _pdfBytes >= UsageLimitBytes)
                        {
                            <span style="color:#c03030; font-weight:600;">한도 초과</span>
                        }
                        else
                        {
                            <span>잔여 @FmtSize(UsageLimitBytes - _photoBytes - _pdfBytes)</span>
                        }
                    </div>
                </div>
                <div style="display:flex; align-items:center; gap:14px; margin-bottom:10px;">
                    <div style="display:flex; align-items:center; gap:5px; font-size:0.75rem; color:var(--text-mid);">
                        <span style="width:10px;height:10px;border-radius:3px;background:var(--text-light);opacity:0.4;flex-shrink:0;"></span>
                        기타 @FmtSize(_idbOtherBytes)
                    </div>
                </div>
            </div>
        }
        else
        {
            @* 기기 저장공간 게이지 — 사진/도안/기타 분류 *@
            <div style="margin-bottom:16px; padding:14px 16px; background:var(--ivory-dark); border-radius:var(--radius-sm);">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                    <span style="font-size:0.82rem; font-weight:600; color:var(--text-dark);">기기 저장공간</span>
                    @if (!_deviceUsageLoaded)
                    {
                        <span style="font-size:0.75rem; color:var(--text-light);">불러오는 중...</span>
                    }
                    else if (_deviceQuotaBytes <= 0)
                    {
                        <span style="font-size:0.75rem; color:var(--text-light);">정보 없음</span>
                    }
                    else
                    {
                        <span style="font-size:0.75rem; color:var(--text-light);">@FmtSize(_idbPhotoBytes + _idbPdfBytes + _idbOtherBytes) 사용 / @FmtSize(_deviceQuotaBytes)</span>
                    }
                </div>
                @if (_deviceUsageLoaded && _deviceQuotaBytes > 0)
                {
                    @* 기타 = IDB 텍스트 데이터 (캐시 제외) *@
                    var otherTotal = _idbOtherBytes;
                    var idbTotal   = _idbPhotoBytes + _idbPdfBytes + _idbOtherBytes;
                    var photoPct = Math.Min(100.0, _idbPhotoBytes / (double)_deviceQuotaBytes * 100);
                    var pdfPct   = Math.Min(100.0, (_idbPhotoBytes + _idbPdfBytes) / (double)_deviceQuotaBytes * 100);
                    var allPct   = Math.Min(100.0, idbTotal / (double)_deviceQuotaBytes * 100);
                    @* 전체 게이지바 — 기타(뒤)/도안(중)/사진(앞) 3단 적층 *@
                    <div style="height:10px; background:var(--border); border-radius:99px; overflow:hidden; margin-bottom:10px; position:relative;">
                        <div style="position:absolute;left:0;top:0;height:100%;width:@(allPct.ToString("F2"))%;background:var(--text-light);border-radius:99px;opacity:0.4;"></div>
                        <div style="position:absolute;left:0;top:0;height:100%;width:@(pdfPct.ToString("F2"))%;background:var(--text-mid);border-radius:99px;opacity:0.6;"></div>
                        <div style="position:absolute;left:0;top:0;height:100%;width:@(photoPct.ToString("F2"))%;background:@(allPct>=90?"#c03030":"var(--theme-active)");border-radius:99px;transition:width 0.4s;"></div>
                    </div>
                    <div style="display:flex; align-items:center; gap:14px; flex-wrap:wrap; margin-bottom:4px;">
                        <div style="display:flex; align-items:center; gap:5px; font-size:0.75rem; color:var(--text-mid);">
                            <span style="width:10px;height:10px;border-radius:3px;background:var(--theme-active);flex-shrink:0;"></span>
                            사진 @FmtSize(_idbPhotoBytes)
                        </div>
                        <div style="display:flex; align-items:center; gap:5px; font-size:0.75rem; color:var(--text-mid);">
                            <span style="width:10px;height:10px;border-radius:3px;background:var(--text-mid);opacity:0.6;flex-shrink:0;"></span>
                            도안 @FmtSize(_idbPdfBytes)
                        </div>
                        <div style="font-size:0.75rem; color:var(--text-light); margin-left:auto;">
                            잔여 @FmtSize(Math.Max(0, _deviceQuotaBytes - (_idbPhotoBytes + _idbPdfBytes + _idbOtherBytes)))
                        </div>
                    </div>
                    <div style="display:flex; align-items:center; gap:14px; margin-bottom:10px;">
                        <div style="display:flex; align-items:center; gap:5px; font-size:0.75rem; color:var(--text-mid);">
                            <span style="width:10px;height:10px;border-radius:3px;background:var(--text-light);opacity:0.4;flex-shrink:0;"></span>
                            기타 @FmtSize(otherTotal)
                        </div>
                    </div>
                }
                <div style="font-size:0.75rem; color:var(--text-light); line-height:1.5;">
                    기기 여유 공간에 따라 자동으로 조정돼요. (iOS: 수 GB, Android: 수백 MB~수 GB)
                </div>
            </div>
        }
        <div style="font-size:0.82rem;margin-bottom:16px;color:var(--text-light);display:flex;align-items:center;gap:5px;flex-wrap:nowrap;">
            <img src="icons/question.svg" class="icon-line" style="width:13px;height:13px;flex-shrink:0;" />
            <span>저장·동기화·내보내기 궁금한 점은 <a href="faq" style="color:var(--theme-active);font-weight:600;text-decoration:none;">FAQ</a> 확인!</span>
        </div>
        <div style="display:flex; gap:10px; flex-wrap:wrap;">
            <button class="btn btn-secondary" style="display:inline-flex;align-items:center;gap:6px;" @onclick="OpenExportModal"><img src="icons/export.svg" class="icon-line" style="width:15px;height:15px;flex-shrink:0;" />데이터 내보내기</button>
            <button class="btn btn-secondary" style="display:inline-flex;align-items:center;gap:6px;" @onclick="ImportDataClick"><img src="icons/download-simple.svg" class="icon-line" style="width:15px;height:15px;flex-shrink:0;" />데이터 불러오기</button>
        </div>
        <InputFile id="import-file-input" OnChange="ImportData" accept=".json" style="display:none;" />
        @if (_importMsg != "")
        {
            <div style="margin-top:10px; padding:10px 14px; border-radius:8px; font-size:0.88rem; display:flex; align-items:flex-start; gap:8px;"
                 class="@(_importError ? "import-msg-error" : "import-msg-ok")">
                @if (_importError)
                {
                    <img src="icons/warning-circle.svg" class="icon-line" style="width:16px;height:16px;flex-shrink:0;margin-top:1px;" />
                }
                else
                {
                    <img src="icons/check-circle.svg" class="icon-line" style="width:16px;height:16px;flex-shrink:0;margin-top:1px;" />
                }
                <span>@_importMsg</span>
            </div>
        }
    </div>

    <!-- 버전 정보 -->
    <div class="card">
        <div class="card-title" style="margin-bottom:12px; display:flex; align-items:center; gap:6px;"><img src="icons/app-window.svg" class="icon-line" style="width:20px;height:20px;flex-shrink:0;" />앱 정보</div>
        @if (_versionInfo != null)
        {
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:10px;">
                <span style="font-size:0.92rem; font-weight:600; color:var(--text-dark);">KnitDay v@(_versionInfo.Version)</span>
                <span style="font-size:0.78rem; color:var(--text-light);">@(_versionInfo.Date)</span>
            </div>
            <div style="font-size:0.82rem; color:var(--text-mid); margin-bottom:6px;">이번 업데이트</div>
            <ul style="margin:0; padding-left:18px; display:flex; flex-direction:column; gap:4px;">
                @foreach (var item in _versionInfo.Updates)
                {
                    <li style="font-size:0.85rem; color:var(--text-dark);">@item</li>
                }
            </ul>
        }
        else
        {
            <div style="font-size:0.85rem; color:var(--text-light);">버전 정보를 불러오는 중...</div>
        }
    </div>

    <!-- 프리미엄 코드 (로그인 상태에서는 불필요) -->
    @if (!Auth.IsLoggedIn)
    {
    <div class="card">
        <div class="card-title" style="margin-bottom:4px; display:flex; align-items:center; gap:6px;">
            <img src="icons/key.svg" class="icon-line" style="width:20px;height:20px;flex-shrink:0;" />
            @(_isPremium ? "프리미엄 활성화됨" : "프리미엄 코드 입력")
        </div>
        @if (_isPremium)
        {
            <p style="font-size:0.85rem; color:var(--text-mid); margin-bottom:12px;">기기간 동기화 기능이 활성화되어 있어요.</p>
            <button class="btn btn-ghost" style="font-size:0.82rem; color:var(--text-light);" @onclick="DeactivatePremium">비활성화</button>
        }
        else
        {
            <p style="font-size:0.85rem; color:var(--text-mid); margin-bottom:12px;">프리미엄 코드를 입력하면 구글 로그인 및 기기간 동기화 기능을 사용할 수 있어요.</p>
            <div style="display:flex; gap:8px; margin-bottom:10px;">
                <input type="text" @bind="_premiumCodeInput"
                       style="flex:1; min-width:0; padding:9px 12px; border:1.5px solid var(--border); border-radius:var(--radius-sm); font-size:0.88rem; background:var(--white); color:var(--text-dark);" />
                <button class="btn btn-primary" @onclick="ActivatePremium">확인</button>
            </div>
            @if (!string.IsNullOrEmpty(_premiumMsg))
            {
                <div style="margin-top:0; margin-bottom:10px; font-size:0.82rem; color:@(_premiumError ? "#c03030" : "var(--theme-active)");">@_premiumMsg</div>
            }
            <a href="https://smartstore.naver.com/knitday_studio" target="_blank" rel="noopener noreferrer"
               style="display:inline-flex;align-items:center;gap:6px;font-size:0.82rem;color:var(--text-light);text-decoration:none;">
                <img src="icons/storefront.svg" class="icon-line" style="width:14px;height:14px;flex-shrink:0;" />네이버 스토어에서 구매하기
            </a>
        }
    </div>
    }

    <!-- 자주 묻는 질문 -->
    <div class="card">
        <div class="card-title" style="margin-bottom:4px; display:flex; align-items:center; gap:6px;">
            <img src="icons/question.svg" class="icon-line" style="width:20px;height:20px;flex-shrink:0;" />자주 묻는 질문
        </div>
        <p style="font-size:0.85rem;color:var(--text-mid);margin-bottom:12px;">
            저장, 동기화, 내보내기 등 앱 사용 중 헷갈리는 것들을 정리했어요.
        </p>
        <a href="faq" style="display:inline-flex;align-items:center;gap:6px;font-size:0.85rem;color:var(--theme-active);text-decoration:none;font-weight:600;">
            FAQ 보기
        </a>
    </div>

    <!-- 개인정보 처리방침 -->
    <div class="card">
        <div class="card-title" style="margin-bottom:4px; display:flex; align-items:center; gap:6px;">
            <img src="icons/shield-check.svg" class="icon-line" style="width:20px;height:20px;flex-shrink:0;" />법적 고지
        </div>
        <p style="font-size:0.85rem;color:var(--text-mid);margin-bottom:12px;">
            KnitDay는 Google 계정으로만 로그인하며, 개인정보 보호를 중요하게 생각해요.
        </p>
        <a href="privacy" style="display:inline-flex;align-items:center;gap:6px;font-size:0.85rem;color:var(--theme-active);text-decoration:none;font-weight:600;">
            개인정보 처리방침 보기
        </a>
    </div>

    <!-- 피드백 -->
    <div class="card">
        <div class="card-title" style="margin-bottom:4px; display:flex; align-items:center; gap:6px;">
