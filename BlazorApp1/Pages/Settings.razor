                                        <img src="icons/check.svg" class="icon-line" style="width:11px;height:11px;filter:invert(1);" />
                                    }
                                </div>
                                <div style="flex:1;min-width:0;">
                                    <div style="font-size:0.88rem;font-weight:500;color:var(--text-dark);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@proj.Title</div>
                                    <div style="font-size:0.72rem;color:var(--text-light);">@proj.Status @(proj.HasSavedPattern ? "· 도안있음" : "")</div>
                                </div>
                            </div>
                        }
                    </div>
                }

                <!-- 사진 포함 옵션 (프로젝트 제외 모드에선 숨김) -->
                @if (!_exportExcludeProjects)
                {
                <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:16px;">
                    <div style="display:flex;align-items:center;gap:10px;padding:10px 14px;border:1.5px solid @(_exportIncludePhotos ? "var(--border)" : "var(--theme-active)");border-radius:10px;cursor:pointer;"
