        if (Auth.DeniedEmail != null)
        {
            _showDeniedPopup = true;
            _deniedEmail = Auth.DeniedEmail;
        }
        StateHasChanged();
    }
    async Task SignOut() { await Auth.SignOutAsync(); StateHasChanged(); }

    bool _showDeniedPopup = false;
    string? _deniedEmail;
    void CloseDeniedPopup() { _showDeniedPopup = false; _deniedEmail = null; }


    async Task ActivatePremium()
    {
        var code = _premiumCodeInput.Trim();
        if (_validCodes.Contains(code))
        {
            _isPremium = true;
            await JS.InvokeVoidAsync("localStorage.setItem", "knitday_premium", "1");
            _premiumMsg = "프리미엄이 활성화되었어요!";
            _premiumError = false;
            _premiumCodeInput = "";
        }
        else
        {
            _premiumMsg = "올바른 코드가 아니에요.";
            _premiumError = true;
        }
        StateHasChanged();
    }

    async Task DeactivatePremium()
    {
        _isPremium = false;
        await JS.InvokeVoidAsync("localStorage.removeItem", "knitday_premium");
        if (Auth.IsLoggedIn) await Auth.SignOutAsync();
        StateHasChanged();
    }


    async Task ExecuteExport()
    {
        _showExportModal = false;
        await JS.InvokeVoidAsync("eval", "document.body.style.overflow='';document.body.style.position='';document.body.style.width=''");
        var includePhotos = _exportIncludePhotos;
        var isSelectMode  = _exportIsSelectMode;
        var selectedIds   = _exportSelectedIds.Select(id => id.ToString()).ToArray();

        string exportJson;

        if (isSelectMode)
        {
            // ── 프로젝트 선택 모드: 해당 프로젝트만 필터 ──
            var idsJson = System.Text.Json.JsonSerializer.Serialize(selectedIds);
            exportJson = await JS.InvokeAsync<string>("eval", $@"
                (async () => {{
                    const ids = new Set({idsJson});
                    const allData = await window.knitDB.exportAll();
                    const data = {{ exportedAt: allData.exportedAt }};
                    if (allData.knittracker_projects)
                        data.knittracker_projects = allData.knittracker_projects.filter(p => ids.has(p.Id));
                    if (!{includePhotos.ToString().ToLower()} && data.knittracker_projects)
                        data.knittracker_projects.forEach(p => {{ if (p.Photos) p.Photos.forEach(ph => {{ ph.Base64Data = ''; }}); }});
                    return JSON.stringify(data);
                }})()
            ");

            // 선택된 프로젝트의 PDF만
            var pdfIdsArr = System.Text.Json.JsonSerializer.Serialize(selectedIds);
            try
            {
                var pdfJson = await JS.InvokeAsync<string>("patternViewer.exportPdfsByIds", (object)selectedIds);
                if (!string.IsNullOrEmpty(pdfJson) && pdfJson != "{}")
                {
                    await JS.InvokeVoidAsync("eval",
                        $@"(async () => {{
                            const data = JSON.parse({System.Text.Json.JsonSerializer.Serialize(exportJson)});
                            try {{ data.knitlog_pdfs = JSON.parse({System.Text.Json.JsonSerializer.Serialize(pdfJson)}); }} catch(e) {{}}
                            const blob = new Blob([JSON.stringify(data, null, 2)], {{type:'application/json'}});
                            const a = document.createElement('a');
                            a.href = URL.createObjectURL(blob);
                            a.download = 'knitday_backup_' + new Date().toISOString().slice(0,10) + '.json';
                            a.click();
                        }})()");
                    return;
                }
            }
            catch { }
        }
        else
        {
            // ── 전체 모드 (프로젝트 포함 or 제외) ──
            var excludeProjects = _exportExcludeProjects;
            exportJson = await JS.InvokeAsync<string>("eval", $@"
                (async () => {{
                    const data = await window.knitDB.exportAll();
                    if ({excludeProjects.ToString().ToLower()}) {{
                        delete data.knittracker_projects;
                    }} else if (!{includePhotos.ToString().ToLower()}) {{
                        if (data.knittracker_projects)
                            data.knittracker_projects.forEach(p => {{ if (p.Photos) p.Photos.forEach(ph => {{ ph.Base64Data = ''; }}); }});
                        if (data.knittracker_yarns)
                            data.knittracker_yarns.forEach(y => {{ y.PhotoBase64 = ''; }});
                        if (data.knittracker_swatches)
                            data.knittracker_swatches.forEach(s => {{ s.PhotoBase64 = ''; }});
                    }}
                    return JSON.stringify(data);
                }})()
            ");

            if (!excludeProjects)
            {
                try
                {
                    var pdfJson = await JS.InvokeAsync<string>("patternViewer.exportAllPdfs");
                    if (!string.IsNullOrEmpty(pdfJson) && pdfJson != "{}")
                    {
                        await JS.InvokeVoidAsync("eval",
                            $@"(async () => {{
                                const data = JSON.parse({System.Text.Json.JsonSerializer.Serialize(exportJson)});
                                try {{ data.knitlog_pdfs = JSON.parse({System.Text.Json.JsonSerializer.Serialize(pdfJson)}); }} catch(e) {{}}
                                const blob = new Blob([JSON.stringify(data, null, 2)], {{type:'application/json'}});
                                const a = document.createElement('a');
                                a.href = URL.createObjectURL(blob);
                                a.download = 'knitday_backup_' + new Date().toISOString().slice(0,10) + '.json';
                                a.click();
                            }})()");
                        return;
                    }
                }
                catch { }
            }
        }

        // PDF 없을 때 공통
        await JS.InvokeVoidAsync("eval",
            $@"(async () => {{
                const blob = new Blob([JSON.stringify(JSON.parse({System.Text.Json.JsonSerializer.Serialize(exportJson)}), null, 2)], {{type:'application/json'}});
                const a = document.createElement('a');
                a.href = URL.createObjectURL(blob);
                a.download = 'knitday_backup_' + new Date().toISOString().slice(0,10) + '.json';
                a.click();
            }})()");
    }
