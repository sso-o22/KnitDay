    [data-dark="true"] .cw-val { color: #f0f0f0 !important; }
    [data-dark="true"] .cw-inner { color: #f0f0f0 !important; }
    [data-dark="true"] .cw-inner * { color: #f0f0f0 !important; }
    [data-dark="true"] .cw-close { color: #888 !important; }
    [data-dark="true"] .cw-nav-btn { color: #eee !important; }
    [data-dark="true"] .cw-fab { background: rgba(32,32,32,0.92); border-color: rgba(255,255,255,0.12); }
    [data-dark="true"] .cw-fab img { filter: invert(1); opacity: 0.85; }
    [data-dark="true"] .dp-btn img,
