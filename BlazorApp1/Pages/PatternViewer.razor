        display: flex; align-items: center; justify-content: center;
    }
    .draw-fab:active { transform: scale(0.9); }
    .draw-fab-on {
        background: #f0f0f0;
        border-color: rgba(0,0,0,0.25);
    }

    /* ── 필기 패널 ── */
    .draw-panel {
        overflow: hidden;
        max-height: 0;
        transition: max-height 0.25s cubic-bezier(0.4,0,0.2,1);
        margin-top: 4px;
    }
    .draw-panel-open { max-height: 600px; }
    .draw-panel-inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        background: rgba(255,255,255,0.96);
        backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
        border: 1.5px solid rgba(0,0,0,0.1);
        border-radius: 14px;
        padding: 8px 6px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.12);
        width: 44px;
    }
    /* 도구 버튼 행 */
    .dp-row {
        display: flex; flex-direction: column; align-items: center; gap: 2px; width: 100%;
    }
    .dp-btn {
        background: transparent; border: none; color: #333;
        width: 32px; height: 32px; border-radius: 8px;
        cursor: pointer; font-size: 15px;
        display: flex; align-items: center; justify-content: center;
    }
    .dp-btn:hover { background: rgba(0,0,0,0.07); }
    .dp-on { background: rgba(0,0,0,0.1); }
    /* 구분선 */
    .dp-sep { width: 28px; height: 1px; background: rgba(0,0,0,0.08); margin: 2px 0; flex-shrink: 0; }
    /* 세로 슬라이더 컬럼 (미사용, 하위호환 유지) */
    .dp-slider-col {
        display: flex; flex-direction: column; align-items: center; gap: 3px;
    }
    .dp-range-v {
        writing-mode: vertical-lr;
        direction: rtl;
        width: 22px; height: 80px;
        cursor: pointer; accent-color: #555;
    }
    .dp-size-btn {
        background: rgba(0,0,0,0.07); border: none; color: #333;
        width: 24px; height: 24px; border-radius: 6px; cursor: pointer;
        font-size: 14px; display: flex; align-items: center; justify-content: center;
        line-height: 1;
    }
    .dp-size-btn:hover { background: rgba(0,0,0,0.14); }
    .dp-size-btn:active { background: rgba(0,0,0,0.2); }
    .dp-val { font-size: 10px; font-weight: 600; color: #333; text-align: center; }
    .dp-confirm-btn { background: #e8f5e8; color: #2a7a2a; }
    .dp-label { font-size: 8px; color: #999; }
    .dp-div { display: none; } /* 이전 구분선 (미사용) */

    /* ── dp-popover-title / dp-popover-val (팝오버 공용) ── */

    /* ── 카운터 위젯: 라이트 계열 ── */
    .cw-wrap { user-select: none; }
    /* JS 위치 계산 전 기본 위치: 우하단 고정 */
    .cw-default-pos {
        position: fixed !important;
        right: 16px !important;
        bottom: calc(env(safe-area-inset-bottom, 0px) + 80px) !important;
        left: auto !important;
        top: auto !important;
        max-width: calc(100vw - 32px);
    }
    .cw-inner {
        background: rgba(255,255,255,0.95);
