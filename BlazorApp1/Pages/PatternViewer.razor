@if (_showLoadWarning)
{
    <div style="position:fixed;top:0;left:0;right:0;bottom:0;z-index:9999;background:rgba(0,0,0,0.45);display:flex;align-items:center;justify-content:center;padding:20px;">
        <div style="background:var(--white);border-radius:20px;padding:28px 24px;max-width:320px;width:100%;text-align:center;box-shadow:0 8px 32px rgba(0,0,0,0.18);" @onclick:stopPropagation="true">
            <div style="margin-bottom:12px;"><img src="icons/files.svg" style="width:32px;height:32px;" /></div>
            <div style="font-size:1rem;font-weight:600;margin-bottom:8px;color:var(--text-dark);">도안을 교체할까요?</div>
            <div style="font-size:0.85rem;color:var(--text-mid);margin-bottom:20px;">이미 불러온 도안이 있어요.<br/>새 파일로 교체하면 기존 필기가 사라져요.</div>
            <div style="display:flex;gap:10px;justify-content:center;">
                <button class="btn btn-ghost" @onclick="()=>_showLoadWarning=false">취소</button>
                <button class="btn btn-primary" @onclick="ConfirmLoadPattern">교체</button>
            </div>
        </div>
    </div>
}

@if (_showConfirm)
{
    <div style="position:fixed;top:0;left:0;right:0;bottom:0;z-index:9999;background:rgba(0,0,0,0.45);display:flex;align-items:center;justify-content:center;padding:20px;">
        <div class="modal" style="max-width:360px;text-align:center;" @onclick:stopPropagation="true">
            <div style="margin-bottom:12px;display:flex;justify-content:center;"><img src="icons/trash.svg" class="icon-line" style="width:32px;height:32px;flex-shrink:0;" /></div>
            <div style="font-size:1rem;font-weight:600;margin-bottom:8px;color:var(--text-dark);">정말 삭제할까요?</div>
            <div style="font-size:0.88rem;color:var(--text-mid);margin-bottom:20px;">@_confirmMsg</div>
            <div style="display:flex;gap:10px;justify-content:center;">
                <button class="btn btn-ghost" @onclick="()=>_showConfirm=false">취소</button>
                <button class="btn btn-danger" @onclick="ExecuteConfirm">삭제</button>
            </div>
        </div>
    </div>
}

@code {
    bool _showLoadWarning=false;
    bool _showConfirm=false; string _confirmMsg=""; Func<Task>? _confirmAction;
    void Confirm(string msg,Func<Task> action){_confirmMsg=msg;_confirmAction=action;_showConfirm=true;}
    async Task ExecuteConfirm(){_showConfirm=false;if(_confirmAction!=null)await _confirmAction();_confirmAction=null;}

    [Parameter] public Guid ProjectId { get; set; }
    KnitProject? _project;
    string _tool="select";
    // 필기 팝오버 상태
    bool _showSizePopup = false;
    bool _showOpacityPopup = false;
    double _sizePopoverTop = 200;    // 굵기 팝오버 screen top (fixed 기준)
    double _opacityPopoverTop = 250; // 투명도 팝오버 screen top
    double _popoverLeft = 80;        // 팝오버 screen left (draw-wrap 오른쪽)
    // 툴별 독립 설정
    string _penColor      = "#000000"; int _penSize      = 4;  int _penOpacity   = 100;
    string _hlColor       = "#ffeb3b"; int _hlSize       = 8;
    int    _eraserSize    = 10;
    // 현재 툴 기준 활성 설정 (UI 바인딩용)
    string ActiveColor   => _tool == "highlighter" ? _hlColor    : _penColor;
    int    ActiveSize    => _tool == "highlighter" ? _hlSize     : _tool == "eraser" ? _eraserSize : _penSize;
    int    ActiveOpacity => _penOpacity;
    int _currentPage=1, _totalPages=1;
    double _zoom=1.0;
    bool _pdfLoaded=false, _isDrawing=false;
    bool _drawMode=false, _showCounterWidget=true;
    bool _suppressRender = false;
    protected override bool ShouldRender() { if (_suppressRender) { _suppressRender = false; return false; } return true; }
    int _activeCounterIndex=0;
    ProjectCounter ActiveCounter => _project!.Counters[Math.Min(_activeCounterIndex, _project.Counters.Count - 1)];
    DotNetObjectReference<PatternViewer>? _dotNetRef;

    // ── 카운터 위젯 드래그 ──
    double _cwX=-1, _cwY=-1; // -1 = JS 계산 전, CSS로 우하단 고정
    bool _cwDragging=false;
    double _cwOffX=0, _cwOffY=0;

    void CwDragStart(MouseEventArgs e)
    {
        _cwDragging=true;
        _cwOffX=e.ClientX-_cwX;
        _cwOffY=e.ClientY-_cwY;
    }
    void CwTouchStart(TouchEventArgs e)
    {
        if(e.Touches.Length==0)return;
        _cwDragging=true;
        _cwOffX=e.Touches[0].ClientX-_cwX;
        _cwOffY=e.Touches[0].ClientY-_cwY;
    }

    // ── 타이머 ──
    KnitSession? _activeSession => _project?.Sessions.FirstOrDefault(s=>s.IsActive);
    string _timerDisplay="00:00:00";
    PeriodicTimer? _refreshTimer;
    void StartRefreshTimer(){StopRefreshTimer();_refreshTimer=new PeriodicTimer(TimeSpan.FromSeconds(1));_=RefreshUIAsync();}
    void StopRefreshTimer(){_refreshTimer?.Dispose();_refreshTimer=null;}
    async Task RefreshUIAsync(){try{while(_refreshTimer is not null&&await _refreshTimer.WaitForNextTickAsync()){UpdateTimerDisplay();await InvokeAsync(StateHasChanged);}}catch(OperationCanceledException){}}
    void UpdateTimerDisplay(){if(_project==null){_timerDisplay="00:00:00";return;}var a=_project.Sessions.FirstOrDefault(s=>s.IsActive);if(a==null){_timerDisplay="00:00:00";return;}var t=(int)(DateTime.Now-a.StartTime).TotalSeconds;_timerDisplay=$"{t/3600:D2}:{(t%3600)/60:D2}:{t%60:D2}";}
    async Task StartSession(){if(_project==null)return;var ex=_project.Sessions.FirstOrDefault(s=>s.IsActive);if(ex!=null)ex.EndTime=DateTime.Now;_project.Sessions.Add(new KnitSession{StartTime=DateTime.Now});await Storage.SaveProjectAsync(_project);StartRefreshTimer();await JS.InvokeVoidAsync("acquireWakeLock");StateHasChanged();}
    async Task EndSession(){if(_project==null)return;var a=_project.Sessions.FirstOrDefault(s=>s.IsActive);if(a==null)return;a.EndTime=DateTime.Now;_saving=true;StateHasChanged();await Storage.SaveProjectAsync(_project);_saving=false;StopRefreshTimer();_timerDisplay="00:00:00";StateHasChanged();}

    // ── 카운터 ──
    void PrevCounter(){if(_project==null||_project.Counters.Count==0)return;_activeCounterIndex=(_activeCounterIndex-1+_project.Counters.Count)%_project.Counters.Count;}
    void NextCounter(){if(_project==null||_project.Counters.Count==0)return;_activeCounterIndex=(_activeCounterIndex+1)%_project.Counters.Count;}

    // 마지막 클릭 시간: 오늘→시분초, 올해 다른날→월.일 시분, 작년이전→년.월.일 시분
    string FormatLastUpdated(DateTime dt)
    {
        if (dt.Date == DateTime.Today) return dt.ToString("HH:mm:ss");
        if (dt.Year == DateTime.Today.Year) return dt.ToString("M.dd HH:mm");
        return dt.ToString("yyyy.M.dd HH:mm");
    }
    string _cwNewLabel = "";
    bool _cwAddMode = false;

    async Task CwAddCounter()
    {
        if (_project == null || string.IsNullOrWhiteSpace(_cwNewLabel)) return;
        _project.Counters.Add(new ProjectCounter { Label = _cwNewLabel.Trim() });
        _activeCounterIndex = _project.Counters.Count - 1;
        _cwNewLabel = "";
        _cwAddMode = false;
        await SaveProject();
        StateHasChanged();
    }

    async Task CwAddKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await CwAddCounter();
        else if (e.Key == "Escape") { _cwAddMode = false; _cwNewLabel = ""; }
    }

    async Task IncrementCounter(ProjectCounter c)
    {
        c.Value += c.Step;
        c.LastUpdatedAt = DateTime.Now;
        await SaveProject();
        // 목표 달성 시 다음 미완료 카운터로 자동 이동
        if (_project != null && c.Target > 0 && c.Value >= c.Target)
        {
            var next = _project.Counters
                .Select((x, i) => (x, i))
                .FirstOrDefault(t => !(t.x.Target > 0 && t.x.Value >= t.x.Target));
            if (next.x != null)
                _activeCounterIndex = next.i;
        }
        StateHasChanged();
    }
    async Task DecrementCounter(ProjectCounter c){c.Value=Math.Max(0,c.Value-c.Step);c.LastUpdatedAt=DateTime.Now;await SaveProject();StateHasChanged();}
    bool _saving = false;
    async Task SaveProject(){if(_project is KnitProject p){_saving=true;StateHasChanged();await Storage.SaveProjectAsync(p);_saving=false;await JS.InvokeVoidAsync("showToast","저장됐어요");}}

    // 필기+줌+페이지 자동 저장 (디바운스)
    System.Threading.CancellationTokenSource? _saveCts;
    async Task SaveViewerStateAsync()
    {
        if (_project == null || !_pdfLoaded || _isRestoring) return;
        // 디바운스: 2초 내 연속 호출은 마지막 것만 실행
        _saveCts?.Cancel();
        _saveCts = new System.Threading.CancellationTokenSource();
        var token = _saveCts.Token;
        try
        {
            await Task.Delay(2000, token);
            if (token.IsCancellationRequested) return;

            // 필기 paths를 JS에서 가져와서 저장
            var pathsJson = await JS.InvokeAsync<string>("patternViewer.getPaths");
            _project.ViewerAnnotations = pathsJson;

            // 행 마커 저장
            _project.ViewerRowMarkers = System.Text.Json.JsonSerializer.Serialize(_rowMarkers);

            // 줌/페이지 저장
            _project.ViewerLastZoom = _zoom;
            _project.ViewerLastPage = _currentPage;

            // 필기 설정 저장 — rowheightdraw(행 높이 지정 중)도 그대로 저장해 재진입 시 기억되게 함
            _project.ViewerLastTool       = _tool;
            _project.ViewerPenColor       = _penColor;
            _project.ViewerPenSize        = _penSize;
            _project.ViewerPenOpacity     = _penOpacity;
            _project.ViewerHlColor        = _hlColor;
            _project.ViewerHlSize         = _hlSize;
            _project.ViewerEraserSize     = _eraserSize;
            _project.ViewerRowMarkerColor = _rowMarkerColor;
            _project.ViewerMarkerMode     = "single";

            await SaveProject();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", "SaveViewerState error: " + ex.Message);
        }
    }

    // ── 초기화 ──
    protected override async Task OnInitializedAsync()
    {
        _project=(await Storage.GetProjectsAsync()).FirstOrDefault(p=>p.Id==ProjectId);
        if(_project?.Sessions.Any(s=>s.IsActive)==true)StartRefreshTimer();
        // 완료된 카운터(Target > 0 && Value >= Target)를 건너뛰고 첫 미완료 카운터부터 표시
        if (_project?.Counters.Any() == true)
        {
            var firstActive = _project.Counters
                .Select((c, i) => (c, i))
                .FirstOrDefault(x => !(x.c.Target > 0 && x.c.Value >= x.c.Target));
            _activeCounterIndex = firstActive.c != null ? firstActive.i : 0;
        }
    }

    // OnAfterRenderAsync 첫 렌더 후 저장된 데이터 복원
    bool _restoredOnce = false;
    bool _isRestoring = false;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender)
        {
            var vw = await JS.InvokeAsync<double>("eval", "window.innerWidth");
            var vh = await JS.InvokeAsync<double>("eval", "window.innerHeight");
            _cwX = Math.Max(16, vw - 280);
            _cwY = Math.Max(80, vh - 250);
            _dotNetRef=DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("patternViewer.init",_dotNetRef);
            await JS.InvokeVoidAsync("patternViewer.setTool", _penColor, _penSize, false, "select", _penOpacity);
            StateHasChanged();
        }

        // 모든 이동 가능한(IsCurrent) 마커에 각각 JS 드래그 부착 (드래그 중에는 재호출 스킵 — 타이머 재렌더와 충돌 방지)
        // 행 마커 드래그는 툴바가 펼쳐져 있고 행마커 도구가 선택된 상태에서만 부착
        // (그렇지 않으면 도안만 보던 중에도 모르고 마커가 움직여버림)
        if (_dotNetRef != null && !_isDraggingMarker && _drawMode && _tool == "rowmarker")
        {
            foreach (var m in _rowMarkers.Where(m => m.IsCurrent))
            {
                var markerId = $"rowmarker-{m.Id:N}";
                await JS.InvokeVoidAsync("patternViewer.attachMarkerDrag",
                    markerId, m.Page, _zoom, _dotNetRef);
            }
        }

        // 첫 렌더 후 저장 데이터 복원 (한 번만)
        if (!_restoredOnce && _project != null)
        {
            _restoredOnce = true;
            await RestoreSavedPatternAsync();
        }
    }

    async Task RestoreSavedPatternAsync()
    {
        if (_project == null || !_project.HasSavedPattern) return;
        _isRestoring = true;
        try
        {
            var savedFileName = await JS.InvokeAsync<string?>("patternViewer.loadPdfFromProject", ProjectId.ToString());
            if (string.IsNullOrEmpty(savedFileName))
            {
                // IndexedDB에 없으면 Cloudinary URL에서 다운로드해서 복원
                if (!string.IsNullOrEmpty(_project.PatternCloudUrl))
                {
                    try
                    {
                        var pdfBytes = await Http.GetByteArrayAsync(_project.PatternCloudUrl);
                        using var streamRef = new DotNetStreamReference(new System.IO.MemoryStream(pdfBytes), leaveOpen: false);
                        var pages2 = await JS.InvokeAsync<int>("patternViewer.loadPdfBytes", streamRef);
                        if (pages2 > 0)
                        {
                            // IndexedDB에도 저장
                            await JS.InvokeAsync<bool>("patternViewer.savePdfToProject", ProjectId.ToString(), _project.PatternFileName);
                            _totalPages = pages2;
                            _pdfLoaded = true;
                            _currentPage = _project.ViewerLastPage > 0 ? _project.ViewerLastPage : 1;
                            StateHasChanged();
                            await Task.Delay(100);
                            await JS.InvokeVoidAsync("patternViewer.renderPdf");
                            await Task.Delay(500);
                            if (!string.IsNullOrEmpty(_project.ViewerAnnotations))
                                await JS.InvokeVoidAsync("patternViewer.setPaths", _project.ViewerAnnotations);

                            // Cloudinary 재다운로드 경로에서도 행 마커/툴 설정 복원 누락되지 않도록 동일하게 적용
                            await RestoreRowMarkersAndToolSettingsAsync();
                        }
                    }
                    catch { }
                }
                return;
            }

            var pages = await JS.InvokeAsync<int>("patternViewer.renderSavedPdf", ProjectId.ToString());
            if (pages <= 0) return;

            _totalPages = pages;
            _pdfLoaded = true;
            _currentPage = _project.ViewerLastPage > 0 ? _project.ViewerLastPage : 1;
            StateHasChanged();
            await Task.Delay(100);

            await JS.InvokeVoidAsync("patternViewer.renderPdf");
            await Task.Delay(500); // renderPdf 내부 ZoomToFromJS 콜백 완료 대기


            // 필기 복원은 렌더 완전히 끝난 후
            if (!string.IsNullOrEmpty(_project.ViewerAnnotations))
                await JS.InvokeVoidAsync("patternViewer.setPaths", _project.ViewerAnnotations);

            await RestoreRowMarkersAndToolSettingsAsync();

            if (_currentPage > 1)
            {
                await Task.Delay(150); // 렌더 완료 대기
                await JS.InvokeVoidAsync("patternViewer.scrollToPage", _currentPage);
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", "RestoreSavedPattern error: " + ex.Message);
        }
        finally
        {
            _saveCts?.Cancel();
            _saveCts = null;
            _isRestoring = false;
            // PDF 로드 완료 후 WakeLock 획득 (도안뷰어 열려있는 동안 앱 Kill 방지)
            if (_pdfLoaded)
                try { await JS.InvokeVoidAsync("acquireWakeLock"); } catch { }
        }
    }

    // 행 마커 + 필기 도구 설정 복원 — IndexedDB 정상 로드 / Cloudinary 재다운로드 두 경로 모두에서 공통 사용
    async Task RestoreRowMarkersAndToolSettingsAsync()
    {
        if (_project == null) return;

        if (!string.IsNullOrEmpty(_project.ViewerRowMarkers))
        {
            try
            {
                var markers = System.Text.Json.JsonSerializer.Deserialize<List<RowMarker>>(
                    _project.ViewerRowMarkers,
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (markers != null)
                {
                    _rowMarkers = markers;
                    var last = _rowMarkers.LastOrDefault();
                    if (last != null)
                    {
                        _detectedRowH = last.RowHeight;
                        _pageWidth    = last.PageWidth;
                        _rowMarkerColor = last.Color;
                    }
                }
            }
            catch { }
        }
        // 복원 시점 이후의 동작만 되돌리기 히스토리에 쌓이므로, 새로고침 전 흔적은 항상 보존됨
        // — 필기/형광펜의 basePaths와 동일한 원리
        _rowMarkersBaseCount = _rowMarkers.Count;
        _rowMarkerHistory.Clear();

        StateHasChanged();

        // 필기 설정 복원 — _tool은 기억해두되 툴바는 닫힌 상태이므로 JS엔 select로 설정
        _penColor       = !string.IsNullOrEmpty(_project.ViewerPenColor)   ? _project.ViewerPenColor  : "#000000";
        _penSize        = _project.ViewerPenSize    > 0 ? _project.ViewerPenSize    : 4;
        _penOpacity     = _project.ViewerPenOpacity > 0 ? _project.ViewerPenOpacity : 100;
        _hlColor        = !string.IsNullOrEmpty(_project.ViewerHlColor)    ? _project.ViewerHlColor   : "#ffeb3b";
        _hlSize         = _project.ViewerHlSize     > 0 ? _project.ViewerHlSize     : 8;
        _eraserSize     = _project.ViewerEraserSize > 0 ? _project.ViewerEraserSize : 10;
        _rowMarkerColor = !string.IsNullOrEmpty(_project.ViewerRowMarkerColor) ? _project.ViewerRowMarkerColor : "#ffeb3b";
        // 다중행 기능 제거 → 항상 단일행
        _markerMode = "single";
        var savedTool = _project.ViewerLastTool;
        // rowheightdraw(높이 조절 중)는 선택한 마커를 대상으로 하는 임시 상태라 재진입 시 의미가 없음
        // — 새로고침 후엔 선택이 사라지므로 rowmarker로 대체 (행 마커 도구 자체는 그대로 기억)
        _tool = savedTool is "pen" or "highlighter" or "eraser" or "rowmarker" ? savedTool
              : savedTool == "rowheightdraw" ? "rowmarker"
              : "pen";
        _drawMode = false; // 뷰어 열 때는 항상 툴바 접힌 상태
        await JS.InvokeVoidAsync("patternViewer.setTool", _penColor, _penSize, false, "select", _penOpacity);
        StateHasChanged();
    }


    // ── PDF ──
    async Task UndoLastPath()=>await JS.InvokeVoidAsync("patternViewer.undo");
    // 도안 불러오기 버튼 클릭 → 이미 있으면 경고, 없으면 바로 파일 선택
    async Task OnLoadPatternClick()
    {
        if (_pdfLoaded)
        {
            _showLoadWarning = true;
            StateHasChanged();
        }
        else
        {
            await JS.InvokeVoidAsync("patternViewer.triggerFileInput");
        }
    }

    async Task ConfirmLoadPattern()
    {
        _showLoadWarning = false;
        // 기존 필기/도형/줌/페이지 초기화
        
        _rowMarkers.Clear();
        _detectedRowH = 0;
        _zoom = 1.0;
        _currentPage = 1;
        _pdfLoaded = false;
        _totalPages = 0;
        if (_project != null)
        {
            _project.ViewerAnnotations = "";
            _project.ViewerRowMarkers = "";
            _project.ViewerLastZoom = 0;
            _project.ViewerLastPage = 1;
            _project.HasSavedPattern = false;
            _project.PatternFileName = "";
            // 기존 PDF IDB에서 삭제
            try { await JS.InvokeAsync<bool>("patternViewer.deleteSavedPdf", ProjectId.ToString()); } catch { }
            // 클라우드 PDF 삭제
            if (!string.IsNullOrEmpty(_project.PatternCloudUrl))
            {
                _ = Storage.DeletePdfAsync(ProjectId.ToString());
                await Storage.SubtractCloudUsageAsync("pdf", 0);
                _project.PatternCloudUrl = "";
            }
            await SaveProject();
        }
        await JS.InvokeVoidAsync("patternViewer.clearAnnotations");
        await JS.InvokeVoidAsync("patternViewer.triggerFileInput");
    }

    async Task OnPdfSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var contentType = e.File.ContentType;
            var isImage = contentType.StartsWith("image/");

            using var stream = e.File.OpenReadStream(100 * 1024 * 1024);
            using var ms = new System.IO.MemoryStream();
            await stream.CopyToAsync(ms);
            var bytes = ms.ToArray();

            // ── 이미지 파일 처리 ──
            if (isImage)
            {
                // 도안 초기화
                
                _rowMarkers.Clear();
                _detectedRowH = 0;
                _zoom = 1.0;
                _currentPage = 1;

                var b64 = Convert.ToBase64String(bytes);
                _imageDataUrl = $"data:{contentType};base64,{b64}";
                _isImageMode = true;
                _totalPages = 1;
                _pdfLoaded = true;
                StateHasChanged();
                await Task.Delay(100);

                // 이미지 크기 가져오기
                var size = await JS.InvokeAsync<double[]>("patternViewer.getImageSize", "pdf-canvas-1");
                if (size != null && size.Length == 2)
                {
                    _imageOrigW = size[0];
                    _imageOrigH = size[1];
                    _pageWidth  = _imageOrigW;
                }

                // anno-canvas 크기 맞추기
                await JS.InvokeVoidAsync("patternViewer.resizeAnnoCanvas", 1, _imageOrigW * _zoom, _imageOrigH * _zoom);

                if (_project != null)
                {
                    _project.HasSavedPattern = true;
                    _project.PatternFileName = e.File.Name;
                    await SaveProject();
                }
                return;
            }

            // ── PDF 파일 처리 ──
            _isImageMode = false;

            // JS에 byte[] 직접 전달 (Base64 변환 없이 → 메모리 절약)
            using var streamRef = new DotNetStreamReference(new System.IO.MemoryStream(bytes), leaveOpen: false);
            var pages = await JS.InvokeAsync<int>("patternViewer.loadPdfBytes", streamRef);
            if (pages <= 0) return;

            // Blazor DOM에 캔버스 생성
            _totalPages = pages;
            _pdfLoaded = true;
            _currentPage = 1;
            // 파일명 먼저 업데이트 → 상단바 즉시 반영
            if (_project != null)
            {
                _project.PatternFileName = e.File.Name;
                _project.HasSavedPattern = true;
            }
            StateHasChanged();
            await Task.Delay(100);

            // JS 렌더링
            await JS.InvokeVoidAsync("patternViewer.renderPdf");

            // IndexedDB에 저장
            if (_project != null)
            {
                var saved = await JS.InvokeAsync<bool>("patternViewer.savePdfToProject",
                    ProjectId.ToString(), e.File.Name);
                if (saved)
                {
                    _project.HasSavedPattern = true;
                    _project.PatternFileName = e.File.Name;

                    // 로그인 상태일 때만 Cloudinary 업로드
                    if (Storage.IsLoggedIn)
                    {
                        try
                        {
                            var base64Pdf = Convert.ToBase64String(bytes);
                            var (cloudUrl, cloudErr) = await Storage.UploadPdfAsync(ProjectId.ToString(), base64Pdf);
                            if (cloudErr == "quota")
                                await JS.InvokeVoidAsync("showToast", "저장공간 500MB 한도를 초과했어요. 도안이 이 기기에만 저장됩니다.", "error");
                            else if (!string.IsNullOrEmpty(cloudUrl))
                            {
                                _project.PatternCloudUrl = cloudUrl;
                                await JS.InvokeVoidAsync("showToast", $"클라우드 업로드 완료", "info");
                            }
                            else
                                await JS.InvokeVoidAsync("showToast", $"클라우드 업로드 실패: {cloudErr ?? "url없음"}", "error");
                        }
                        catch (Exception uploadEx)
                        {
                            await JS.InvokeVoidAsync("showToast", $"업로드 오류: {uploadEx.Message}", "error");
                        }
                    }

                    await SaveProject();
                }
            }
        }
        catch (Exception ex)
        {
            _pdfLoaded = false;
            _totalPages = 0;
            StateHasChanged();
            await JS.InvokeVoidAsync("console.error", "PDF load error: " + ex.Message);
        }
        // PDF 로드 성공 시 WakeLock 획득
        if (_pdfLoaded)
            try { await JS.InvokeVoidAsync("acquireWakeLock"); } catch { }
    }
    async Task ZoomIn()
    {
        _zoom = Math.Round(_zoom + 0.1, 1);
        if (_isImageMode) { await JS.InvokeVoidAsync("patternViewer.resizeAnnoCanvas", 1, _imageOrigW * _zoom, _imageOrigH * _zoom); StateHasChanged(); }
        else await RenderAllPages();
    }
    async Task ZoomOut()
    {
        _zoom = Math.Max(0.1, Math.Round(_zoom - 0.1, 1));
        if (_isImageMode) { await JS.InvokeVoidAsync("patternViewer.resizeAnnoCanvas", 1, _imageOrigW * _zoom, _imageOrigH * _zoom); StateHasChanged(); }
        else await RenderAllPages();
    }
    async Task RenderAllPages(){await JS.InvokeVoidAsync("patternViewer.renderAllPages",_zoom);StateHasChanged();}
    [JSInvokable] public void UpdatePageFromJS(int page)
    {
        _currentPage = page;
        StateHasChanged();
        _ = SaveViewerStateAsync();
    }
    [JSInvokable] public void NotifyAnnotationChanged()
    {
        _ = SaveViewerStateAsync();
    }

    [JSInvokable] public void ZoomToFromJS(double zoom)
    {
        _zoom = zoom;
        StateHasChanged();
        _ = SaveViewerStateAsync(); // 줌 변경 시 자동 저장 (fire-and-forget)
    }

    // ── 필기 ──
    async Task ToggleDrawMode()
    {
        _drawMode = !_drawMode;
        _suppressRender = true;
        await JS.InvokeVoidAsync("patternViewer.setDrawPanelOpen", _drawMode);
        if (_drawMode)
        {
            if (_tool == "rowheightdraw" && _selectedMarkerId != null && _rowMarkers.Any(m => m.Id == _selectedMarkerId))
                StartRowHeightDraw(); // 두 선 위치/드래그 핸들 재초기화 필요
            else if (_tool == "rowheightdraw")
                SetTool("rowmarker"); // 선택돼 있던 마커가 사라졌으면 안전하게 행 마커 도구로 복귀
            else
                SetTool(_tool is "pen" or "highlighter" or "eraser" or "rowmarker" ? _tool : "pen");
        }
        else
        {
            // 닫을 때는 _tool은 기억해두고 JS만 select로, 팝오버도 닫기
            _showSizePopup = false;
            _showOpacityPopup = false;
            _ = JS.InvokeVoidAsync("patternViewer.setTool", _penColor, _penSize, false, "select", _penOpacity);
        }
        _suppressRender = false;
    }
    void SetTool(string t)
    {
        bool toolChanged = _tool != t;
        _tool = t;
        // 툴이 바뀔 때만 팝오버 닫기 (같은 툴 재적용 시 유지)
        if (toolChanged)
        {
            _showSizePopup = false;
            _showOpacityPopup = false;
        }
        var (color, size, isEraser, opacity) = t switch {
            "highlighter" => (_hlColor,    _hlSize,    false, _penOpacity),
            "eraser"      => (_penColor,   _eraserSize,true,  _penOpacity),
            _             => (_penColor,   _penSize,   false, _penOpacity)
        };
        _ = JS.InvokeVoidAsync("patternViewer.setTool", color, size, isEraser, t, opacity);
        _ = SaveViewerStateAsync();
        StateHasChanged();
    }

    void ApplyCurrentTool() => SetTool(_tool); // 같은 툴 재적용 → 팝오버 닫히지 않음

    // ── 팝오버 열기: 버튼 위치 읽어서 fixed 좌표 계산 ─────────────────
    DateTime _sizePopupLastOpened = DateTime.MinValue;
    DateTime _opacityPopupLastOpened = DateTime.MinValue;

    async Task OpenSizePopup()
    {
        // 열린 지 300ms 이내 재호출은 내부 클릭 버블링으로 간주, 무시
        if (_showSizePopup && (DateTime.Now - _sizePopupLastOpened).TotalMilliseconds < 300) return;
        if (_showSizePopup) { _showSizePopup = false; StateHasChanged(); return; }
        _showOpacityPopup = false;
        try
        {
            var rect = await JS.InvokeAsync<double[]>("patternViewer.getBtnRect", "dp-size-btn");
            // rect: [top, right, bottom, left, width, height]
            _sizePopoverTop = rect[2] + 4;  // 버튼 bottom + 4px (버튼 바로 아래)
            _popoverLeft    = rect[3];      // 버튼 left (왼쪽 정렬)
        }
        catch { /* JS 실패 시 기본값 사용 */ }
        _sizePopupLastOpened = DateTime.Now;
        _showSizePopup = true;
        StateHasChanged();
    }

    async Task OpenOpacityPopup()
    {
        // 열린 지 300ms 이내 재호출은 내부 클릭 버블링으로 간주, 무시
        if (_showOpacityPopup && (DateTime.Now - _opacityPopupLastOpened).TotalMilliseconds < 300) return;
        if (_showOpacityPopup) { _showOpacityPopup = false; StateHasChanged(); return; }
        _showSizePopup = false;
        try
        {
            var rect = await JS.InvokeAsync<double[]>("patternViewer.getBtnRect", "dp-opacity-btn");
            _opacityPopoverTop = rect[2] + 4;
            _popoverLeft       = rect[3];
        }
        catch { /* JS 실패 시 기본값 사용 */ }
        _opacityPopupLastOpened = DateTime.Now;
        _showOpacityPopup = true;
        StateHasChanged();
    }

    async Task OnColorChange(ChangeEventArgs e)
    {
        var v = e.Value?.ToString() ?? "";
        if (_tool == "highlighter") _hlColor  = v;
        else                        _penColor = v;
        ApplyCurrentTool();
    }
    async Task OnSizeChange(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var v)) return;
        if (_tool == "highlighter") _hlSize     = v;
        else if (_tool == "eraser") _eraserSize = v;
        else                        _penSize    = v;
        _showSizePopup = true; // 슬라이더 조작 중 팝오버 유지
        ApplyCurrentTool();
    }
    async Task SizeDown()
    {
        if (_tool == "highlighter") _hlSize     = Math.Max(1, _hlSize     - 1);
        else if (_tool == "eraser") _eraserSize = Math.Max(1, _eraserSize - 1);
        else                        _penSize    = Math.Max(1, _penSize    - 1);
        _showSizePopup = true; // 버튼 클릭 후 팝오버 유지
        ApplyCurrentTool();
        StateHasChanged();
    }
    async Task SizeUp()
    {
        if (_tool == "highlighter") _hlSize     = Math.Min(40, _hlSize     + 1);
        else if (_tool == "eraser") _eraserSize = Math.Min(40, _eraserSize + 1);
        else                        _penSize    = Math.Min(40, _penSize    + 1);
        _showSizePopup = true; // 버튼 클릭 후 팝오버 유지
        ApplyCurrentTool();
        StateHasChanged();
    }
    async Task OnOpacityChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var v)) _penOpacity = v;
        _showOpacityPopup = true;
        ApplyCurrentTool();
    }
    async Task OpacityDown()
    {
        _penOpacity = Math.Max(5, _penOpacity - 5);
        _showOpacityPopup = true;
        ApplyCurrentTool();
        StateHasChanged();
    }
    async Task OpacityUp()
    {
        _penOpacity = Math.Min(100, _penOpacity + 5);
        _showOpacityPopup = true;
        ApplyCurrentTool();
        StateHasChanged();
    }

    async Task OnGlobalMouseMove(MouseEventArgs e)
    {
        if(_cwDragging){_cwX=e.ClientX-_cwOffX;_cwY=e.ClientY-_cwOffY;StateHasChanged();}
    }
    async Task OnGlobalMouseUp(MouseEventArgs e)
    {
        _cwDragging=false;
        if(_isDrawing&&_pdfLoaded&&(_tool=="pen"||_tool=="eraser"||_tool=="highlighter"))await JS.InvokeVoidAsync("patternViewer.endDraw");
        _isDrawing=false;
        StateHasChanged();
    }

    async Task OnGlobalTouchMove(TouchEventArgs e)
    {
        if(_cwDragging&&e.Touches.Length>0){_cwX=e.Touches[0].ClientX-_cwOffX;_cwY=e.Touches[0].ClientY-_cwOffY;StateHasChanged();}
    }
    Task OnGlobalTouchEnd(TouchEventArgs e){_cwDragging=false;StateHasChanged();return Task.CompletedTask;}

    string HexToRgb(string hex){hex=hex.TrimStart('#');return $"{Convert.ToInt32(hex[..2],16)},{Convert.ToInt32(hex[2..4],16)},{Convert.ToInt32(hex[4..6],16)}";}
    string RgbToHex(string rgb){var p=rgb.Split(',');return $"#{int.Parse(p[0]):X2}{int.Parse(p[1]):X2}{int.Parse(p[2]):X2}";}
    string DarkenRgb(string hex)
    {
        hex = hex.TrimStart('#');
        int r = Math.Max(0, Convert.ToInt32(hex[..2], 16) - 60);
        int g = Math.Max(0, Convert.ToInt32(hex[2..4], 16) - 60);
        int b = Math.Max(0, Convert.ToInt32(hex[4..6], 16) - 60);
        return $"{r},{g},{b}";
    }
    string GetCursor()=>_tool switch{"select"=>"default","pen"=>"crosshair","eraser"=>"cell","highlighter"=>"crosshair","rowmarker"=>"pointer","rowheightdraw"=>"ns-resize",_=>"crosshair"};

    // ── 이미지 모드 ──────────────────────────────────────────────────
    bool _isImageMode = false;
    string _imageDataUrl = "";
    double _imageOrigW = 0;
    double _imageOrigH = 0;
    List<RowMarker> _rowMarkers = new();
    int _rowMarkersBaseCount = 0; // 복원 시점 마커 개수 — 되돌리기는 이 경계를 넘지 못함
    Guid? _selectedMarkerId = null; // 클릭으로 선택한 마커 (삭제/색상/높이조절 대상)
    string _rowMarkerColor = "#ffeb3b";
    double _detectedRowH = 0;
    string _markerMode = "single"; // 다중행 기능 제거됨 — 항상 단일행
    const double DefaultRowHeight = 5; // 마커가 하나도 없을 때 "마커 추가"에 사용할 기본 높이(zoom=1 기준 px)

    // 되돌리기 히스토리: "added"(마커 추가) → 되돌리면 그 마커 삭제, "markedDone"(흔적 남기기) → 되돌리면 다시 이동 가능 상태로 복원
    // GroupId가 같은 항목들은 한 번의 사용자 동작(예: 흔적 남기기 = 굳히기+새 마커 추가)이므로 되돌리기 한 번에 함께 처리됨
    // 복원 시점 이전 동작은 히스토리에 쌓이지 않으므로 자연히 그 경계를 넘지 못함
    List<(string Kind, Guid MarkerId, int GroupId)> _rowMarkerHistory = new();
    int _rowMarkerHistoryGroupSeq = 0;

    // ── 수동 행 높이: 두 선 드래그 ───────────────────────────────────
    int    _rowDrawPage  = 0;
    double _rowLineAY    = 100; // CSS px, canvas 기준 (zoom 반영)
    double _rowLineBY    = 160; // CSS px, canvas 기준 (zoom 반영)

    void StartRowHeightDraw()
    {
        // 높이 조절은 선택한 마커를 대상으로 동작 — 선택이 없으면 안내만 하고 진입하지 않음
        if (_selectedMarkerId == null)
        {
            _ = JS.InvokeVoidAsync("showToast", "높이를 조절할 마커를 먼저 선택하세요.", "error");
            return;
        }
        var marker = _rowMarkers.FirstOrDefault(m => m.Id == _selectedMarkerId);
        if (marker == null) return;

        _tool        = "rowheightdraw";
        _rowDrawPage = marker.Page;
        // 선택한 마커의 현재 위치(상단/하단)를 두 선의 시작 위치로 사용
        _rowLineAY = marker.Y * _zoom;
        _rowLineBY = (marker.Y + marker.RowHeight) * _zoom;
        _ = JS.InvokeVoidAsync("patternViewer.initRowLines", _rowDrawPage,
                               DotNetObjectReference.Create(this));
        StateHasChanged();
    }

    [JSInvokable]
    public void SetRowLineAY(double y) { _rowLineAY = y; StateHasChanged(); }
    [JSInvokable]
    public void SetRowLineBY(double y) { _rowLineBY = y; StateHasChanged(); }

    // ── 행 마커 드래그 (JS 완전 위임) ─────────────────────────────
    bool _isDraggingMarker = false; // 드래그 중에는 attachMarkerDrag 재호출 스킵 (타이머 재렌더와 충돌 방지)
    Guid? _draggingMarkerId = null; // 현재 드래그 중인 마커의 Id — 여러 마커가 동시에 존재할 수 있어 정확히 식별 필요

    // DOM id("rowmarker-{guid:N}")에서 마커 Id를 역으로 파싱
    static Guid? ParseMarkerDomId(string? domId)
    {
        if (string.IsNullOrEmpty(domId)) return null;
        const string prefix = "rowmarker-";
        if (!domId.StartsWith(prefix)) return null;
        return Guid.TryParse(domId.Substring(prefix.Length), out var g) ? g : null;
    }

    [JSInvokable]
    public Task StartMarkerDrag(string markerDomId)
    {
        _isDraggingMarker = true;
        _draggingMarkerId = ParseMarkerDomId(markerDomId);
        return Task.CompletedTask;
    }

    [JSInvokable]
    public async Task EndMarkerDrag(string markerDomId, double finalCssY, double zoom, bool moved = true)
    {
        _isDraggingMarker = false;
        var targetId = ParseMarkerDomId(markerDomId) ?? _draggingMarkerId;
        _draggingMarkerId = null;
        if (!moved)
        {
            // 실제 이동 없이 클릭만 한 경우 — 위치/저장 변경 없이 드래그 상태만 해제
            StateHasChanged();
            return;
        }
        var marker = targetId != null ? _rowMarkers.FirstOrDefault(m => m.Id == targetId) : null;
        if (marker != null)
        {
            var y = finalCssY / zoom;
            // 페이지 경계를 넘어가면 마커가 화면 밖으로 사라지므로 0~페이지높이 범위로 고정
            try
            {
                var pageHCss = await JS.InvokeAsync<double>("patternViewer.getPageHeight", marker.Page);
                var maxY = Math.Max(0, pageHCss / zoom - marker.RowHeight);
                y = Math.Clamp(y, 0, maxY);
            }
            catch { y = Math.Max(0, y); }
            marker.Y = y;
        }
        await SaveRowMarkersAsync();
        await InvokeAsync(StateHasChanged);
    }

    // ── 적용 버튼 ─────────────────────────────────────────────────
    // ✓ 적용: 두 선 높이 확정 → 선택했던 마커의 위치/높이를 갱신 (새 마커를 만들지 않음)
    async Task ConfirmHeightAndApply()
    {
        var rowHCss = Math.Abs(_rowLineAY - _rowLineBY);
        if (rowHCss < 4) return;

        var marker = _rowMarkers.FirstOrDefault(m => m.Id == _selectedMarkerId);
        if (marker == null) { _tool = "rowmarker"; StateHasChanged(); return; }

        _detectedRowH = rowHCss / _zoom; // zoom=1 기준 저장 — 이후 "마커 추가" 시 기본 높이로 참조
        var topCssY   = Math.Min(_rowLineAY, _rowLineBY);
        var startY    = topCssY / _zoom;

        if (_pageWidth <= 0)
            _pageWidth = await JS.InvokeAsync<double>("patternViewer.getPageWidth", _rowDrawPage);

        marker.Y = startY;
        marker.RowHeight = _detectedRowH;
        marker.PageWidth = _pageWidth;

        _tool = "rowmarker";
        _ = SaveRowMarkersAsync();

        StateHasChanged();
    }

    Task OnAnnoCanvasClick(MouseEventArgs e, int pageNum)
    {
        // 캔버스 클릭으로는 마커가 생성/이동되지 않음 (마커 추가 버튼 또는 드래그로만 동작)
        return Task.CompletedTask;
    }

    // 선택한 마커가 전체 마커 중 몇 번째(추가된 순서)인지 반환 — 1부터 시작, 없으면 null
    // 선택한 마커가 "행마커"(이동 가능한 슬라이더) 중 몇 번째인지 반환 — 흔적으로 굳힌 행은 행마커로 치지 않으므로 제외
    // 1부터 시작, 선택된 게 없거나 흔적 마커를 선택한 경우엔 null
    int? GetSelectedMarkerIndex()
    {
        if (_selectedMarkerId == null) return null;
        var selected = _rowMarkers.FirstOrDefault(m => m.Id == _selectedMarkerId);
        if (selected == null || !selected.IsCurrent) return null;
        var idx = _rowMarkers.Where(m => m.IsCurrent).ToList().FindIndex(m => m.Id == _selectedMarkerId);
        return idx >= 0 ? idx + 1 : null;
    }

    // 색상 피커에 표시할 값: 마커가 선택돼 있으면 그 마커 색, 아니면 기본(다음에 적용될) 색
    string CurrentColorPickerValue()
    {
        if (_selectedMarkerId != null)
        {
            var selected = _rowMarkers.FirstOrDefault(m => m.Id == _selectedMarkerId);
            if (selected != null) return selected.Color;
        }
        return _rowMarkerColor;
    }

    void OnRowMarkerColorChange(ChangeEventArgs e)
    {
        var newColor = e.Value?.ToString() ?? "#ffeb3b";
        if (_selectedMarkerId != null)
        {
            // 마커를 선택한 상태면 그 마커만 색을 바꿈 — 다른 마커에는 영향 없음
            var selected = _rowMarkers.FirstOrDefault(m => m.Id == _selectedMarkerId);
            if (selected != null) selected.Color = newColor;
            _ = SaveRowMarkersAsync();
        }
        else
        {
            // 선택한 마커가 없으면 "다음에 추가할 마커"의 기본색만 바꿈 — 기존 마커들은 그대로 둠
            // (이동 가능한 마커가 여러 개 동시에 존재할 수 있어, 한꺼번에 색이 바뀌면 구분이 어려워짐)
            _rowMarkerColor = newColor;
        }
        StateHasChanged();
    }

    // 마커 추가: 직전 마커(가장 최근 추가/조절된 것) 높이를 참조해 새 이동 가능한 마커를 만들고 자동 선택
    async Task AddRowMarker()
    {
        var last = _rowMarkers.LastOrDefault();
        double rowH = DefaultRowHeight;
        if (last != null && last.RowHeight > 0) rowH = last.RowHeight;
        else if (_detectedRowH > 0) rowH = _detectedRowH;

        int page = _currentPage;

        // 화면 중앙(현재 보이는 영역 기준, zoom 반영된 CSS px)에 생성 — 페이지마다 마커를 만들 수 있도록
        double centerCss;
        try { centerCss = await JS.InvokeAsync<double>("patternViewer.getViewCenterCanvasY", page); }
        catch { centerCss = 200 * _zoom; }
        var y = Math.Max(0, centerCss / _zoom - rowH / 2);

        double pageWidth;
        try { pageWidth = await JS.InvokeAsync<double>("patternViewer.getPageWidth", page); }
        catch { pageWidth = _pageWidth; } // 실패 시에만 마지막으로 알던 너비로 대체
        if (pageWidth > 0) _pageWidth = pageWidth;

        _detectedRowH = rowH;
        var newMarker = new RowMarker
        {
            Page = page,
            Y = y,
            RowHeight = rowH,
            PageWidth = pageWidth,
            Color = _rowMarkerColor,
            IsCurrent = true
        };
        _rowMarkers.Add(newMarker);
        _selectedMarkerId = newMarker.Id; // 추가한 마커를 바로 선택 상태로 — 이어서 위치/높이 조절하기 편하게
        _rowMarkerHistory.Add(("added", newMarker.Id, ++_rowMarkerHistoryGroupSeq));
        _ = SaveRowMarkersAsync();
        StateHasChanged();
    }

    // 흔적 남기기: 선택한 마커를 완료 표시(테두리 없는 하이라이트)로 바꾸고, 그 한 칸 위에 새 이동 가능 마커를 자동 생성
    void MarkRowAsDone()
    {
        if (_selectedMarkerId == null)
        {
            _ = JS.InvokeVoidAsync("showToast", "흔적을 남길 마커를 먼저 선택하세요.", "error");
            return;
        }
        var target = _rowMarkers.FirstOrDefault(m => m.Id == _selectedMarkerId && m.IsCurrent);
        if (target == null) return;

        target.IsCurrent = false;
        var groupId = ++_rowMarkerHistoryGroupSeq;
        _rowMarkerHistory.Add(("markedDone", target.Id, groupId));

        // 더 이상 이동 가능하지 않으므로, DOM에 남아있던 드래그 리스너를 떼어내야 함
        // (그대로 두면 Blazor diffing으로 엘리먼트가 재사용될 때 옛 리스너가 남아 클릭/선택이 꼬일 수 있음)
        _ = JS.InvokeVoidAsync("patternViewer.detachMarkerDrag", $"rowmarker-{target.Id:N}");

        // 굳힌 행 바로 위(한 칸)에 같은 높이의 새 이동 가능 마커를 만들어 이어서 등록하기 편하게 함
        // 색상은 "선택했던 마커의 실제 색"을 그대로 이어받음 — 선택 상태에서 색을 바꾸면 _rowMarkerColor(기본색)는
        // 갱신되지 않으므로, 여기서 _rowMarkerColor를 쓰면 방금 바꾼 색이 아니라 예전 기본색으로 되돌아가버림
        var nextY = Math.Max(0, target.Y - target.RowHeight);
        var newMarker = new RowMarker
        {
            Page = target.Page,
            Y = nextY,
            RowHeight = target.RowHeight,
            PageWidth = target.PageWidth,
            Color = target.Color,
            IsCurrent = true
        };
        _rowMarkers.Add(newMarker);
        _selectedMarkerId = newMarker.Id;
        _rowMarkerHistory.Add(("added", newMarker.Id, groupId)); // 같은 그룹 — 되돌리기 한 번에 둘 다 처리
        _detectedRowH = target.RowHeight;

        _ = SaveRowMarkersAsync();
        StateHasChanged();
    }

    void UndoRowMarker()
    {
        // 복원된(새로고침 전) 마커에 대한 동작은 히스토리에 없으므로 자연히 그 경계를 넘어 되돌릴 수 없음
        if (_rowMarkerHistory.Count == 0) return;

        // 마지막 그룹(흔적 남기기처럼 한 번의 동작으로 여러 항목이 같이 쌓였을 수 있음)을 한 번에 되돌림
        var groupId = _rowMarkerHistory[^1].GroupId;
        var toUndo = _rowMarkerHistory.Where(h => h.GroupId == groupId).ToList();
        _rowMarkerHistory.RemoveAll(h => h.GroupId == groupId);

        // added → markedDone 순서로 처리되어도 결과가 같도록, added를 먼저 되돌리고 markedDone을 되돌림
        foreach (var item in toUndo.Where(h => h.Kind == "added"))
        {
            var marker = _rowMarkers.FirstOrDefault(m => m.Id == item.MarkerId);
            if (marker != null) _rowMarkers.Remove(marker);
            if (_selectedMarkerId == item.MarkerId) _selectedMarkerId = null;
        }
        foreach (var item in toUndo.Where(h => h.Kind == "markedDone"))
        {
            var marker = _rowMarkers.FirstOrDefault(m => m.Id == item.MarkerId);
            if (marker != null)
            {
                marker.IsCurrent = true;
                _selectedMarkerId = marker.Id; // 흔적 남기기를 취소했으니 다시 그 마커를 선택 상태로
            }
        }

        _ = SaveRowMarkersAsync();
        StateHasChanged();
    }

    void SelectMarker(Guid markerId)
    {
        // 같은 마커 다시 클릭하면 선택 해제
        _selectedMarkerId = _selectedMarkerId == markerId ? null : markerId;
        StateHasChanged();
    }

    async Task DeleteSelectedMarker()
    {
        if (_selectedMarkerId == null) return;
        var marker = _rowMarkers.FirstOrDefault(m => m.Id == _selectedMarkerId);
        if (marker == null) { _selectedMarkerId = null; return; }

        _rowMarkers.Remove(marker);
        _selectedMarkerId = null;

        // 삭제된 마커에 대한 과거 히스토리 항목은 더 이상 의미가 없으므로 함께 제거
        // (예: "added" 항목이 남아있으면 되돌리기 시 이미 없는 마커를 찾으려 함)
        _rowMarkerHistory.RemoveAll(h => h.MarkerId == marker.Id);

        await SaveRowMarkersAsync();
        StateHasChanged();
    }

    // 지우개 탭: cssY 위치에 겹치는 흔적 마커(!IsCurrent)를 삭제
    [JSInvokable]
    public async Task EraseMarkerAt(double cssY, int pageNum)
    {
        // marker.Y * _zoom = 마커 top(cssY 기준), marker.RowHeight * _zoom = 높이
        var hit = _rowMarkers
            .Where(m => !m.IsCurrent && m.Page == pageNum)
            .FirstOrDefault(m =>
            {
                var top    = m.Y * _zoom;
                var bottom = top + Math.Max(m.RowHeight * _zoom, 4);
                return cssY >= top && cssY <= bottom;
            });

        if (hit == null) return;

        _rowMarkers.Remove(hit);
        _rowMarkerHistory.RemoveAll(h => h.MarkerId == hit.Id);
        if (_selectedMarkerId == hit.Id) _selectedMarkerId = null;

        await SaveRowMarkersAsync();
        StateHasChanged();
    }

    double _pageWidth = 0;

    async Task SaveRowMarkersAsync()
    {
        if (_project == null) return;
        _project.ViewerRowMarkers = System.Text.Json.JsonSerializer.Serialize(_rowMarkers);
        await SaveProject();
    }
    async Task GoBack()
    {
        // 로컬 저장만 즉시 하고 페이지 이동 (Firebase는 백그라운드)
        await ForceSaveViewerStateAsync();
        Nav.NavigateTo("projects/" + ProjectId);
    }

    async Task ForceSaveViewerStateAsync()
    {
        if (_project == null || !_pdfLoaded) return;
        try
        {
            _saveCts?.Cancel();
            _saving = true;
            StateHasChanged();
            var pathsJson = await JS.InvokeAsync<string>("patternViewer.getPaths");
            _project.ViewerAnnotations = pathsJson;

            _project.ViewerRowMarkers      = System.Text.Json.JsonSerializer.Serialize(_rowMarkers);
            _project.ViewerLastZoom        = _zoom;
            _project.ViewerLastPage        = _currentPage;
            _project.ViewerLastTool        = _tool;
            _project.ViewerPenColor        = _penColor;
            _project.ViewerPenSize         = _penSize;
            _project.ViewerPenOpacity      = _penOpacity;
            _project.ViewerHlColor         = _hlColor;
            _project.ViewerHlSize          = _hlSize;
            _project.ViewerEraserSize      = _eraserSize;
            _project.ViewerRowMarkerColor  = _rowMarkerColor;
            await SaveProject();
            _saving = false;
        }
        catch (Exception ex)
        {
            _saving = false;
            await JS.InvokeVoidAsync("console.error", "ForceSave error: " + ex.Message);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _saveCts?.Cancel();
        _saveCts?.Dispose();
        StopRefreshTimer();
        _dotNetRef?.Dispose();
        // 세션이 없는 경우에도 뷰어 진입 시 획득한 WakeLock 해제
        // (세션 활성 중엔 EndSession에서도 해제하지만 중복 해제는 무해)
        try { await JS.InvokeVoidAsync("releaseWakeLock"); } catch { }
        try { await JS.InvokeVoidAsync("patternViewer.dispose"); } catch { }
    }
}
