        background: rgba(32,32,32,0.96); border-color: rgba(255,255,255,0.1);
        box-shadow: 0 4px 16px rgba(0,0,0,0.4); color: #eee;
    }
    [data-dark="true"] .draw-panel-inner * { color: #eee !important; }
    [data-dark="true"] .dp-sep { background: rgba(255,255,255,0.1); }
    [data-dark="true"] .dp-val { color: #ddd !important; }
    [data-dark="true"] .dp-label { color: #888 !important; }
    [data-dark="true"] .dp-size-btn { background: rgba(255,255,255,0.1); color: #eee !important; }
    [data-dark="true"] .dp-btn { color: #ddd; }
    [data-dark="true"] .dp-btn img { filter: invert(1); opacity: 0.85; }
    [data-dark="true"] .dp-panel-inner span { color: #ddd; }
    [data-dark="true"] .dp-btn:hover { background: rgba(255,255,255,0.1); }
    [data-dark="true"] .dp-on { background: rgba(255,255,255,0.15); }
    [data-dark="true"] .dp-val { color: #ddd !important; }
    [data-dark="true"] .dp-label { color: #888 !important; }
    [data-dark="true"] .dp-size-btn { background: rgba(255,255,255,0.08); color: #ddd !important; }
