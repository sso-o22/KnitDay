    record UserEntry(string Email, string? Uid, string? ExpiresAt = null, string? LicenseType = null, string? LastActiveAt = null, string? RegisteredAt = null);

    List<UserEntry>? _users;
    bool _loading = false;
    string _userSort = "registered_desc";
    string _userLicenseFilter = "all";

    IEnumerable<UserEntry> FilteredSortedUsers
    {
        get
        {
            var list = (_users ?? new()).AsEnumerable();

            list = _userLicenseFilter switch
            {
                "6month"  => list.Where(u => u.LicenseType == "6month"),
                "1year"   => list.Where(u => u.LicenseType == "1year"),
                "lifetime" => list.Where(u => u.LicenseType == "lifetime" || u.LicenseType == "earlybird_lifetime"),
                "etc"     => list.Where(u => u.LicenseType != "6month" && u.LicenseType != "1year"
                                          && u.LicenseType != "lifetime" && u.LicenseType != "earlybird_lifetime"),
                _         => list
            };

            // 등록일 없는 옛날 계정은 정렬 방향과 무관하게 맨 뒤로 (모르는 값이라 순서를 단정할 수 없음)
            DateTime? RegDate(UserEntry u) => DateTime.TryParse(u.RegisteredAt, out var d) ? d : null;
            // 만료일이 "lifetime"이거나 없으면 정렬 비교가 안 되니 맨 뒤로 보냄
            DateTime? ExpDate(UserEntry u) => DateTime.TryParse(u.ExpiresAt, out var d) ? d : null;

            list = _userSort switch
            {
                "registered_asc"  => list.OrderBy(u => RegDate(u) == null).ThenBy(u => RegDate(u)),
                "registered_desc" => list.OrderBy(u => RegDate(u) == null).ThenByDescending(u => RegDate(u)),
                "name_asc"        => list.OrderBy(u => u.Email, StringComparer.OrdinalIgnoreCase),
                "name_desc"       => list.OrderByDescending(u => u.Email, StringComparer.OrdinalIgnoreCase),
                "expiry_asc"      => list.OrderBy(u => ExpDate(u) == null).ThenBy(u => ExpDate(u)),
                "expiry_desc"     => list.OrderBy(u => ExpDate(u) == null).ThenByDescending(u => ExpDate(u)),
                _                 => list
            };

            return list;
        }
    }

