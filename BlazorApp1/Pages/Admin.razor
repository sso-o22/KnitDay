    async Task ExportYarnApproved()
    {
        if (_yarnApproved == null || _yarnApproved.Count == 0) return;
        // yarn-db.json과 같은 브랜드/이름 단위 구조로 내보내서, 기존 파일에 바로 병합하기 쉽게 함
        var grouped = _yarnApproved
            .GroupBy(a => (a.Brand, a.Name))
            .Select(g => new
            {
                brand = g.Key.Brand,
                name = g.Key.Name,
                entries = g.Select(a => new
                {
                    yarnType = a.YarnType,
                    material = a.Material,
                    ply = a.Ply,
                    weightGram = a.WeightGram,
                    lengthMeter = a.LengthMeter,
                    price = a.Price
                }).ToList()
            }).ToList();
        var json = System.Text.Json.JsonSerializer.Serialize(grouped, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        var filename = $"yarn-db-approved-{DateTime.Now:yyyyMMdd-HHmm}.json";
        await JS.InvokeVoidAsync("downloadTextFile", filename, json, "application/json");
