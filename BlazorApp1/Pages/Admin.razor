@page "/admin"
@inject IJSRuntime JS
@inject AuthService Auth
@implements IDisposable

@if (!Auth.IsInitialized)
{
    <div style="display:flex;align-items:center;justify-content:center;height:60vh;font-size:0.9rem;color:var(--text-light);">
        로딩 중...
    </div>
}
else if (!Auth.IsLoggedIn || Auth.CurrentUser?.Uid != AdminUid)
{
    <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:60vh;gap:12px;">
        <img src="icons/warning.svg" class="icon-line" style="width:40px;height:40px;opacity:0.4;" />
        <div style="font-size:0.9rem;color:var(--text-light);">접근 권한이 없습니다.</div>
    </div>
}
else
{
    <div class="page-header">
        <div>
            <h1 class="page-title">
                <img src="icons/key.svg" class="icon-line" style="width:36px;height:36px;" />관리자
            </h1>
            <p class="page-subtitle">구매자 계정을 등록하고 관리해요</p>
        </div>
    </div>

    <div class="settings-wrapper">

        <!-- 탭 네비게이션 -->
        <div style="display:flex;gap:6px;padding:4px;background:var(--ivory-dark);border-radius:12px;">
            <button class="btn btn-sm" style="@StatsTabStyle" @onclick="SetTabStats">통계</button>
            <button class="btn btn-sm" style="@AccountsTabStyle" @onclick="SetTabAccounts">계정</button>
            <button class="btn btn-sm" style="@YarnTabStyle" @onclick="SetTabYarn">실</button>
        </div>

        @if (_activeTab == "stats")
        {
        <!-- 관리 통계 -->
        <div class="card">
            <div class="card-title" style="margin-bottom:12px;display:flex;align-items:center;justify-content:space-between;gap:6px;">
                <span style="display:flex;align-items:center;gap:6px;">
                    <img src="icons/chart-bar.svg" class="icon-line" style="width:20px;height:20px;flex-shrink:0;" />관리 통계
                </span>
                <button class="btn btn-ghost btn-sm" @onclick="LoadMetrics" disabled="@_loadingMetrics">
                    <img src="icons/arrows-clockwise.svg" class="icon-line" style="width:14px;height:14px;flex-shrink:0;" />
                </button>
            </div>
            @if (_loadingMetrics)
            {
                <div style="font-size:0.82rem;color:var(--text-light);">불러오는 중...</div>
            }
            else if (_metrics == null)
            {
                <div style="font-size:0.82rem;color:var(--text-light);">
                    아직 통계가 없어요. 매일 새벽 5시에 자동으로 집계돼요 (Cloud Function <code>collectDailyMetrics</code>가 배포·실행된 이후부터).
                </div>
            }
            else
            {
                <div style="font-size:0.72rem;color:var(--text-light);margin-bottom:10px;">
                    @_metrics.Date 기준 스냅샷 (매일 새벽 5시 자동 갱신)
                </div>
                <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:10px;margin-bottom:12px;">
                    <div class="admin-stat-box">
                        <div class="admin-stat-num">@_metrics.TotalUsers</div>
                        <div class="admin-stat-label">전체 가입자</div>
                    </div>
                    <div class="admin-stat-box">
                        <div class="admin-stat-num">@(_metrics.TotalStorageMB.ToString("N0"))MB</div>
                        <div class="admin-stat-label">클라우드 저장 용량 합계</div>
                    </div>
                    <div class="admin-stat-box">
                        <div class="admin-stat-num">@_metrics.LicenseChangesLast30d</div>
                        <div class="admin-stat-label">최근 30일 이용권 변경/갱신</div>
                    </div>
                    <div class="admin-stat-box">
                        <div class="admin-stat-num">@_metrics.PushComebacksLast30d</div>
                        <div class="admin-stat-label">
                            최근 30일 알림 보고 복귀
                            @if (_metrics.PushComebackAvgDays != null)
                            {
                                <span> (평균 @(_metrics.PushComebackAvgDays)일 후)</span>
                            }
                        </div>
                    </div>
                </div>
                <div style="font-size:0.78rem;color:var(--text-mid);">
                    이용권 종류별: 평생 @(_metrics.LicenseCounts.GetValueOrDefault("lifetime") + _metrics.LicenseCounts.GetValueOrDefault("earlybird_lifetime"))명
                    (얼리버드 @(_metrics.LicenseCounts.GetValueOrDefault("earlybird_lifetime"))명) ·
                    1년 @(_metrics.LicenseCounts.GetValueOrDefault("1year"))명 ·
                    6개월 @(_metrics.LicenseCounts.GetValueOrDefault("6month"))명 ·
                    기타 @(_metrics.LicenseCounts.GetValueOrDefault("etc"))명
                </div>
            }
        </div>
        }

        @if (_activeTab == "accounts")
        {
        <!-- 계정 등록 -->
        <div class="card">
            <div class="card-title" style="margin-bottom:12px;display:flex;align-items:center;gap:6px;">
                <img src="icons/user-check.svg" class="icon-line" style="width:20px;height:20px;flex-shrink:0;" />구매자 등록
            </div>
            <div style="display:flex;gap:8px;margin-bottom:10px;">
                <input type="email" placeholder="구글 이메일 입력" @bind="_emailInput" @bind:event="oninput"
                       @onkeydown="OnKeyDown"
                       style="flex:1;min-width:0;padding:9px 12px;border:1.5px solid var(--border);border-radius:var(--radius-sm);font-size:0.88rem;background:var(--white);color:var(--text-dark);" />
            </div>
            <div style="display:flex;gap:8px;align-items:center;margin-bottom:@(_addMsg != "" ? "10px" : "0");">
                <select @bind="_licenseType" style="flex:1;padding:9px 12px;border:1.5px solid var(--border);border-radius:var(--radius-sm);font-size:0.88rem;background:var(--white);color:var(--text-dark);">
                    <option value="lifetime">평생 이용권</option>
                    <option value="earlybird_lifetime">얼리버드 평생권</option>
                    <option value="1year">1년 이용권</option>
                    <option value="6month">6개월 이용권</option>
                    <option value="custom">직접 입력</option>
                </select>
                @if (_licenseType == "custom")
                {
                    <input type="date" @bind="_customExpiry"
                           style="flex:1;padding:9px 12px;border:1.5px solid var(--border);border-radius:var(--radius-sm);font-size:0.88rem;background:var(--white);color:var(--text-dark);" />
                }
                <button class="btn btn-primary" @onclick="AddUser" disabled="@(_adding || string.IsNullOrWhiteSpace(_emailInput))">
                    @(_adding ? "등록 중..." : "등록")
                </button>
            </div>
            @if (_addMsg != "")
            {
                <div style="font-size:0.82rem;color:@(_addError ? "#c03030" : "var(--theme-active)");">@_addMsg</div>
            }
        </div>

        <!-- 등록된 계정 목록 -->
        <div class="card">
            <div class="card-title" style="margin-bottom:12px;display:flex;align-items:center;gap:6px;">
                <img src="icons/list.svg" class="icon-line" style="width:20px;height:20px;flex-shrink:0;" />
                등록된 계정
                @if (_users != null)
                {
                    <span style="margin-left:auto;font-size:0.78rem;font-weight:400;color:var(--text-light);">@(_users.Count)명</span>
                }
                <button class="btn btn-ghost btn-sm" style="padding:2px 8px;font-size:0.75rem;" @onclick="LoadUsers">↺</button>
            </div>
            @if (_users != null && _users.Any(u => u.LicenseType == "earlybird_lifetime"))
            {
                <div style="font-size:0.78rem;color:var(--text-mid);margin:-4px 0 12px;">
                    얼리버드 평생권 발급: @(_users.Count(u => u.LicenseType == "earlybird_lifetime"))/50명
                </div>
            }

            @if (_users != null && _users.Count > 0)
            {
                <div class="filter-sort-bar" style="margin-bottom:12px;">
                    <div class="filter-sort-group">
                        @foreach (var (label, key) in new[]{("등록순","registered"),("이름순","name"),("마감일","expiry")})
                        {
                            var ascVal  = key + "_asc";
                            var descVal = key + "_desc";
                            var isActive = _userSort == ascVal || _userSort == descVal;
                            var isAsc   = _userSort == ascVal;
                            <button class="btn btn-sm @(isActive?"btn-sage":"btn-ghost")" style="flex-shrink:0;"
                                    @onclick="() => _userSort = isActive ? (isAsc ? descVal : ascVal) : descVal">
                                @label @if (isActive) { <img src="@(isAsc?"icons/arrow-up.svg":"icons/arrow-down.svg")" class="icon-line" style="width:11px;height:11px;margin-left:2px;" /> }
                            </button>
                        }
                    </div>
                    <div class="filter-sort-divider"></div>
                    <div class="filter-sort-group swatch-needle-wrapper">
                        <select class="form-control swatch-needle-select" style="flex-shrink:0;" @bind="_userLicenseFilter">
                            <option value="all">이용권 전체</option>
                            <option value="6month">6개월</option>
                            <option value="1year">1년</option>
                            <option value="lifetime">평생</option>
                            <option value="etc">기타</option>
                        </select>
                    </div>
                </div>
            }

            @if (_loading)
            {
                <div style="font-size:0.85rem;color:var(--text-light);padding:8px 0;">불러오는 중...</div>
            }
            else if (_users == null || _users.Count == 0)
            {
                <div style="font-size:0.85rem;color:var(--text-light);padding:8px 0;">등록된 계정이 없어요.</div>
            }
            else
            {
                <div style="display:flex;flex-direction:column;gap:0;border:1px solid var(--border);border-radius:10px;overflow:hidden;">
                    @foreach (var user in FilteredSortedUsers)
                    {
                        var u = user;
                        <div style="display:flex;align-items:center;gap:10px;padding:11px 14px;border-bottom:1px solid var(--border);">
                            <img src="icons/user.svg" class="icon-line" style="width:16px;height:16px;flex-shrink:0;opacity:0.5;" />
                            <div style="flex:1;min-width:0;">
                                <div style="font-size:0.85rem;color:var(--text-dark);word-break:break-all;">@u.Email</div>
                                @if (!string.IsNullOrEmpty(u.Uid))
                                {
                                    <div style="font-size:0.7rem;color:var(--text-light);margin-top:2px;">uid: @u.Uid</div>
                                }
                                <div style="font-size:0.72rem;margin-top:3px;display:flex;align-items:center;gap:4px;color:@(u.ExpiresAt == null ? "#c03030" : "var(--theme-active)");">
                                    <img src="icons/ticket.svg" class="icon-line" style="width:13px;height:13px;flex-shrink:0;" /> @LicenseDisplayLabel(u)
                                </div>
                                <div style="font-size:0.7rem;margin-top:2px;color:var(--text-light);">
                                    최근 활동: @LastActiveLabel(u)
                                </div>
                            </div>
                            @if (_deletingEmail == u.Email)
                            {
                                <span style="font-size:0.75rem;color:var(--text-light);">삭제 중...</span>
                            }
                            else
                            {
                                <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;flex-shrink:0;">
                                    <button class="btn btn-ghost btn-sm"
                                            style="padding:3px 8px;font-size:0.75rem;color:var(--theme-active);"
                                            @onclick="() => OpenChangeLicense(u)">이용권</button>
                                    <button class="btn btn-ghost btn-sm"
                                            style="padding:3px 8px;font-size:0.75rem;color:var(--theme-active);"
                                            @onclick="() => OpenChangeEmail(u)">이메일</button>
                                    <button class="btn btn-ghost btn-sm"
                                            style="padding:3px 8px;font-size:0.75rem;color:#c03030;"
                                            @onclick="() => ConfirmDelete(u)">삭제</button>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        }

    @* 이용권 변경 팝업 *@
    @if (_changeLicenseUser != null)
    {
        <div style="position:fixed;top:0;left:0;right:0;bottom:0;z-index:9999;background:rgba(0,0,0,0.45);display:flex;align-items:center;justify-content:center;padding:24px;box-sizing:border-box;"
             @onclick="CloseChangeLicense">
            <div style="background:var(--white);border-radius:20px;padding:28px 24px 20px;max-width:340px;width:100%;box-shadow:0 20px 60px rgba(0,0,0,0.2);"
                 @onclick:stopPropagation="true">
                <div style="font-size:1rem;font-weight:700;margin-bottom:6px;color:var(--text-dark);">이용권 변경</div>
                <div style="font-size:0.82rem;color:var(--text-mid);margin-bottom:16px;word-break:break-all;">@_changeLicenseUser.Email</div>
                <select @bind="_newLicenseType" style="width:100%;padding:9px 12px;border:1.5px solid var(--border);border-radius:var(--radius-sm);font-size:0.88rem;margin-bottom:10px;box-sizing:border-box;background:var(--white);color:var(--text-dark);">
                    <option value="lifetime">평생 이용권</option>
                    <option value="earlybird_lifetime">얼리버드 평생권</option>
                    <option value="1year">1년 이용권 (오늘부터 +1년)</option>
                    <option value="6month">6개월 이용권 (오늘부터 +6개월)</option>
                    <option value="1year_extend">1년 연장 (기존 만료일부터 +1년)</option>
                    <option value="6month_extend">6개월 연장 (기존 만료일부터 +6개월)</option>
                    <option value="custom">직접 입력</option>
                </select>
                @if (_newLicenseType == "custom")
                {
                    <input type="date" @bind="_newLicenseExpiry"
                           style="width:100%;padding:9px 12px;border:1.5px solid var(--border);border-radius:var(--radius-sm);font-size:0.88rem;margin-bottom:10px;box-sizing:border-box;" />
                }
                @if (!string.IsNullOrEmpty(_licenseChangeMsg))
                {
                    <div style="font-size:0.82rem;color:@(_licenseChangeError ? "#c03030" : "var(--theme-active)");margin-bottom:10px;">@_licenseChangeMsg</div>
                }
                <div style="display:flex;gap:8px;justify-content:flex-end;">
                    <button class="btn btn-ghost" @onclick="CloseChangeLicense" disabled="@_changingLicense">취소</button>
                    <button class="btn btn-primary" @onclick="ChangeLicense" disabled="@_changingLicense">
                        @(_changingLicense ? "변경 중..." : "변경")
                    </button>
                </div>
            </div>
        </div>
    }

    @* 이메일 변경 팝업 *@
    @if (_changeEmailUser != null)
    {
        <div style="position:fixed;top:0;left:0;right:0;bottom:0;z-index:9999;background:rgba(0,0,0,0.45);display:flex;align-items:center;justify-content:center;padding:24px;box-sizing:border-box;"
             @onclick="CloseChangeEmail">
            <div style="background:var(--white);border-radius:20px;padding:28px 24px 20px;max-width:340px;width:100%;box-shadow:0 20px 60px rgba(0,0,0,0.2);"
                 @onclick:stopPropagation="true">
                <div style="font-size:1rem;font-weight:700;margin-bottom:6px;color:var(--text-dark);">계정 이메일 변경</div>
                <div style="font-size:0.82rem;color:var(--text-mid);margin-bottom:16px;word-break:break-all;">현재: @_changeEmailUser.Email</div>
                <input type="email" placeholder="새 구글 이메일 입력" @bind="_newEmailInput" @bind:event="oninput"
                       style="width:100%;padding:9px 12px;border:1.5px solid var(--border);border-radius:var(--radius-sm);font-size:0.88rem;margin-bottom:10px;box-sizing:border-box;" />
                @if (!string.IsNullOrEmpty(_changeMsg))
                {
                    <div style="font-size:0.82rem;color:@(_changeError ? "#c03030" : "var(--theme-active)");margin-bottom:10px;">@_changeMsg</div>
                }
                <div style="font-size:0.75rem;color:var(--text-light);margin-bottom:16px;">기존 이메일은 삭제되고 새 이메일로 등록돼요. 데이터는 그대로 유지돼요.</div>
                <div style="display:flex;gap:8px;justify-content:flex-end;">
                    <button class="btn btn-ghost" @onclick="CloseChangeEmail" disabled="@_changing">취소</button>
                    <button class="btn btn-primary" @onclick="ChangeEmail"
                            disabled="@(_changing || string.IsNullOrWhiteSpace(_newEmailInput) || _newEmailInput.Trim() == _changeEmailUser.Email)">
                        @(_changing ? "변경 중..." : "변경")
                    </button>
                </div>
            </div>
        </div>
    }

    @* ── 실 정보 제보 관리 ── *@
    @if (_activeTab == "yarn")
    {
    <div class="card" style="margin-top:8px;">
        <div class="card-title" style="margin-bottom:12px;display:flex;align-items:center;gap:6px;">
            <img src="icons/yarn.svg" class="icon-line" style="width:20px;height:20px;flex-shrink:0;" />
            실 정보 제보
            @if (_yarnReports != null)
            {
                <span style="margin-left:auto;font-size:0.78rem;font-weight:400;color:var(--text-light);">@(_yarnReports.Count)건 대기중</span>
            }
            <button class="btn btn-ghost btn-sm" style="padding:2px 8px;font-size:0.75rem;" @onclick="LoadYarnReports">↺</button>
        </div>

        @if (_loadingYarnReports)
        {
            <div style="font-size:0.85rem;color:var(--text-light);padding:8px 0;">불러오는 중...</div>
        }
        else if (_yarnReports == null || _yarnReports.Count == 0)
        {
            <div style="font-size:0.85rem;color:var(--text-light);padding:8px 0;">대기중인 제보가 없어요.</div>
        }
        else
        {
            <div style="display:flex;flex-direction:column;gap:10px;">
                @foreach (var r in _yarnReports)
                {
                    <div style="border:1px solid var(--border);border-radius:12px;padding:14px;">
                        <div style="display:flex;align-items:baseline;gap:8px;margin-bottom:6px;">
                            <span style="font-weight:700;color:var(--text-dark);">@r.Name</span>
                            <span style="font-size:0.8rem;color:var(--text-light);">@r.Brand</span>
                        </div>
                        <div style="font-size:0.8rem;color:var(--text-mid);line-height:1.6;">
                            @r.YarnType · @r.Material<br />
                            @(r.Ply)합 · @(r.WeightGram)g / @(r.LengthMeter)m · @(r.Price)원
                            @if (!string.IsNullOrWhiteSpace(r.Memo))
                            {
                                <br />
                                <span style="color:var(--text-light);">메모: @r.Memo</span>
                            }
                        </div>
                        <div style="font-size:0.72rem;color:var(--text-light);margin-top:6px;">
                            @r.SubmittedAt @(string.IsNullOrEmpty(r.SubmittedByUid) ? "· 비로그인 제보" : "")
                        </div>
                        <div style="display:flex;gap:8px;margin-top:10px;">
                            <button class="btn btn-primary btn-sm" disabled="@(_processingReportId == r.Id)" @onclick="() => AcceptYarnReport(r)">
                                @(_processingReportId == r.Id ? "처리 중..." : "수락")
                            </button>
                            <button class="btn btn-ghost btn-sm" disabled="@(_processingReportId == r.Id)" @onclick="() => RejectYarnReport(r)">거절</button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    @* ── 승인된 실 정보 (yarnDbApproved) 관리 ── *@
    <div class="card" style="margin-top:8px;">
        <div class="card-title" style="margin-bottom:12px;display:flex;align-items:center;gap:6px;">
            <img src="icons/check-circle.svg" class="icon-line" style="width:20px;height:20px;flex-shrink:0;" />
            승인된 실 정보
            @if (_yarnApproved != null)
            {
                <span style="margin-left:auto;font-size:0.78rem;font-weight:400;color:var(--text-light);">@(_yarnApproved.Count)건</span>
            }
            <button class="btn btn-ghost btn-sm" style="padding:2px 8px;font-size:0.75rem;" @onclick="LoadYarnApproved">↺</button>
        </div>
        <div style="font-size:0.76rem;color:var(--text-light);margin-bottom:12px;">
            수락된 실 정보는 자동완성엔 바로 반영되지만, 정식 yarn-db.json 엑셀에는 아직 안 들어간 상태예요.
            아래에서 잘못된 항목을 미리 지우고, 엑셀에 옮겨 넣은 뒤엔 "내보낸 항목 정리"로 비워주세요.
        </div>

        @if (_loadingYarnApproved)
        {
            <div style="font-size:0.85rem;color:var(--text-light);padding:8px 0;">불러오는 중...</div>
        }
        else if (_yarnApproved == null || _yarnApproved.Count == 0)
        {
            <div style="font-size:0.85rem;color:var(--text-light);padding:8px 0;">승인된 항목이 없어요.</div>
        }
        else
        {
            <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:14px;">
                @foreach (var a in _yarnApproved)
                {
                    <div style="display:flex;align-items:center;gap:10px;border:1px solid var(--border);border-radius:10px;padding:10px 12px;">
                        <div style="flex:1;min-width:0;">
                            <div style="font-size:0.85rem;"><b style="color:var(--text-dark);">@a.Name</b> <span style="color:var(--text-light);">@a.Brand</span></div>
                            <div style="font-size:0.76rem;color:var(--text-mid);">@a.YarnType · @(a.Ply)합 · @(a.WeightGram)g/@(a.LengthMeter)m · @(a.Price)원</div>
                        </div>
