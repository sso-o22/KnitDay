@page "/admin"
@inject IJSRuntime JS
@inject AuthService Auth
@implements IDisposable

@if (!Auth.IsInitialized)
{
    <div style="display:flex;align-items:center;justify-content:center;height:60vh;font-size:0.9rem;color:var(--text-light);">
        로딩 중...
    </div>
}
else if (!Auth.IsLoggedIn || Auth.CurrentUser?.Uid != AdminUid)
{
    <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:60vh;gap:12px;">
        <img src="icons/warning.svg" class="icon-line" style="width:40px;height:40px;opacity:0.4;" />
        <div style="font-size:0.9rem;color:var(--text-light);">접근 권한이 없습니다.</div>
    </div>
}
else
{
    <div class="page-header">
        <div>
            <h1 class="page-title">
                <img src="icons/key.svg" class="icon-line" style="width:36px;height:36px;" />관리자
            </h1>
            <p class="page-subtitle">구매자 계정을 등록하고 관리해요</p>
        </div>
    </div>

    <div class="settings-wrapper">

        <!-- 계정 등록 -->
        <div class="card">
            <div class="card-title" style="margin-bottom:12px;display:flex;align-items:center;gap:6px;">
                <img src="icons/user-check.svg" class="icon-line" style="width:20px;height:20px;flex-shrink:0;" />구매자 등록
            </div>
            <div style="display:flex;gap:8px;margin-bottom:@(_addMsg != "" ? "10px" : "0");">
                <input type="email" placeholder="구글 이메일 입력" @bind="_emailInput" @bind:event="oninput"
                       @onkeydown="OnKeyDown"
                       style="flex:1;min-width:0;padding:9px 12px;border:1.5px solid var(--border);border-radius:var(--radius-sm);font-size:0.88rem;background:var(--white);color:var(--text-dark);" />
                <button class="btn btn-primary" @onclick="AddUser" disabled="@(_adding || string.IsNullOrWhiteSpace(_emailInput))">
                    @(_adding ? "등록 중..." : "등록")
                </button>
            </div>
            @if (_addMsg != "")
            {
                <div style="font-size:0.82rem;color:@(_addError ? "#c03030" : "var(--theme-active)");">@_addMsg</div>
            }
        </div>

        <!-- 등록된 계정 목록 -->
        <div class="card">
            <div class="card-title" style="margin-bottom:12px;display:flex;align-items:center;gap:6px;">
                <img src="icons/list.svg" class="icon-line" style="width:20px;height:20px;flex-shrink:0;" />
                등록된 계정
                @if (_users != null)
                {
                    <span style="margin-left:auto;font-size:0.78rem;font-weight:400;color:var(--text-light);">@(_users.Count)명</span>
                }
                <button class="btn btn-ghost btn-sm" style="padding:2px 8px;font-size:0.75rem;" @onclick="LoadUsers">↺</button>
            </div>

            @if (_loading)
            {
                <div style="font-size:0.85rem;color:var(--text-light);padding:8px 0;">불러오는 중...</div>
            }
            else if (_users == null || _users.Count == 0)
            {
                <div style="font-size:0.85rem;color:var(--text-light);padding:8px 0;">등록된 계정이 없어요.</div>
            }
            else
            {
                <div style="display:flex;flex-direction:column;gap:0;border:1px solid var(--border);border-radius:10px;overflow:hidden;">
                    @foreach (var user in _users)
                    {
                        var u = user;
                        <div style="display:flex;align-items:center;gap:10px;padding:11px 14px;border-bottom:1px solid var(--border);">
                            <img src="icons/user.svg" class="icon-line" style="width:16px;height:16px;flex-shrink:0;opacity:0.5;" />
                            <div style="flex:1;min-width:0;">
                                <div style="font-size:0.85rem;color:var(--text-dark);word-break:break-all;">@u.Email</div>
                                @if (!string.IsNullOrEmpty(u.Uid))
                                {
                                    <div style="font-size:0.7rem;color:var(--text-light);margin-top:2px;">uid: @u.Uid</div>
                                }
                            </div>
                            @if (_deletingEmail == u.Email)
                            {
                                <span style="font-size:0.75rem;color:var(--text-light);">삭제 중...</span>
                            }
                            else
                            {
                                <button class="btn btn-ghost btn-sm"
                                        style="padding:3px 8px;font-size:0.75rem;color:var(--theme-active);flex-shrink:0;"
                                        @onclick="() => OpenChangeEmail(u)">변경</button>
                                <button class="btn btn-ghost btn-sm"
                                        style="padding:3px 8px;font-size:0.75rem;color:#c03030;flex-shrink:0;"
                                        @onclick="() => ConfirmDelete(u)">삭제</button>
                            }
                        </div>
                    }
                </div>
            }
        </div>

    </div>

    @* 이메일 변경 팝업 *@
    @if (_changeEmailUser != null)
    {
        <div style="position:fixed;top:0;left:0;right:0;bottom:0;z-index:9999;background:rgba(0,0,0,0.45);display:flex;align-items:center;justify-content:center;padding:24px;box-sizing:border-box;"
             @onclick="CloseChangeEmail">
            <div style="background:var(--white);border-radius:20px;padding:28px 24px 20px;max-width:340px;width:100%;box-shadow:0 20px 60px rgba(0,0,0,0.2);"
                 @onclick:stopPropagation="true">
                <div style="font-size:1rem;font-weight:700;margin-bottom:6px;color:var(--text-dark);">계정 이메일 변경</div>
                <div style="font-size:0.82rem;color:var(--text-mid);margin-bottom:16px;word-break:break-all;">현재: @_changeEmailUser.Email</div>
                <input type="email" placeholder="새 구글 이메일 입력" @bind="_newEmailInput" @bind:event="oninput"
                       style="width:100%;padding:9px 12px;border:1.5px solid var(--border);border-radius:var(--radius-sm);font-size:0.88rem;margin-bottom:10px;box-sizing:border-box;" />
                @if (!string.IsNullOrEmpty(_changeMsg))
                {
                    <div style="font-size:0.82rem;color:@(_changeError ? "#c03030" : "var(--theme-active)");margin-bottom:10px;">@_changeMsg</div>
                }
                <div style="font-size:0.75rem;color:var(--text-light);margin-bottom:16px;">기존 이메일은 삭제되고 새 이메일로 등록돼요. 데이터는 그대로 유지돼요.</div>
                <div style="display:flex;gap:8px;justify-content:flex-end;">
                    <button class="btn btn-ghost" @onclick="CloseChangeEmail" disabled="@_changing">취소</button>
                    <button class="btn btn-primary" @onclick="ChangeEmail"
                            disabled="@(_changing || string.IsNullOrWhiteSpace(_newEmailInput) || _newEmailInput.Trim() == _changeEmailUser.Email)">
                        @(_changing ? "변경 중..." : "변경")
                    </button>
                </div>
            </div>
        </div>
    }

    @* 삭제 확인 팝업 *@
    @if (_confirmDeleteUser != null)
    {
        <div style="position:fixed;top:0;left:0;right:0;bottom:0;z-index:9999;background:rgba(0,0,0,0.45);display:flex;align-items:center;justify-content:center;padding:24px;box-sizing:border-box;"
             @onclick="() => _confirmDeleteUser = null">
            <div style="background:var(--white);border-radius:20px;padding:28px 24px 20px;max-width:320px;width:100%;text-align:center;box-shadow:0 20px 60px rgba(0,0,0,0.2);"
                 @onclick:stopPropagation="true">
                <div style="font-size:1rem;font-weight:700;margin-bottom:10px;color:var(--text-dark);">계정을 삭제할까요?</div>
                <div style="font-size:0.83rem;color:var(--text-mid);margin-bottom:16px;word-break:break-all;">@_confirmDeleteUser.Email</div>
                @if (!string.IsNullOrEmpty(_confirmDeleteUser.Uid))
                {
                    <div style="display:flex;align-items:center;gap:8px;margin-bottom:16px;padding:10px;background:var(--ivory-dark);border-radius:8px;text-align:left;">
                        <input type="checkbox" @bind="_hardDelete" style="width:16px;height:16px;accent-color:#c03030;flex-shrink:0;" />
                        <div>
                            <div style="font-size:0.82rem;font-weight:600;color:#c03030;">완전 삭제</div>
                            <div style="font-size:0.75rem;color:var(--text-light);">데이터·사진·도안 모두 삭제</div>
                        </div>
                    </div>
                }
                else
                {
                    <div style="font-size:0.75rem;color:var(--text-light);margin-bottom:16px;">로그인 이력 없음 — 접근 차단만 가능</div>
                }
                <div style="display:flex;gap:8px;justify-content:center;">
                    <button class="btn btn-ghost" @onclick="() => { _confirmDeleteUser = null; _hardDelete = false; }">취소</button>
                    <button class="btn btn-primary" style="background:#c03030;" @onclick="DeleteUser">삭제</button>
                </div>
            </div>
        </div>
    }
}

@code {
    const string AdminUid = "xAz2xO8kulWUgoHnaaxCkzZV2nG2";

    record UserEntry(string Email, string? Uid);

    List<UserEntry>? _users;
    bool _loading = false;
    string _emailInput = "";
    bool _adding = false;
    string _addMsg = "";
    bool _addError = false;
    string? _deletingEmail;
    UserEntry? _confirmDeleteUser;
    bool _hardDelete = false;
    UserEntry? _changeEmailUser;
    string _newEmailInput = "";
    bool _changing = false;
    string _changeMsg = "";
    bool _changeError = false;

    protected override void OnInitialized()
    {
        Auth.OnAuthChanged += OnAuthChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Auth.IsLoggedIn && Auth.CurrentUser?.Uid == AdminUid)
            await LoadUsers();
    }

    async void OnAuthChanged()
    {
        if (Auth.IsLoggedIn && Auth.CurrentUser?.Uid == AdminUid)
            await LoadUsers();
        await InvokeAsync(StateHasChanged);
    }

    async Task LoadUsers()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            var json = await JS.InvokeAsync<string?>("firebaseStore.getCollection", "allowedUsers");
            if (!string.IsNullOrEmpty(json))
            {
                using var doc = System.Text.Json.JsonDocument.Parse(json);
                _users = doc.RootElement.EnumerateArray()
                    .Select(e => new UserEntry(
                        e.TryGetProperty("id", out var id) ? id.GetString() ?? "" : "",
                        e.TryGetProperty("uid", out var uid) ? uid.GetString() : null))
                    .Where(u => !string.IsNullOrEmpty(u.Email))
                    .OrderBy(u => u.Email)
                    .ToList();
            }
            else _users = new();
        }
        catch { _users = new(); }
        _loading = false;
        StateHasChanged();
    }

    async Task AddUser()
    {
        var email = _emailInput.Trim().ToLower();
        if (string.IsNullOrEmpty(email)) return;
        _adding = true; _addMsg = ""; StateHasChanged();
        try
        {
            var ok = await JS.InvokeAsync<bool>("firebaseStore.setDocument",
                $"allowedUsers/{email}",
                System.Text.Json.JsonSerializer.Serialize(new
                {
                    registeredAt = DateTime.UtcNow.ToString("yyyy-MM-dd"),
                    expiresAt = "lifetime"  // 기본값: 평생이용권 (1년권은 날짜로 변경)
                }));
            if (ok)
            {
                _addMsg = $"{email} 등록 완료!";
                _addError = false;
                _emailInput = "";
                await LoadUsers();
            }
            else { _addMsg = "등록 실패. Firestore 규칙을 확인하세요."; _addError = true; }
        }
        catch (Exception ex) { _addMsg = "오류: " + ex.Message; _addError = true; }
        _adding = false;
        StateHasChanged();
    }

    void OpenChangeEmail(UserEntry user) { _changeEmailUser = user; _newEmailInput = ""; _changeMsg = ""; _changeError = false; }
    void CloseChangeEmail() { _changeEmailUser = null; _newEmailInput = ""; _changeMsg = ""; }

    async Task ChangeEmail()
    {
        if (_changeEmailUser == null) return;
        var newEmail = _newEmailInput.Trim().ToLower();
        if (string.IsNullOrEmpty(newEmail)) return;
        _changing = true; _changeMsg = ""; StateHasChanged();
        try
        {
            // 새 이메일로 등록 (uid 포함 이전)
            var data = System.Text.Json.JsonSerializer.Serialize(new
            {
                registeredAt = DateTime.UtcNow.ToString("yyyy-MM-dd"),
                uid = _changeEmailUser.Uid ?? ""
            });
            var ok = await JS.InvokeAsync<bool>("firebaseStore.setDocument", $"allowedUsers/{newEmail}", data);
            if (!ok) { _changeMsg = "새 이메일 등록 실패."; _changeError = true; _changing = false; StateHasChanged(); return; }

            // 기존 이메일 삭제
            await JS.InvokeAsync<bool>("firebaseStore.deleteDocument", $"allowedUsers/{_changeEmailUser.Email}");

            _changeMsg = $"✓ {_changeEmailUser.Email} → {newEmail} 변경 완료!";
            _changeError = false;
            await LoadUsers();
            _changeEmailUser = null;
            _newEmailInput = "";
        }
        catch (Exception ex) { _changeMsg = $"오류: {ex.Message}"; _changeError = true; }
        _changing = false;
        StateHasChanged();
    }

    void ConfirmDelete(UserEntry user) { _confirmDeleteUser = user; _hardDelete = false; }

    async Task DeleteUser()
    {
        var user = _confirmDeleteUser;
        if (user == null) return;
        _confirmDeleteUser = null;
        _deletingEmail = user.Email;
        StateHasChanged();
        try
        {
            if (_hardDelete && !string.IsNullOrEmpty(user.Uid))
            {
                var resultJson = await JS.InvokeAsync<string>("callFirebaseFunction", "deleteAccount",
                    System.Text.Json.JsonSerializer.Serialize(new { targetUid = user.Uid }));
                using var doc = System.Text.Json.JsonDocument.Parse(resultJson);
                var success = doc.RootElement.TryGetProperty("success", out var s) && s.GetBoolean();
                if (success)
                    _users?.RemoveAll(u => u.Email == user.Email);
                else
                    await JS.InvokeVoidAsync("showToast", "완전 삭제 중 일부 오류가 발생했어요.", "error");
            }
            else
            {
                await JS.InvokeAsync<bool>("firebaseStore.deleteDocument", $"allowedUsers/{user.Email}");
                _users?.RemoveAll(u => u.Email == user.Email);
            }
        }
        catch (Exception ex) { await JS.InvokeVoidAsync("showToast", $"오류: {ex.Message}", "error"); }
        _hardDelete = false;
        _deletingEmail = null;
        StateHasChanged();
    }

    async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddUser();
    }

    public void Dispose() => Auth.OnAuthChanged -= OnAuthChanged;
}