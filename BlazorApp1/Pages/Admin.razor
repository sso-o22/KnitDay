    async Task LoadYarnReports()
    {
        _loadingYarnReports = true;
        StateHasChanged();
        try
        {
            var json = await JS.InvokeAsync<string?>("firebaseStore.getCollection", "yarnSubmissions");
            if (string.IsNullOrWhiteSpace(json)) { _yarnReports = new(); }
            else
            {
                var all = System.Text.Json.JsonSerializer.Deserialize<List<YarnReportEntry>>(json,
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
                _yarnReports = all.OrderByDescending(r => r.SubmittedAt).ToList();
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("showToast", $"제보 목록 로드 실패: {ex.Message}", "error");
            _yarnReports = new();
        }
        _loadingYarnReports = false;
        StateHasChanged();
    }

    async Task AcceptYarnReport(YarnReportEntry r)
    {
        _processingReportId = r.Id;
        StateHasChanged();
        try
        {
            // 승인된 항목을 yarnDbApproved 컬렉션에 기록 → 실 창고 자동완성이 즉시 읽어감
            var approvedDoc = new
            {
                brand = r.Brand,
                name = r.Name,
                yarnType = r.YarnType,
                material = r.Material,
                ply = r.Ply,
                weightGram = r.WeightGram,
                lengthMeter = r.LengthMeter,
                price = r.Price,
                approvedAt = DateTime.UtcNow.ToString("o")
            };
            var json = System.Text.Json.JsonSerializer.Serialize(approvedDoc);
            var ok = await JS.InvokeAsync<bool>("firebaseStore.setDocument", $"yarnDbApproved/{r.Id}", json);
            if (ok)
            {
                await JS.InvokeAsync<bool>("firebaseStore.deleteDocument", $"yarnSubmissions/{r.Id}");
                _yarnReports?.RemoveAll(x => x.Id == r.Id);
                _yarnApproved ??= new();
                _yarnApproved.Insert(0, new YarnApprovedEntry
                {
                    Id = r.Id, Brand = r.Brand, Name = r.Name, YarnType = r.YarnType, Material = r.Material,
                    Ply = r.Ply, WeightGram = r.WeightGram, LengthMeter = r.LengthMeter, Price = r.Price,
                    ApprovedAt = approvedDoc.approvedAt
                });
                await JS.InvokeVoidAsync("showToast", "제보를 수락해서 실 DB에 반영했어요.", "success");
            }
            else
            {
                await JS.InvokeVoidAsync("showToast", "수락 처리에 실패했어요.", "error");
            }
        }
        catch (Exception ex) { await JS.InvokeVoidAsync("showToast", $"오류: {ex.Message}", "error"); }
        _processingReportId = null;
        StateHasChanged();
    }

    async Task RejectYarnReport(YarnReportEntry r)
    {
        _processingReportId = r.Id;
        StateHasChanged();
        try
        {
            await JS.InvokeAsync<bool>("firebaseStore.deleteDocument", $"yarnSubmissions/{r.Id}");
            _yarnReports?.RemoveAll(x => x.Id == r.Id);
        }
        catch (Exception ex) { await JS.InvokeVoidAsync("showToast", $"오류: {ex.Message}", "error"); }
        _processingReportId = null;
        StateHasChanged();
    }

