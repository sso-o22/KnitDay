    async Task RemovePhoto(ProjectPhoto photo)
    {
        if (Project == null || photo == null) return;
        Project.Photos.Remove(photo);
        StateHasChanged();
        if (!string.IsNullOrEmpty(photo.StorageUrl))
            await Storage.DeletePhotoAsync(Project.Id.ToString(), photo.Id.ToString(), photo.FileSizeBytes);
