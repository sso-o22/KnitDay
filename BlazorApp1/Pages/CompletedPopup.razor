@* =====================================================================
   Pages/CompletedPopup.razor — 완성작 상세 팝업
   ===================================================================== *@
@using KnitLog.Models
@using KnitLog.Services
@inject StorageService Storage
@inject NavigationManager Nav
@inject IJSRuntime JS

@if (Show && Project != null)
{
    <div class="completed-popup-backdrop"
         @onclick:stopPropagation="true">
        <!-- 모바일: 풀스크린 / 태블릿+: 가운데 모달 -->
        <div class="completed-popup-inner"
             @onclick:stopPropagation="true">

            <!-- 헤더 -->
            <div style="display:flex; align-items:center; justify-content:space-between;
                        padding:20px 20px 14px; flex-shrink:0; border-bottom:1px solid var(--border);">
                <h2 style="font-family:'DM Sans','Noto Sans KR',sans-serif; font-size:1.15rem; font-weight:700; color:var(--black); margin:0;">@(string.IsNullOrEmpty(Project.PatternName) ? "완성작 등록" : Project.PatternName)</h2>
                <button style="display:flex; align-items:center; justify-content:center;
                               width:32px; height:32px; border-radius:8px;
                               border:1px solid var(--border); background:none;
                               cursor:pointer; color:var(--text-dark); line-height:1;"
                        @onclick="ClosePopup"><img src="icons/x.svg" class="icon-line" style="width:14px;height:14px;" /></button>
            </div>

            <!-- 스크롤 영역 -->
            <div style="overflow-y:auto; overflow-x:hidden; flex:1; padding:16px 20px; word-break:break-word; overflow-wrap:break-word;">

            @if (!_editing)
            {
                <!-- 보기 모드 -->

                <!-- 사진 갤러리 (5칸 슬롯, 읽기 전용) -->
                @if (PopupValidPhotos.Any())
                {
                    <div style="display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:6px; margin-bottom:16px;">
                        @for (int vi = 0; vi < 5; vi++)
                        {
                            var vIdx = vi;
                            @if (vIdx < PopupValidPhotos.Count)
                            {
                                var vp = PopupValidPhotos[vIdx];
                                <div style="position:relative; aspect-ratio:1; cursor:pointer;" @onclick="() => OpenPhotoLightbox(vp)">
                                    <img src="@(!string.IsNullOrEmpty(vp.StorageUrl) ? vp.StorageUrl : vp.Base64Data)"
                                         style="width:100%; height:100%; object-fit:cover; border-radius:var(--radius-sm);"
                                         alt="사진" />
                                    @if (vIdx == 0)
                                    {
                                        <span style="position:absolute;top:2px;left:2px;background:var(--theme-active);border-radius:3px;padding:1px 4px;font-size:0.55rem;color:var(--white);font-weight:700;line-height:1.4;">대표</span>
                                    }
                                </div>
                            }
                            else
                            {
                                <div style="aspect-ratio:1; border:1.5px dashed var(--border); border-radius:var(--radius-sm); background:var(--ivory-dark);"></div>
                            }
                        }
                    </div>
                }

                <!-- 도안 -->
                @if (!string.IsNullOrEmpty(Project.PatternName))
                {
                    <div style="margin-bottom:12px;">
                        <div class="form-label" style="margin-bottom:4px; display:flex;align-items:center;gap:5px;"><img src="icons/book-open-text.svg" class="icon-line" style="width:14px;height:14px;flex-shrink:0;" />도안</div>
                        <div style="font-size:0.92rem;">@Project.PatternName</div>
                        @if (!string.IsNullOrEmpty(Project.PatternSource))
                        {
                            <div style="font-size:0.82rem; color:var(--text-mid);">출처: @Project.PatternSource</div>
                        }
                        @if (!string.IsNullOrEmpty(Project.PatternMemo))
                        {
                            <div style="font-size:0.82rem; color:var(--text-mid); margin-top:2px; white-space:pre-wrap;">@Project.PatternMemo</div>
                        }
                    </div>
                }

                <!-- 날짜/시간 바 -->
                <div style="margin-bottom:14px; padding:12px; background:var(--ivory-dark); border-radius:var(--radius-sm);">
                    <div style="display:flex; gap:16px; flex-wrap:wrap; align-items:center;">
                        @if (Project.StartDate.HasValue)
                        {
                            <div style="text-align:center;">
                                <div style="font-size:0.72rem; color:var(--text-light); margin-bottom:2px;">시작일</div>
                                <div style="font-size:0.9rem; font-weight:600;">@Project.StartDate.Value.ToString("yyyy.MM.dd")</div>
                            </div>
                        }
                        @if (Project.EndDate.HasValue)
                        {
                            <div style="text-align:center;">
                                <div style="font-size:0.72rem; color:var(--text-light); margin-bottom:2px;">완성일</div>
                                <div style="font-size:0.9rem; font-weight:600;">@Project.EndDate.Value.ToString("yyyy.MM.dd")</div>
                            </div>
                        }
                        @if (Project.StartDate.HasValue && Project.EndDate.HasValue)
                        {
                            var days = (Project.EndDate.Value - Project.StartDate.Value).Days;
                            <div style="text-align:center;">
                                <div style="font-size:0.72rem; color:var(--text-light); margin-bottom:2px;">소요일</div>
                                <div style="font-size:0.9rem; font-weight:600; color:#8a6a08;">@days 일</div>
                            </div>
                        }
                        @{
                            var popMin = Project.Sessions
                                .Where(s => s.EndTime.HasValue)
                                .Sum(s => (int)(s.EndTime!.Value - s.StartTime).TotalMinutes);
                        }
                        @if (popMin > 0)
                        {
                            var ph = popMin / 60; var pm = popMin % 60;
                            <div style="text-align:center;">
                                <div style="font-size:0.72rem; color:var(--text-light); margin-bottom:2px;">누적 시간</div>
                                <div style="font-size:0.9rem; font-weight:600; color:#267848;">@(ph > 0 ? $"{ph}시간 " : "")@(pm > 0 ? $"{pm}분" : "")</div>
                            </div>
                        }
                        else
                        {
                            <div style="text-align:center;">
                                <div style="font-size:0.72rem; color:var(--text-light); margin-bottom:2px;">누적 시간</div>
                                <div style="font-size:0.82rem; color:var(--text-light);">기록 없음</div>
                            </div>
                        }
                    </div>
                </div>

                <!-- 완성 치수 -->
                <div style="margin-bottom:12px; padding-top:12px; border-top:1px solid var(--border);">
                    <div class="form-label" style="margin-bottom:8px;"><img src="icons/ruler.svg" class="icon-line" style="width:14px;height:14px;flex-shrink:0;display:inline;vertical-align:middle;margin-right:4px;" />완성 치수</div>
                    @if (_measures.Any(m => !string.IsNullOrEmpty(m.Before) || !string.IsNullOrEmpty(m.After)))
                    {
                        <div style="border:0.5px solid var(--border); border-radius:var(--radius-sm); overflow:hidden; font-size:0.82rem;">
                            <div style="display:grid; grid-template-columns:120px 1fr 1fr; background:var(--ivory-dark); border-bottom:0.5px solid var(--border);">
                                <div style="padding:6px 10px; color:var(--text-mid); font-weight:500;">항목</div>
                                <div style="padding:6px 10px; color:var(--text-mid); font-weight:500; border-left:0.5px solid var(--border);">세탁 전</div>
                                <div style="padding:6px 10px; color:var(--text-mid); font-weight:500; border-left:0.5px solid var(--border);">세탁 후</div>
                            </div>
                            @foreach (var m in _measures.Where(m => !string.IsNullOrEmpty(m.Before) || !string.IsNullOrEmpty(m.After)))
                            {
                                <div style="display:grid; grid-template-columns:120px 1fr 1fr; border-top:0.5px solid var(--border);">
                                    <div style="padding:6px 10px;">@m.Label</div>
                                    <div style="padding:6px 10px; border-left:0.5px solid var(--border);">@(string.IsNullOrEmpty(m.Before) ? "-" : m.Before + "cm")</div>
                                    <div style="padding:6px 10px; border-left:0.5px solid var(--border);">@(string.IsNullOrEmpty(m.After) ? "-" : m.After + "cm")</div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p style="font-size:0.82rem; color:var(--text-light);">치수 정보가 없어요.</p>
                    }
                </div>

                <!-- 도안 파일 삭제 (문어발 완료 시 읽기 모드에서 표시) -->
                @if (Project.HasSavedPattern && ShowDeletePdfInViewMode && !ReadOnly)
                {
                    <div style="margin-bottom:14px; padding:10px 14px; background:var(--theme-pale); border-radius:var(--radius-sm); display:flex; align-items:center; justify-content:space-between; gap:10px;">
                        <div>
                            <div style="font-size:0.85rem; font-weight:600; color:var(--text-dark); margin-bottom:2px;">도안 파일 삭제</div>
                            <div style="font-size:0.78rem; color:var(--text-mid);">완성 후 도안이 필요 없다면 기기 공간을 확보할 수 있어요</div>
                        </div>
                        <button class="dark-toggle-btn @(_deletePdf ? "on" : "")" @onclick="() => { _deletePdf = !_deletePdf; StateHasChanged(); }">
                            <div class="dark-toggle-thumb"></div>
                        </button>
                    </div>
                }

                <!-- 사용 실 -->
                @if (Yarns.Any())
                {
                    var popYarns = Project.YarnUsages
                        .Select(u => (u, Yarns.Find(y => y.Id == u.YarnId)))
                        .Where(x => x.Item2 != null)
                        .Select(x => (x.u, x.Item2!))
                        .ToList();
                    @if (popYarns.Any())
                    {
                        <div style="margin-bottom:12px; padding-top:12px; border-top:1px solid var(--border);">
                            <div class="form-label" style="margin-bottom:6px; display:flex;align-items:center;gap:5px;"><img src="icons/yarn.svg" class="icon-line" style="width:14px;height:14px;flex-shrink:0;" />사용 실</div>
                            @foreach (var (usage, yarn) in popYarns)
                            {
                                <div style="display:flex; align-items:center; gap:8px; margin-bottom:4px; font-size:0.88rem;">
                                    <span class="color-dot" style="background:@yarn.ColorCode; flex-shrink:0;"></span>
                                    <span>@yarn.Brand @yarn.Name (@yarn.Color)</span>
                                    @if (usage.BallsUsed > 0)
                                    {
                                        @if (yarn.YarnType == YarnType.콘사)
                                        {
                                            @if (yarn.WeightGram > 0)
                                            {
                                                <span style="color:var(--text-light); font-size:0.8rem;">@((usage.BallsUsed * yarn.WeightGram).ToString("0")) g</span>
                                            }
                                            else
                                            {
                                                <span style="color:var(--text-light); font-size:0.8rem;">@usage.BallsUsed.ToString("0.##") 콘</span>
                                            }
                                        }
                                        else
                                        {
                                            <span style="color:var(--text-light); font-size:0.8rem;">@usage.BallsUsed.ToString("0.##") 볼</span>
                                        }
                                    }
                                </div>
                            }
                        </div>
                    }
                }

                <!-- 사용 바늘 -->
                @if (Tools.Where(t => Project.ToolIds.Contains(t.Id)).Any() || !string.IsNullOrEmpty(Project.NeedleNote))
                {
                    <div style="margin-bottom:12px; padding-top:12px; border-top:1px solid var(--border);">
                        <div class="form-label" style="margin-bottom:6px; display:flex;align-items:center;gap:5px;"><img src="icons/needle.svg" class="icon-line" style="width:14px;height:14px;flex-shrink:0;" />사용 바늘</div>
                        <div style="display:flex; flex-wrap:wrap; gap:6px;">
                            @foreach (var tool in Tools.Where(t => Project.ToolIds.Contains(t.Id)).ToList())
                            {
                                <span style="background:var(--ivory-dark); border-radius:4px; padding:3px 8px; font-size:0.8rem;">@tool.NeedleType @tool.SizeDisplay</span>
                            }
                            @if (!string.IsNullOrEmpty(Project.NeedleNote))
                            {
                                <span style="background:var(--ivory-dark); border-radius:4px; padding:3px 8px; font-size:0.8rem;">@Project.NeedleNote</span>
                            }
                        </div>
                    </div>
                }

                <!-- 메모 -->
                @if (!string.IsNullOrEmpty(Project.Memo))
                {
                    <div style="margin-bottom:12px; padding-top:12px; border-top:1px solid var(--border);">
                        <div class="form-label" style="margin-bottom:4px;">메모</div>
                        <p style="white-space:pre-wrap; font-size:0.9rem; color:var(--text-mid);">@Project.Memo</p>
                    </div>
                }
            }
            else
            {
                <!-- 수정 모드 -->

                <!-- 사진 추가 (5칸 슬롯) -->
                <div class="form-label" style="margin-bottom:6px;">사진</div>
                <div style="display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:6px; margin-bottom:6px;">
                    @for (int ei = 0; ei < 5; ei++)
                    {
                        var eIdx = ei;
                        @if (eIdx < PopupValidPhotos.Count)
                        {
                            var ep = PopupValidPhotos[eIdx];
                            <div style="position:relative; aspect-ratio:1; overflow:hidden; border-radius:var(--radius-sm);">
                                <img src="@(!string.IsNullOrEmpty(ep.StorageUrl) ? ep.StorageUrl : ep.Base64Data)"
                                     style="width:100%; height:100%; object-fit:cover;"
                                     class="@(eIdx==0 ? "photo-slot-thumb photo-slot-active" : "photo-slot-thumb")"
                                     alt="사진" />
                                @if (eIdx == 0)
                                {
                                    <span style="position:absolute;top:2px;left:2px;background:var(--theme-active);border-radius:3px;padding:1px 4px;font-size:0.55rem;color:var(--white);font-weight:700;line-height:1.4;">대표</span>
                                }
                                @if (eIdx > 0)
                                {
                                    <button style="position:absolute;top:2px;left:2px;background:rgba(0,0,0,0.45);border:none;border-radius:3px;padding:2px 4px;cursor:pointer;display:flex;align-items:center;"
                                            @onclick="() => SetPopupThumbnail(ep.Id)">
                                        <img src="icons/star.svg" class="icon-line" style="width:10px;height:10px;filter:invert(1);opacity:0.9;" />
                                    </button>
                                }
                                <button class="btn btn-danger btn-sm"
                                        style="position:absolute;top:2px;right:2px;padding:1px 4px;"
                                        @onclick="async () => await RemovePhoto(ep)">
                                    <img src="icons/x.svg" class="icon-line" style="width:9px;height:9px;" />
                                </button>
                            </div>
                        }
                        else
                        {
                            <label style="aspect-ratio:1; border:1.5px dashed var(--border); border-radius:var(--radius-sm); display:flex; align-items:center; justify-content:center; cursor:pointer; background:var(--ivory-dark); position:relative; overflow:hidden;">
                                <img src="icons/plus.svg" class="icon-line" style="width:18px;height:18px;opacity:0.4;" />
                                <InputFile OnChange="OnPhotoSelected"
                                           accept="image/jpeg,image/png,image/heic,image/heif,image/webp"
                                           multiple
                                           style="position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%;" />
                            </label>
                        }
                    }
                </div>
                <p style="font-size:0.72rem; color:var(--text-light); margin-bottom:16px;">슬롯 눌러 추가 · 별 눌러 대표사진 · 최대 5장 · 자동 압축</p>

                <!-- 도안명 -->
                <div class="form-group" style="margin-bottom:16px;">
                    <label class="form-label">도안명</label>
                    <input class="form-control" @bind="Project.PatternName" placeholder="예: 마시멜로 후드 집업" />
                </div>

                <!-- 도안 출처 -->
                <div class="form-group" style="margin-bottom:16px;">
                    <label class="form-label">도안 출처</label>
                    <input class="form-control" @bind="Project.PatternSource" placeholder="작가명, 책 이름, URL 등" />
                </div>

                <!-- 도안 메모 -->
                <div class="form-group" style="margin-bottom:16px;">
                    <label class="form-label">도안 메모</label>
                    <textarea class="form-control" rows="2" @bind="Project.PatternMemo" placeholder="사이즈, 수정 사항 등"></textarea>
                </div>

                <!-- 날짜 -->
                <div class="form-label" style="margin-bottom:6px;">날짜</div>
                <div class="date-row" style="margin-bottom:24px;">
                    <div class="form-group" style="margin-bottom:0;">
                        <label class="form-label" style="font-size:0.78rem;">시작일</label>
                        <input type="date" class="form-control"
                               value="@Project.StartDate?.ToString("yyyy-MM-dd")"
                               @onchange="e => Project.StartDate = string.IsNullOrEmpty(e.Value?.ToString()) ? null : DateTime.Parse(e.Value.ToString()!)" />
                    </div>
                    <div class="form-group" style="margin-bottom:0;">
                        <label class="form-label" style="font-size:0.78rem;">완성일</label>
                        <input type="date" class="form-control"
                               value="@Project.EndDate?.ToString("yyyy-MM-dd")"
                               @onchange="e => Project.EndDate = string.IsNullOrEmpty(e.Value?.ToString()) ? null : DateTime.Parse(e.Value.ToString()!)" />
                    </div>
                </div>

                <!-- 완성 치수 -->
                <div class="form-label" style="margin-bottom:6px;">완성 치수</div>
                <div style="border:0.5px solid var(--border); border-radius:var(--radius-sm); overflow:hidden; font-size:0.82rem; margin-bottom:6px;">
                    <div style="display:grid; grid-template-columns:120px 1fr 1fr; background:var(--ivory-dark); border-bottom:0.5px solid var(--border);">
                        <div style="padding:6px 10px; color:var(--text-mid); font-weight:500;">항목</div>
                        <div style="padding:6px 10px; color:var(--text-mid); font-weight:500; border-left:0.5px solid var(--border);">세탁 전 (cm)</div>
                        <div style="padding:6px 10px; color:var(--text-mid); font-weight:500; border-left:0.5px solid var(--border);">세탁 후 (cm)</div>
                    </div>
                    @foreach (var m in _measures)
                    {
                        <div style="display:grid; grid-template-columns:120px 1fr 1fr; border-top:0.5px solid var(--border);">
                            <div style="padding:4px 6px; display:flex; align-items:center; gap:4px;">
                                @if (m.IsCustom)
                                {
                                    <input class="form-control" style="border:none; padding:3px 6px; font-size:0.82rem; width:100%;" @bind="m.Label" placeholder="항목명" />
                                    <button class="btn btn-danger btn-sm" style="padding:1px 5px; font-size:0.7rem;" @onclick="() => _measures.Remove(m)">✕</button>
                                }
                                else { <span style="padding:3px 4px;">@m.Label</span> }
                            </div>
                            <div style="border-left:0.5px solid var(--border); padding:2px 6px;">
                                <input class="form-control" style="border:none; padding:4px 6px; font-size:0.82rem;" @bind="m.Before" placeholder="-" />
                            </div>
                            <div style="border-left:0.5px solid var(--border); padding:2px 6px;">
                                <input class="form-control" style="border:none; padding:4px 6px; font-size:0.82rem;" @bind="m.After" placeholder="-" />
                            </div>
                        </div>
                    }
                </div>
                <button class="btn btn-ghost btn-sm" style="color:var(--text-dark); margin-bottom:16px;" @onclick="() => _measures.Add(new MeasureItem { IsCustom = true })">+ 항목 추가</button>

                <!-- 도안 파일 삭제 (수정 모드, ShowDeletePdfInViewMode가 아닐 때) -->
                @if (Project.HasSavedPattern && !ShowDeletePdfInViewMode)
                {
                    <div style="margin-bottom:16px; padding:10px 14px; background:var(--theme-pale); border-radius:var(--radius-sm); display:flex; align-items:center; justify-content:space-between; gap:10px;">
                        <div>
                            <div style="font-size:0.85rem; font-weight:600; color:var(--text-dark); margin-bottom:2px;">도안 파일 삭제</div>
                            <div style="font-size:0.78rem; color:var(--text-mid);">완성 후 도안이 필요 없다면 기기 공간을 확보할 수 있어요</div>
                        </div>
                        <button class="dark-toggle-btn @(_deletePdf ? "on" : "")" @onclick="() => { _deletePdf = !_deletePdf; StateHasChanged(); }">
                            <div class="dark-toggle-thumb"></div>
                        </button>
                    </div>
                }

                <!-- 도안 정보 -->
                <div class="form-label" style="margin-top:16px; margin-bottom:8px;">도안 정보</div>
                <div style="padding:10px 12px; background:var(--ivory-dark); border-radius:var(--radius-sm); margin-bottom:16px;">
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label" style="font-size:0.78rem;">원작 바늘</label>
                            <input class="form-control" @bind="Project.OriginalNeedle" placeholder="예: 4mm 대바늘" />
                        </div>
                        <div class="form-group">
                            <label class="form-label" style="font-size:0.78rem;">원작 게이지</label>
                            <input class="form-control" @bind="Project.OriginalGauge" placeholder="예: 22코 × 30단 / 10cm" />
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label" style="font-size:0.78rem;">원작 실</label>
                            <input class="form-control" @bind="Project.OriginalYarn" placeholder="예: 솜솜뜨개 러스크 2합" />
                        </div>
                        <div class="form-group">
                            <label class="form-label" style="font-size:0.78rem;">원작실 규격 (소요량 계산기용)</label>
                            <div style="display:flex; gap:6px; align-items:center;">
                                <input class="form-control" type="number" step="1" style="flex:1; min-width:0;"
                                       value="@(Project.OriginalYarnWeightG == 0 ? "" : Project.OriginalYarnWeightG.ToString())"
                                       @onchange="e => { if (double.TryParse(e.Value?.ToString(), out var v)) Project.OriginalYarnWeightG = v; else Project.OriginalYarnWeightG = 0; }" placeholder="g" />
                                <span style="font-size:0.78rem; color:var(--text-light); flex-shrink:0;">g /</span>
                                <input class="form-control" type="number" step="1" style="flex:1; min-width:0;"
                                       value="@(Project.OriginalYarnLengthM == 0 ? "" : Project.OriginalYarnLengthM.ToString())"
                                       @onchange="e => { if (double.TryParse(e.Value?.ToString(), out var v)) Project.OriginalYarnLengthM = v; else Project.OriginalYarnLengthM = 0; }" placeholder="m" />
                                <span style="font-size:0.78rem; color:var(--text-light); flex-shrink:0;">m</span>
                            </div>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label" style="font-size:0.78rem;">사이즈</label>
                            <input class="form-control" @bind="Project.OriginalSize" placeholder="예: M, 95, Free" />
                        </div>
                        <div class="form-group">
                            <label class="form-label" style="font-size:0.78rem;">소요량</label>
                            <div style="display:flex; gap:6px;">
                                <input class="form-control" type="number" step="1" style="flex:1; min-width:0;"
                                       value="@(Project.OriginalYarnAmountG == 0 ? "" : Project.OriginalYarnAmountG.ToString())"
                                       @onchange="e => { if (double.TryParse(e.Value?.ToString(), out var v)) Project.OriginalYarnAmountG = v; else Project.OriginalYarnAmountG = 0; }" placeholder="예: 400" />
                                <select class="form-control" style="width:64px; flex-shrink:0;" @bind="Project.OriginalYarnAmountUnit">
                                    <option value="g">g</option>
                                    <option value="m">m</option>
                                    <option value="볼">볼</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group" style="margin-bottom:0;">
                        <label class="form-label" style="font-size:0.78rem;">기타 부자재</label>
                        <input class="form-control" @bind="Project.OriginalOther" placeholder="예: 단추 7개, 20cm 지퍼" />
                    </div>
                </div>

                <!-- 사용 실 -->
                <div class="form-label" style="margin-bottom:6px;">사용 실</div>
                @if (Yarns.Any())
                {
                    <select class="form-control" style="margin-bottom:8px;" @onchange="OnPopupAddYarn">
                        <option value="">+ 실 추가</option>
                        @foreach (var y in Yarns)
                        {
                            <option value="@y.Id">@y.Brand @y.Name (@y.Color)</option>
                        }
                    </select>
                    @foreach (var usage in Project.YarnUsages.ToList())
                    {
                        var yarn = Yarns.Find(y => y.Id == usage.YarnId);
                        bool isCone = yarn?.YarnType == YarnType.콘사;
                        bool hasConeWeight = isCone && yarn?.WeightGram > 0;
                        string unitLabel = hasConeWeight ? "g" : isCone ? "콘" : "볼";
                        decimal displayVal = hasConeWeight ? usage.BallsUsed * yarn!.WeightGram : usage.BallsUsed;
                        <div style="display:flex; align-items:center; gap:8px; margin-bottom:6px; padding:6px 10px;
                                    border-radius:9px; background:#f8f8f8; border:1px solid var(--border);">
                            @if (yarn != null)
                            {
                                <span class="color-dot" style="background:@yarn.ColorCode; flex-shrink:0;"></span>
                                <span style="flex:1; font-size:0.88rem;">@yarn.Brand @yarn.Name (@yarn.Color)</span>
                            }
                            <input class="form-control" type="number" min="1" style="width:80px;"
                                   value='@displayVal.ToString(hasConeWeight ? "0" : "0.##")'
                                   @onchange="e => { if (decimal.TryParse(e.Value?.ToString(), out var n)) usage.BallsUsed = Math.Round(hasConeWeight ? n / yarn!.WeightGram : n, 6); }" />
                            <span style="font-size:0.82rem; color:var(--text-mid); flex-shrink:0;">@unitLabel</span>
                            <button class="btn btn-danger btn-sm" @onclick="() => Project.YarnUsages.Remove(usage)"><img src="icons/x.svg" class="icon-line" style="width:12px;height:12px;" /></button>
                        </div>
                    }
                }
                else
                {
                    <p style="font-size:0.82rem; color:var(--text-light); margin-bottom:16px;">실 창고에 등록된 실이 없어요.</p>
                }

                <!-- 사용 바늘 -->
                <div class="form-label" style="margin-top:16px; margin-bottom:6px;">사용 바늘</div>
                <div style="display:flex; gap:8px; margin-bottom:8px;">
                    <button type="button" class="btn btn-sm @(Project.NeedleType == NeedleType.대바늘 ? "btn-sage" : "btn-ghost")"
                            @onclick='() => Project.NeedleType = (Project.NeedleType == NeedleType.대바늘 ? (NeedleType?)null : NeedleType.대바늘)'>대바늘</button>
                    <button type="button" class="btn btn-sm @(Project.NeedleType == NeedleType.코바늘 ? "btn-sage" : "btn-ghost")"
                            @onclick='() => Project.NeedleType = (Project.NeedleType == NeedleType.코바늘 ? (NeedleType?)null : NeedleType.코바늘)'>코바늘</button>
                </div>
                <input class="form-control" style="margin-bottom:16px;" @bind="Project.NeedleNote" placeholder="예: 4mm 대바늘 80cm줄, 3.5mm 코바늘" />

                <!-- 스와치 -->
                <div class="form-label" style="margin-top:16px; margin-bottom:6px;">스와치</div>
                @if (!AllSwatches.Any())
                {
                    <p style="font-size:0.82rem; color:var(--text-light); margin-bottom:16px;">스와치 페이지에서 먼저 스와치를 만들어주세요.</p>
                }
                else
                {
                    <select class="form-control" style="margin-bottom:8px;" @onchange="OnPopupSwatchSelectChange">
                        <option value="">+ 스와치 연결</option>
                        @foreach (var s in AllSwatches.Where(s => s.ProjectId == null || s.ProjectId == Guid.Empty || s.ProjectId == Project.Id))
                        {
                            var isLinked = s.ProjectId == Project.Id;
                            <option value="@s.Id" disabled="@isLinked">@(string.IsNullOrEmpty(s.Name) ? "이름 없는 스와치" : s.Name)</option>
                        }
                    </select>
                    @if (AllSwatches.Any(s => s.ProjectId == Project.Id))
                    {
                        <div style="margin-bottom:16px; display:flex; flex-direction:column; gap:10px;">
                            @foreach (var s in AllSwatches.Where(s => s.ProjectId == Project.Id))
                            {
                                var wRate = CalcRate(s.PreWashStitches, s.PostWashStitches, s.PreWashWidthCm, s.PostWashWidthCm);
                                var hRate = CalcRate(s.PreWashRows, s.PostWashRows, s.PreWashHeightCm, s.PostWashHeightCm);
                                <div style="padding:10px 12px; border-radius:var(--radius-sm); background:var(--ivory-mid); border:1px solid var(--border);">
                                    <div style="display:flex; align-items:center; gap:8px; margin-bottom:8px;">
                                        <div style="flex:1; min-width:0; font-size:0.88rem; font-weight:600; color:var(--text-dark);">
                                            @(string.IsNullOrEmpty(s.Name) ? "이름 없는 스와치" : s.Name)
                                        </div>
                                        <button class="btn btn-danger btn-sm" style="padding:2px 8px; flex-shrink:0;" @onclick="() => UnlinkPopupSwatch(s)"><img src="icons/x.svg" class="icon-line" style="width:12px;height:12px;" /></button>
                                    </div>

                                    <div style="display:flex; gap:6px; margin-bottom:8px; flex-wrap:wrap;">
                                        @if (s.NeedleSizeMm > 0)
                                        {
                                            <span class="badge badge-cable">@s.NeedleSizeMm mm</span>
                                        }
                                        <span class="badge badge-wish">@s.Stitch</span>
                                    </div>

                                    <div style="background:var(--white); border-radius:var(--radius-sm); padding:10px; font-size:0.78rem;">
                                        <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:4px; text-align:center; margin-bottom:6px;">
                                            <div></div>
                                            <div style="color:var(--text-mid); font-weight:600;">세탁 전</div>
                                            <div style="color:var(--text-mid); font-weight:600;">세탁 후</div>
                                        </div>
                                        <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:4px; text-align:center; margin-bottom:4px;">
                                            <div style="color:var(--text-light); text-align:left;">코수</div>
                                            <div>@s.PreWashStitches</div>
                                            <div>@s.PostWashStitches</div>
                                        </div>
                                        <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:4px; text-align:center; margin-bottom:4px;">
                                            <div style="color:var(--text-light); text-align:left;">단수</div>
                                            <div>@s.PreWashRows</div>
                                            <div>@s.PostWashRows</div>
                                        </div>
                                        <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:4px; text-align:center; margin-bottom:4px;">
                                            <div style="color:var(--text-light); text-align:left;">가로</div>
                                            <div>@s.PreWashWidthCm cm</div>
                                            <div>@s.PostWashWidthCm cm</div>
                                        </div>
                                        <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:4px; text-align:center;">
                                            <div style="color:var(--text-light); text-align:left;">세로</div>
                                            <div>@s.PreWashHeightCm cm</div>
                                            <div>@s.PostWashHeightCm cm</div>
                                        </div>
                                    </div>

                                    @if (wRate.HasValue || hRate.HasValue)
                                    {
                                        <div style="display:flex; gap:6px; margin-top:8px;">
                                            @if (wRate.HasValue)
                                            {
                                                var wColor = wRate.Value < 0 ? "#c0392b" : "#267848";
                                                <div style="flex:1; background:var(--white); border-radius:var(--radius-sm); padding:6px; text-align:center;">
                                                    <div style="font-size:0.7rem; color:var(--text-light);">가로 변화율</div>
                                                    <div style="font-size:0.95rem; font-weight:700; color:@wColor;">@(wRate.Value > 0 ? "+" : "")@wRate.Value%</div>
                                                </div>
                                            }
                                            @if (hRate.HasValue)
                                            {
                                                var hColor = hRate.Value < 0 ? "#c0392b" : "#267848";
                                                <div style="flex:1; background:var(--white); border-radius:var(--radius-sm); padding:6px; text-align:center;">
                                                    <div style="font-size:0.7rem; color:var(--text-light);">세로 변화율</div>
                                                    <div style="font-size:0.95rem; font-weight:700; color:@hColor;">@(hRate.Value > 0 ? "+" : "")@hRate.Value%</div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                }

                <!-- 카테고리 + 색상 -->
                <div class="form-group" style="margin-bottom:16px;">
                    <label class="form-label">카테고리</label>
                    <div style="display:flex; gap:6px; flex-wrap:wrap; margin-bottom:10px;">
                        @foreach (var cat in Enum.GetValues<ProjectCategory>().Where(c => c != ProjectCategory.미분류))
                        {
                            <button type="button"
                                    class="btn btn-sm @(Project.Category == cat ? "btn-sage" : "btn-ghost")"
                                    @onclick="() => Project.Category = (Project.Category == cat ? ProjectCategory.미분류 : cat)">
                                @cat
                            </button>
                        }
                    </div>
                    <label class="form-label" style="margin-top:8px; display:block;">캘린더 색상</label>
                    <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
                        @foreach (var hex in _popupColorOptions)
                        {
                            bool sel = Project.ColorCode == hex;
                            <div @onclick="() => Project.ColorCode = hex"
                                 style="width:28px; height:28px; border-radius:50%; background:@hex; cursor:pointer;
                                        border:@(sel ? "3px solid #333" : "2px solid transparent");
                                        box-shadow:@(sel ? "0 0 0 2px #fff inset" : "none");
                                        transform:@(sel ? "scale(1.2)" : "scale(1)");">
                            </div>
                        }
                        <input type="color"
                               value="@(string.IsNullOrEmpty(Project.ColorCode) ? "#b8e0c8" : Project.ColorCode)"
                               @onchange="e => Project.ColorCode = e.Value?.ToString() ?? string.Empty"
                               style="width:28px; height:28px; border-radius:50%; border:2px solid var(--border); padding:0; cursor:pointer; overflow:hidden;"
                               title="직접 색상 선택" />
                    </div>
                </div>

                <!-- 메모 -->
                <div class="form-group" style="margin-bottom:0;">
                    <label class="form-label">메모</label>
                    <textarea class="form-control" rows="2" @bind="Project.Memo" placeholder="기타 메모"></textarea>
                </div>

            }

            </div><!-- /스크롤 영역 -->

            <!-- 하단 버튼 -->
            <div style="display:flex; align-items:center; justify-content:space-between; gap:8px;
                        padding:14px 20px; border-top:1px solid var(--border); flex-shrink:0; flex-wrap:wrap;">

                <!-- 왼쪽: 문어발로 복귀 -->
                <div>
                    @if (OnMoveBack.HasDelegate)
                    {
                        <button class="btn btn-ghost" style="color:var(--text-light); display:inline-flex;align-items:center;gap:4px;"
                                @onclick="OnMoveBack" disabled="@_saving">
                            <img src="icons/arrow-u-up-left.svg" class="icon-line" style="width:13px;height:13px;flex-shrink:0;" />
                            문어발로 복귀
                        </button>
                    }
                </div>

                <!-- 오른쪽 -->
                <div style="display:flex; gap:8px; align-items:center;">
                    @if (ReadOnly)
                    {
                        <button class="btn btn-ghost" @onclick="ClosePopup">닫기</button>
                        <button class="btn btn-primary" @onclick='() => Nav.NavigateTo("finished")'>완성작 목록 →</button>
                    }
                    else if (!_editing)
                    {
                        @if (OnDelete.HasDelegate)
                        {
                            <button class="btn btn-danger" @onclick="() => _showDeleteConfirm = true" disabled="@_saving">삭제</button>
                        }
                        <button class="btn btn-secondary" @onclick="OpenEditing">수정</button>
                    }
                    else
                    {
                        <button class="btn btn-ghost" @onclick="CancelEditing" disabled="@_saving">취소</button>
                        <button class="btn btn-primary" @onclick="SaveAll" disabled="@_saving">@(_saving ? "저장 중..." : "저장")</button>
                    }
                </div>
            </div>

        </div>
    </div>
}

@if (_showDeleteConfirm)
{
    <div style="position:fixed;inset:0;z-index:1200;background:rgba(0,0,0,0.45);display:flex;align-items:center;justify-content:center;padding:20px;"
         @onclick="() => _showDeleteConfirm = false">
        <div style="background:var(--white);border-radius:16px;max-width:320px;width:100%;padding:24px 20px;text-align:center;box-shadow:0 8px 32px rgba(0,0,0,0.18);"
             @onclick:stopPropagation="true">
            <div style="margin-bottom:12px;display:flex;justify-content:center;"><img src="icons/trash.svg" class="icon-line" style="width:32px;height:32px;opacity:0.65;" /></div>
            <div style="font-size:1rem;font-weight:600;margin-bottom:8px;color:var(--text-dark);">정말 삭제할까요?</div>
            <div style="font-size:0.88rem;color:var(--text-mid);margin-bottom:20px;">삭제하면 복구할 수 없어요.</div>
            <div style="display:flex;gap:10px;justify-content:center;">
                <button class="btn btn-ghost" @onclick="() => _showDeleteConfirm = false">취소</button>
                <button class="btn btn-danger" @onclick="ConfirmDelete">삭제</button>
            </div>
        </div>
    </div>
}

@* 사진 라이트박스 *@
@if (_lightboxPhoto != null)
{
    <div style="position:fixed;top:env(safe-area-inset-top,0px);right:0;bottom:0;left:0;z-index:9999;background:rgba(0,0,0,0.92);display:flex;align-items:center;justify-content:center;padding:16px;"
         @onclick="CloseLightbox">
        <button style="position:absolute;top:0;right:0;left:0;height:44px;background:transparent;border:none;cursor:pointer;z-index:10000;display:flex;align-items:center;justify-content:flex-end;padding-right:16px;"
                @onclick="CloseLightbox">
            <span style="background:rgba(0,0,0,0.65);border-radius:50%;width:32px;height:32px;display:flex;align-items:center;justify-content:center;">
                <img src="icons/x.svg" style="width:16px;height:16px;filter:invert(1);" />
            </span>
        </button>
        <img src="@(!string.IsNullOrEmpty(_lightboxPhoto.StorageUrl) ? _lightboxPhoto.StorageUrl : _lightboxPhoto.Base64Data)"
             style="max-width:95vw;max-height:calc(100vh - 60px);object-fit:contain;border-radius:8px;"
             @onclick:stopPropagation="true" />
    </div>
}

<style>
    .completed-popup-backdrop {
        position: fixed;
        inset: 0;
        z-index: 1100;
        background: rgba(0,0,0,0.32);
        display: flex;
        align-items: flex-end;
        justify-content: center;
    }
    /* 모바일: 하단에서 올라오는 풀스크린 */
    .completed-popup-inner {
        background: var(--white);
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        min-width: 0;
        box-shadow: 0 -4px 32px rgba(0,0,0,0.12);
    }
    /* 태블릿(641px+): 가운데 떠 있는 모달 */
    @@media (min-width: 641px) {
        .completed-popup-backdrop {
            align-items: center;
        }
        .completed-popup-inner {
            width: 90%;
            max-width: 680px;
            height: auto;
            max-height: 90vh;
            border-radius: var(--radius);
            box-shadow: 0 20px 60px rgba(0,0,0,0.18);
        }
    }
</style>

@code {
    bool _saving = false;
    bool _editing = false;
    static readonly string[] _popupColorOptions = new[]
    {
        "#f2b8c6", "#f7e4a0", "#b8e0c8", "#c8b8e8", "#b8d8f0",
        "#ffb74d", "#a5d6a7", "#ef9a9a", "#90caf9", "#ce93d8"
    };
    bool _showDeleteConfirm = false;
    ProjectPhoto? _lightboxPhoto = null;
    List<ProjectPhoto> _photoSnapshot = new(); // 수정 모드 진입 시 스냅샷

    void OpenPhotoLightbox(ProjectPhoto photo) => _lightboxPhoto = photo;

    void CloseLightbox() => _lightboxPhoto = null;

    List<ProjectPhoto> PopupValidPhotos => Project?.Photos
        .Where(p => !string.IsNullOrEmpty(p.Base64Data) || !string.IsNullOrEmpty(p.StorageUrl))
        .ToList() ?? new();

    [Parameter] public bool Show { get; set; }
    [Parameter] public KnitProject? Project { get; set; }
    [Parameter] public List<Yarn> Yarns { get; set; } = new();
    [Parameter] public List<KnitTool> Tools { get; set; } = new();
    [Parameter] public List<Swatch> AllSwatches { get; set; } = new();
    [Parameter] public bool ReadOnly { get; set; } = false;
    [Parameter] public bool ShowDeletePdfInViewMode { get; set; } = false; // 읽기 모드에서도 도안 삭제 토글 표시 (문어발 완료 시)
    [Parameter] public bool StartInEditMode { get; set; } = false; // 완성작 신규 등록처럼, 처음부터 수정 모드로 열어야 할 때
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
    [Parameter] public EventCallback OnMoveBack { get; set; }
    [Parameter] public EventCallback OnDeletePdf { get; set; }

    bool _deletePdf = false;

    class MeasureItem
    {
        public string Label { get; set; } = "";
        public string Before { get; set; } = "";
        public string After  { get; set; } = "";
        public bool IsCustom { get; set; } = false;
    }
    static readonly string[] _defaultLabels = { "가슴 단면", "총장", "소매 길이", "소매 단면" };
    List<MeasureItem> _measures = new();

    protected override async Task OnParametersSetAsync()
    {
        if (Show && Project != null)
        {
            // 완성작 신규 등록처럼 볼 내용이 없는 경우, 부모가 StartInEditMode로 바로 수정 모드 지정
            _editing = StartInEditMode;
            if (_editing)
                _photoSnapshot = Project.Photos.Select(p => p).ToList();
            _deletePdf = false;
            LoadMeasures();
            await JS.InvokeVoidAsync("eval", "document.body.style.overflow='hidden'");
        }
        else
        {
            await JS.InvokeVoidAsync("eval", "document.body.style.overflow=''");
        }
    }

    async Task ClosePopup()
    {
        if (_editing && Project != null)
        {
            var added = Project.Photos.Except(_photoSnapshot).ToList();
            foreach (var p in added)
                await Storage.DeletePhotoAsync(Project.Id.ToString(), p.Id.ToString(), p.FileSizeBytes);
            Project.Photos.Clear();
            foreach (var p in _photoSnapshot) Project.Photos.Add(p);
            _editing = false;
        }
        if (_deletePdf && OnDeletePdf.HasDelegate)
            await OnDeletePdf.InvokeAsync();
        _deletePdf = false;
        await JS.InvokeVoidAsync("eval", "document.body.style.overflow=''");
        await OnClose.InvokeAsync();
    }

    void OpenEditing()
    {
        LoadMeasures();
        _photoSnapshot = Project!.Photos.Select(p => p).ToList(); // 스냅샷
        _editing = true;
    }

    async Task CancelEditing()
    {
        if (Project != null)
        {
            // 스냅샷 이후 추가된 사진 클라우드에서 삭제
            var added = Project.Photos.Except(_photoSnapshot).ToList();
            foreach (var p in added)
                await Storage.DeletePhotoAsync(Project.Id.ToString(), p.Id.ToString(), p.FileSizeBytes);
            // 스냅샷으로 복원
            Project.Photos.Clear();
            foreach (var p in _photoSnapshot) Project.Photos.Add(p);
        }
        // '완성작 추가'로 열어서 아직 한 번도 저장 안 한 새 항목이면, 취소 시
        // 빈 상태의 조회 화면을 보여주지 말고 팝업 자체를 그냥 닫아야 함
        if (StartInEditMode)
        {
            await OnClose.InvokeAsync();
            return;
        }
        LoadMeasures();
        _editing = false;
    }

    void LoadMeasures()
    {
        if (Project == null) return;
        var dict = new Dictionary<string, (string, string)>();
        if (!string.IsNullOrEmpty(Project.MeasurementsMemo))
        {
            foreach (var part in Project.MeasurementsMemo.Split('|'))
            {
                var seg = part.Split(':');
                if (seg.Length >= 3) dict[seg[0]] = (seg[1], seg[2]);
                else if (seg.Length == 2) dict[seg[0]] = (seg[1], "");
            }
        }
        // 기존 데이터 마이그레이션: '가슴둘레' → '가슴 단면'
        if (dict.ContainsKey("가슴둘레") && !dict.ContainsKey("가슴 단면"))
        {
            dict["가슴 단면"] = dict["가슴둘레"];
            dict.Remove("가슴둘레");
        }
        _measures = new();
        foreach (var label in _defaultLabels)
        {
            var (b, a) = dict.TryGetValue(label, out var v) ? v : ("", "");
            _measures.Add(new MeasureItem { Label = label, Before = b, After = a });
            dict.Remove(label);
        }
        foreach (var kv in dict)
            _measures.Add(new MeasureItem { Label = kv.Key, Before = kv.Value.Item1, After = kv.Value.Item2, IsCustom = true });
    }

    async Task ConfirmDelete()
    {
        _showDeleteConfirm = false;
        await OnDelete.InvokeAsync();
    }

    async Task SaveAll()
    {
        if (Project == null) return;
        if (string.IsNullOrWhiteSpace(Project.PatternName))
        {
            await JS.InvokeVoidAsync("showToast", "도안명을 입력해주세요.", "error");
            return;
        }
        _saving = true; StateHasChanged();

        if (Project.Id == Guid.Empty) Project.Id = Guid.NewGuid();

        // 스냅샷 대비 삭제된 사진 클라우드에서 실제 삭제
        var removed = _photoSnapshot.Except(Project.Photos).ToList();
        foreach (var p in removed)
            if (!string.IsNullOrEmpty(p.StorageUrl))
                await Storage.DeletePhotoAsync(Project.Id.ToString(), p.Id.ToString(), p.FileSizeBytes);
        _photoSnapshot = Project.Photos.ToList(); // 스냅샷 갱신

        // 치수 저장
        Project.MeasurementsMemo = string.Join("|",
            _measures
                .Where(m => !string.IsNullOrEmpty(m.Label) && (!string.IsNullOrEmpty(m.Before) || !string.IsNullOrEmpty(m.After)))
                .Select(m => $"{m.Label}:{m.Before}:{m.After}"));

        await Storage.SaveProjectAsync(Project);

        // 스와치 연결 변경사항 저장
        foreach (var s in AllSwatches)
            await Storage.SaveSwatchAsync(s);

        // 도안 삭제 토글 처리
        if (_deletePdf && OnDeletePdf.HasDelegate)
        {
            await OnDeletePdf.InvokeAsync();
            _deletePdf = false;
        }

        _editing = false;
        _saving = false;
        LoadMeasures();
        await JS.InvokeVoidAsync("showToast", "저장됐어요");
        await OnSaved.InvokeAsync();
    }

    void OnPopupSwatchSelectChange(ChangeEventArgs e)
    {
        if (Project == null) return;
        var val = e.Value?.ToString();
        if (string.IsNullOrEmpty(val)) return;
        if (!Guid.TryParse(val, out var swatchId)) return;
        var swatch = AllSwatches.FirstOrDefault(s => s.Id == swatchId);
        if (swatch == null || swatch.ProjectId == Project.Id) return;
        // 기존 연결 해제 없이 추가 연결 (다중 연결)
        swatch.ProjectId = Project.Id;
    }

    void UnlinkPopupSwatch(Swatch s)
    {
        s.ProjectId = null;
    }

    // 변화율 계산 (Swatches.razor와 동일한 로직)
    // - 코/단 기준: 같은 크기에서 코수 감소 = 편물 커짐(+) → 부호 반전
    // - 길이 기준: 길이 증가 = 편물 커짐(+) → 그대로
    double? CalcRate(double preStitch, double postStitch, double preCm, double postCm)
    {
        if (preStitch > 0 && postStitch > 0 && preStitch != postStitch)
            return Math.Round(-(postStitch - preStitch) / preStitch * 100, 1);
        if (preCm > 0 && postCm > 0 && preCm != postCm)
            return Math.Round((postCm - preCm) / preCm * 100, 1);
        return null;
    }

