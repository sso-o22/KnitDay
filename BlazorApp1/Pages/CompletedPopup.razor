    void OnPopupAddYarn(ChangeEventArgs e)
    {
        if (Project == null) return;
        var val = e.Value?.ToString();
        if (string.IsNullOrEmpty(val)) return;
        if (!Guid.TryParse(val, out var yarnId)) return;
        if (!Project.YarnUsages.Any(u => u.YarnId == yarnId))
            Project.YarnUsages.Add(new ProjectYarnUsage { YarnId = yarnId, BallsUsed = 1 });
    }

    void SetPopupThumbnail(Guid photoId)
    {
        var photo = Project?.Photos.FirstOrDefault(p => p.Id == photoId);
        if (photo == null) return;
        Project!.Photos.Remove(photo);
        Project.Photos.Insert(0, photo);
        StateHasChanged();
    }

    bool _photoUploadInFlight = false;
    async Task OnPhotoSelected(InputFileChangeEventArgs e)
    {
        if (Project == null) return;
        if (_photoUploadInFlight) return; // 연타/중복 이벤트로 같은 사진이 두 번 업로드되는 것 방지
        _photoUploadInFlight = true;
        try
        {
            await OnPhotoSelectedInner(e);
        }
        finally { _photoUploadInFlight = false; }
    }

    async Task OnPhotoSelectedInner(InputFileChangeEventArgs e)
    {
        const int maxPhotos = 5;
        var files = e.GetMultipleFiles(10).ToList();
        int selectedCount = files.Count;
        int remaining = maxPhotos - Project.Photos.Count;
        if (remaining <= 0)
        {
            await JS.InvokeVoidAsync("showToast", $"사진은 최대 {maxPhotos}장까지 추가할 수 있어요.", "error");
            return;
        }
        files = files.Take(remaining).ToList();
        if (selectedCount > remaining)
        {
            await JS.InvokeVoidAsync("showToast", $"남은 슬롯이 {remaining}장뿐이에요. {remaining}장만 추가됩니다.", "error");
            await Task.Delay(1500);
        }
        long maxFileSize = 20 * 1024 * 1024; // 20MB
        var oversized = files.Where(f => f.Size > maxFileSize).ToList();
        if (oversized.Any())
        {
            var names = string.Join(", ", oversized.Select(f => f.Name));
            await JS.InvokeVoidAsync("showToast", $"20MB를 초과하는 사진은 추가할 수 없어요. ({names})", "error");
            files = files.Where(f => f.Size <= maxFileSize).ToList();
            if (!files.Any()) return;
        }
        // accept 속성은 기기(특히 갤럭시 등 안드로이드)에 따라 무시될 수 있어 실제로도 한 번 더 확인
        var validPhotoExts = new[] { ".jpg", ".jpeg", ".png", ".heic", ".heif", ".webp" };
        var invalidType = files.Where(f =>
            !(f.ContentType ?? "").StartsWith("image/") &&
            !validPhotoExts.Contains(System.IO.Path.GetExtension(f.Name).ToLowerInvariant())).ToList();
        if (invalidType.Any())
        {
            var names = string.Join(", ", invalidType.Select(f => f.Name));
            await JS.InvokeVoidAsync("showToast", $"이미지 파일만 추가할 수 있어요. ({names})", "error");
            files = files.Except(invalidType).ToList();
            if (!files.Any()) return;
        }
        await JS.InvokeVoidAsync("showToast", "사진 업로드 중...");
        StateHasChanged();
        foreach (var file in files)
        {
            try
            {
                using var stream = file.OpenReadStream(maxFileSize);
                using var ms = new System.IO.MemoryStream();
                await stream.CopyToAsync(ms);
                var rawBase64 = $"data:{file.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
                string base64;
                try { base64 = await JS.InvokeAsync<string>("compressImage", rawBase64, 800, 0.75); }
                catch { base64 = rawBase64; }
                var photo = new ProjectPhoto { FileName = file.Name, TakenAt = DateTime.Now };
                if (Storage.IsLoggedIn && Project != null)
                {
                    var (url, err, fileBytes) = await Storage.UploadPhotoAsync(Project.Id.ToString(), photo.Id.ToString(), base64);
                    if (err == "quota")
                    {
                        await JS.InvokeVoidAsync("showToast", "저장공간 300MB 한도를 초과했어요. 사진을 삭제하고 다시 시도해 주세요.", "error");
                        return;
                    }
                    if (!string.IsNullOrEmpty(url))
                    {
                        photo.StorageUrl = url;
                        photo.FileSizeBytes = fileBytes;
                    }
                    else
                        photo.Base64Data = base64;
                }
                else
                {
                    photo.Base64Data = base64;
                }
                Project!.Photos.Add(photo);
            }
            catch (Exception ex)
            {
                await JS.InvokeVoidAsync("showToast", $"사진 첨부 실패: {ex.Message}", "error");
                return;
            }
        }
        StateHasChanged();
    }
}
