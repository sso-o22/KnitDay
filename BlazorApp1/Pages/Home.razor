@* =====================================================================
   Pages/Home.razor  —  홈 대시보드
   ===================================================================== *@
@page "/"
@using KnitLog.Models
@using KnitLog.Services
@inject StorageService Storage
@inject AuthService Auth
@inject IJSRuntime JS
@implements IDisposable

<div class="page-header">
    <div>
        <h1 class="page-title">나의 뜨개 공간</h1>
        <p class="page-subtitle">오늘도 즐거운 뜨개질 하세요!</p>
    </div>
</div>

@* ── 로그인 배너 (프리미엄 활성화 시에만 표시) ── *@
@if (_isPremium)
{
    @if (_authLoading)
    {
        <div class="home-banner">
            <div style="font-size:0.85rem;color:var(--text-mid);">로그인 상태 확인 중...</div>
        </div>
    }
    else if (!Auth.IsLoggedIn)
    {
        <div class="home-banner">
            <div>
                <div style="font-size:0.88rem;font-weight:600;color:var(--text-dark);">여러 기기에서 동기화하세요</div>
                <div style="font-size:0.78rem;color:var(--text-mid);margin-top:2px;">구글 로그인하면 데이터가 자동으로 백업돼요</div>
            </div>
            <button class="btn btn-primary" style="white-space:nowrap;font-size:0.82rem;padding:6px 14px;flex-shrink:0;" @onclick="SignIn">
                로그인
            </button>
        </div>
    }
}

@if (_loading)
{
    <div class="loading">불러오는 중...</div>
}
else
{
    @* ── 요약 통계 카드 ── *@
    <div class="stats-grid">
        <a href="projects" class="home-stat-card" style="text-decoration:none;">
            <div class="home-stat-icon" style="background:var(--theme-pale);">
                <img src="icons/octopus.svg" class="icon-line-card" style="width:26px;height:26px;" />
            </div>
            <div>
                <div class="home-stat-num" style="color:var(--theme-active);">@_inProgress</div>
                <div class="home-stat-label">문어발</div>
            </div>
        </a>
        <a href="finished" class="home-stat-card" style="text-decoration:none;">
            <div class="home-stat-icon" style="background:var(--theme-pale);">
                <img src="icons/t-shirt.svg" class="icon-line-card" style="width:22px;height:22px;" />
            </div>
            <div>
                <div class="home-stat-num" style="color:var(--theme-active);">@_finished</div>
                <div class="home-stat-label">완성작</div>
            </div>
        </a>
        <a href="wishlist" class="home-stat-card" style="text-decoration:none;">
            <div class="home-stat-icon" style="background:var(--theme-pale);">
                <img src="icons/shooting-star.svg" class="icon-line-card" style="width:22px;height:22px;" />
            </div>
            <div>
                <div class="home-stat-num" style="color:var(--theme-active);">@_wishlist</div>
                <div class="home-stat-label">위시리스트</div>
            </div>
        </a>
        <a href="yarns" class="home-stat-card" style="text-decoration:none;">
            <div class="home-stat-icon" style="background:var(--theme-pale);">
                <img src="icons/yarn.svg" class="icon-line-card" style="width:22px;height:22px;" />
            </div>
            <div>
                <div class="home-stat-num" style="color:var(--theme-active);">@_yarns</div>
                <div class="home-stat-label">실 창고</div>
            </div>
        </a>
        <a href="swatches" class="home-stat-card" style="text-decoration:none;">
            <div class="home-stat-icon" style="background:var(--theme-pale);">
                <img src="icons/swatches.svg" class="icon-line-card" style="width:22px;height:22px;" />
            </div>
            <div>
                <div class="home-stat-num" style="color:var(--theme-active);">@_swatches</div>
                <div class="home-stat-label">스와치</div>
            </div>
        </a>
        <a href="tools" class="home-stat-card" style="text-decoration:none;">
            <div class="home-stat-icon" style="background:var(--theme-pale);">
                <img src="icons/toolbox.svg" class="icon-line-card" style="width:22px;height:22px;" />
            </div>
            <div>
                <div class="home-stat-num" style="color:var(--theme-active);">@_tools</div>
                <div class="home-stat-label">도구함</div>
            </div>
        </a>
    </div>


    @* ── 할 일 체크리스트 ── *@
    <h2 class="home-section-title">할 일</h2>
    <div class="card" style="padding:14px 16px; margin-bottom:20px;">
        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:10px;">
            <div style="display:flex; align-items:center; gap:6px;">
                <img src="icons/push-pin.svg" class="icon-line" style="width:14px;height:14px;" />
                <span style="font-size:0.82rem; font-weight:500; color:var(--text-dark);">체크리스트</span>
                @if (_todoItems.Count > 0)
                {
                    var done = _todoItems.Count(t => t.Done);
                    <span style="font-size:0.72rem; color:var(--text-light);">@done/@_todoItems.Count</span>
                }
            </div>
            <div style="display:flex; align-items:center; gap:4px;">
                @if (_todoEditMode)
                {
                    <button class="btn btn-primary btn-sm" style="font-size:0.72rem; padding:2px 8px;" @onclick="ExitTodoEditMode">완료</button>
                }
                else
                {
                    <button class="btn btn-ghost btn-sm" style="font-size:0.72rem; padding:2px 6px;" @onclick="EnterTodoEditMode"><img src="icons/pencil.svg" class="icon-line" style="width:14px;height:14px;" /> 수정</button>
                }
            </div>
        </div>

        <div>
        @foreach (var item in _todoItems)
        {
            var captured = item;
            <div @key="item.Id" data-checkid="@item.Id"
                 style="display:flex; align-items:center; gap:6px; padding:6px 0;">
                <input type="checkbox" checked="@item.Done"
                       @onchange="async () => { item.Done = !item.Done; await SaveTodos(); }"
                       style="width:14px; height:14px; accent-color:var(--theme-active); cursor:pointer; flex-shrink:0;" />
                @if (_todoEditMode)
                {
                    <div style="flex:1; min-width:0; overflow:hidden;">
                        <input class="checklist-input"
                               value="@item.Text"
                               @onchange="e => { item.Text = e.Value?.ToString() ?? item.Text; }" />
                    </div>
                    <button class="btn btn-danger btn-sm" style="padding:1px 4px; display:inline-flex;align-items:center;"
                            @onclick="async () => { _todoItems.Remove(captured); await SaveTodos(); }"><img src="icons/x.svg" class="icon-line" style="width:12px;height:12px;" /></button>
                }
                else
                {
                    <span style="flex:1; font-size:0.78rem; @(item.Done ? "text-decoration:line-through; color:var(--text-light);" : "color:var(--text-dark);")">@item.Text</span>
                }
            </div>
        }
        </div>



        @if (_addingTodo)
        {
            <div style="display:flex; align-items:center; gap:4px; margin-top:6px;">
                <div style="flex:1; min-width:0; overflow:hidden;">
                    <input class="checklist-input" @bind="_newTodoText" placeholder="할 일 입력" />
                </div>
                <button class="btn btn-primary btn-sm" style="padding:2px 6px;" @onclick="AddTodo"><img src="icons/check.svg" class="icon-line" style="width:12px;height:12px;" /></button>
            </div>
        }
        else
        {
            <button class="btn btn-ghost btn-sm" style="margin-top:6px; font-size:0.78rem; display:inline-flex;align-items:center;gap:4px;" @onclick="StartAddTodo"><img src="icons/plus.svg" class="icon-line" style="width:12px;height:12px;" />항목 추가</button>
        }
    </div>

    @* ── 홈 화면 플로팅 카운터 위젯 (드래그 가능) ── *@
    @* 드래그 캡처용 오버레이 — 조건부 렌더링하면 mousedown 직후 렌더가 늦게 반영돼서
       첫 mousemove를 놓치는 문제가 있어서, 항상 DOM에 존재시키고 pointer-events로만 껐다 켬 *@
    <div style="position:fixed;inset:0;z-index:598;touch-action:none;pointer-events:@(_hcDragging ? "auto" : "none");"
         @onmousemove="HcOnGlobalMouseMove" @onmouseup="HcOnGlobalMouseUp"
         @ontouchmove="HcOnGlobalTouchMove" @ontouchend="HcOnGlobalTouchEnd"></div>
    @if (_showHomeCounterWidget)
    {
        <div class="hc-wrap @(_hcX < 0 ? "hc-default-pos" : "")"
             style="@(_hcX >= 0 ? $"position:fixed;left:{_hcX}px;top:{_hcY}px;" : "")z-index:600;touch-action:none;"
             @onmousedown="HcDragStart">
            <div class="hc-inner" @onmousedown:stopPropagation="true" @ontouchstart:stopPropagation="true">
                <div class="hc-header" @onmousedown="HcDragStart" @ontouchstart="HcTouchStart">
                    <span style="font-size:12px;font-weight:700;">카운터</span>
                    <div style="display:flex;align-items:center;gap:4px;">
                        @if (_homeCounters.Count > 0)
                        {
                            <button class="hc-close" style="font-size:11px;font-weight:600;" @onclick="() => _homeCounterEditMode = !_homeCounterEditMode" @onmousedown:stopPropagation="true">@(_homeCounterEditMode ? "완료" : "수정")</button>
                        }
                        <button class="hc-close" @onclick="CloseHomeCounterWidget" @onmousedown:stopPropagation="true">✕</button>
                    </div>
                </div>

                @if (_homeCounters.Count > 0)
                {
                    var counter = _homeCounters[_homeCounterIndex];
                    var hasTarget = counter.Target > 0;
                    var progress = hasTarget ? Math.Min(100.0, counter.Value * 100.0 / counter.Target) : 0.0;
                    var isDone = hasTarget && counter.Value >= counter.Target;

                    <div style="display:flex;align-items:center;justify-content:space-between;gap:4px;margin-bottom:8px;" @onmousedown:stopPropagation="true">
                        <button class="hc-nav-btn" disabled="@(_homeCounters.Count < 2)" @onclick="() => MoveHomeCounter(-1)">‹</button>
                        <div style="flex:1;text-align:center;min-width:0;">
                            @if (_homeCounterEditMode)
                            {
                                <input style="width:100%;font-size:12px;padding:2px 6px;border:1px solid #ddd;border-radius:4px;text-align:center;box-sizing:border-box;"
                                       value="@counter.Label"
                                       @onchange="e => { counter.Label = e.Value?.ToString() ?? counter.Label; _ = SaveHomeCounters(); }" />
                            }
                            else
                            {
                                <div style="font-size:13px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@counter.Label</div>
                            }
                            <div style="font-size:10px;color:#aaa;">@(_homeCounterIndex + 1)/@_homeCounters.Count</div>
                        </div>
                        <button class="hc-nav-btn" disabled="@(_homeCounters.Count < 2)" @onclick="() => MoveHomeCounter(1)">›</button>
                    </div>

                    <div style="display:flex;align-items:center;gap:12px;justify-content:center;margin-bottom:8px;" @onmousedown:stopPropagation="true">
                        <button class="hc-nav-btn" style="width:36px;height:36px;font-size:18px;border-radius:50%;" @onclick="() => ChangeHomeCounterValue(counter, -counter.Step)">−</button>
                        <div style="position:relative;width:72px;height:72px;flex-shrink:0;">
                            <svg viewBox="0 0 72 72" width="72" height="72" style="transform:rotate(-90deg);">
                                <circle cx="36" cy="36" r="30" fill="none" stroke="rgba(0,0,0,0.08)" stroke-width="6" />
                                @if (hasTarget)
                                {
                                    var circ = 2 * Math.PI * 30;
                                    var dash = circ * progress / 100.0;
                                    <circle cx="36" cy="36" r="30" fill="none" stroke="var(--theme-active)"
                                            stroke-width="6" stroke-linecap="round"
                                            stroke-dasharray="@dash.ToString("F1") @circ.ToString("F1")" />
                                }
                            </svg>
                            <div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;">
                                <span style="font-size:1.3rem;font-weight:800;line-height:1;">@counter.Value</span>
                                @if (hasTarget) { <span style="font-size:0.6rem;color:#999;margin-top:1px;">/ @counter.Target</span> }
                            </div>
                        </div>
                        <button class="hc-nav-btn" style="width:36px;height:36px;font-size:18px;border-radius:50%;" @onclick="() => ChangeHomeCounterValue(counter, counter.Step)">+</button>
                    </div>

                    @if (hasTarget)
                    {
                        <div style="height:4px;background:rgba(0,0,0,0.08);border-radius:99px;margin-bottom:6px;overflow:hidden;" @onmousedown:stopPropagation="true">
                            <div style="height:100%;width:@(progress.ToString("F1"))%;background:var(--theme-active);border-radius:99px;"></div>
                        </div>
                        <div style="text-align:center;font-size:10px;color:@(isDone ? "var(--theme-active)" : "#999");margin-bottom:6px;" @onmousedown:stopPropagation="true">
                            @(isDone ? "🎉 목표 달성!" : $"{progress:F0}% ({counter.Value}/{counter.Target})")
                        </div>
                    }

                    @if (counter.LastUpdatedAt.HasValue)
                    {
                        <div style="text-align:center;font-size:10px;color:#bbb;" @onmousedown:stopPropagation="true">
                            @counter.LastUpdatedAt.Value.ToString("M.d HH:mm")
                        </div>
                    }

                    @if (_homeCounterEditMode)
                    {
                        <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;font-size:11px;color:#666;margin-top:8px;padding-top:8px;border-top:1px solid rgba(0,0,0,0.08);" @onmousedown:stopPropagation="true">
                            <span>단위</span>
                            <input type="number" style="width:40px;font-size:11px;padding:1px 4px;border:1px solid #ddd;border-radius:4px;"
                                   @bind="counter.Step" @bind:after="SaveHomeCounters" min="1" />
                            <span>목표</span>
                            <input type="number" style="width:52px;font-size:11px;padding:1px 4px;border:1px solid #ddd;border-radius:4px;"
                                   value="@(counter.Target == 0 ? "" : counter.Target.ToString())"
                                   @onchange="e => { counter.Target = int.TryParse(e.Value?.ToString(), out var t) ? t : 0; _ = SaveHomeCounters(); }"
                                   min="0" placeholder="없음" />
                            <button class="hc-nav-btn" style="width:auto;padding:2px 8px;font-size:10px;" @onclick="() => ResetHomeCounter(counter)">초기화</button>
                            <button class="hc-nav-btn" style="width:auto;padding:2px 8px;font-size:10px;color:#c0392b;" @onclick="() => RemoveHomeCounter(counter)">삭제</button>
                        </div>
                    }
                }
                else
                {
                    <div style="font-size:12px;color:#aaa;text-align:center;padding:16px 0;" @onmousedown:stopPropagation="true">
                        스와치 뜰 때처럼 가볍게 셀 카운터를 만들어보세요.
                    </div>
                }

                @if (_addingHomeCounter)
                {
                    <div style="margin-top:8px;padding-top:8px;border-top:1px solid rgba(0,0,0,0.08);" @onmousedown:stopPropagation="true">
                        <div style="display:flex;gap:4px;margin-bottom:6px;">
                            <input style="flex:1;font-size:11px;padding:3px 6px;border:1px solid #ddd;border-radius:4px;min-width:0;"
                                   @bind="_newHomeCounterLabel" placeholder="이름 (예: 스와치 단수)" @onkeydown="HcAddKeyDown" />
                            <button class="hc-nav-btn" @onclick="AddHomeCounter"><img src="icons/check.svg" class="icon-line" style="width:12px;height:12px;flex-shrink:0;" /></button>
                            <button class="hc-nav-btn" @onclick="() => _addingHomeCounter = false"><img src="icons/x.svg" class="icon-line" style="width:12px;height:12px;flex-shrink:0;" /></button>
                        </div>
                        <div style="display:flex;align-items:center;gap:6px;font-size:11px;color:#666;">
                            <span>단위</span>
                            <input type="number" style="width:40px;font-size:11px;padding:1px 4px;border:1px solid #ddd;border-radius:4px;"
                                   @bind="_newHomeCounterStep" min="1" />
                            <span>목표</span>
                            <input type="number" style="width:52px;font-size:11px;padding:1px 4px;border:1px solid #ddd;border-radius:4px;"
                                   value="@(_newHomeCounterTarget == 0 ? "" : _newHomeCounterTarget.ToString())"
                                   @onchange="e => _newHomeCounterTarget = int.TryParse(e.Value?.ToString(), out var t) ? t : 0"
                                   min="0" placeholder="없음" />
                        </div>
                    </div>
                }
                else
                {
                    <button style="width:100%;margin-top:8px;font-size:11px;color:#999;background:none;border:1px dashed #ddd;border-radius:6px;padding:5px;cursor:pointer;"
                            @onclick="StartAddingHomeCounter" @onmousedown:stopPropagation="true">+ 카운터 추가</button>
                }
            </div>
        </div>
    }
    else
    {
        <button class="hc-fab" @onclick="OpenHomeCounterWidget"><img src="icons/plus-minus.svg" class="icon-line" style="width:22px;height:22px;" /></button>
    }

    @if (_recentProjects.Count > 0)
    {
        <h2 class="home-section-title">지금 뜨고 있어요</h2>
        <div class="grid-3">
            @foreach (var proj in _recentProjects)
            {
                var isOnHold     = proj.Status == ProjectStatus.일시중단;
                var statusText   = isOnHold ? "일시중단" : "진행중";
                var statusClass  = isOnHold ? "badge badge-pause" : "badge badge-progress";

                <a href="projects/@proj.Id?from=home" class="card home-proj-card" style="text-decoration:none;display:block;">
                    @* 상단: 제목 + D-day *@
                    <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;margin-bottom:4px;">
                        <div style="display:flex;align-items:center;gap:6px;min-width:0;">
                            <div class="card-title" style="margin-bottom:0;font-size:1rem;">@proj.PatternName</div>
                            @if (proj.Sessions.Any(s => s.IsActive))
                            {
                                <span style="display:inline-flex;align-items:center;gap:3px;font-size:0.65rem;font-weight:700;color:#c0392b;background:#fef0f0;border:1px solid #f5c0c0;border-radius:20px;padding:2px 7px;flex-shrink:0;white-space:nowrap;">
                                    <img src="icons/record.svg" class="icon-line" style="width:10px;height:10px;filter:none;" />뜨는 중
                                </span>
                            }
                        </div>
                        @if (proj.EndDate.HasValue)
                        {
                            var days = (proj.EndDate.Value.Date - DateTime.Today).Days;
                            var (ddayText, ddayColor, ddayBg) = days switch
                            {
                                < 0   => ($"D+{-days}", "var(--text-light)", "var(--ivory-mid)"),
                                0     => ("D-Day",      "#c03030",            "#fff0f0"),
                                <= 7  => ($"D-{days}",  "#c03030",            "#fff0f0"),
                                _     => ($"D-{days}",  "var(--theme-active)","var(--theme-pale)")
                            };
                            <span style="font-size:0.72rem;font-weight:700;color:@ddayColor;
                                         background:@ddayBg;border-radius:20px;
                                         padding:2px 8px;white-space:nowrap;flex-shrink:0;">@ddayText</span>
                        }
                    </div>



                    @* 진행률 바 (시작일~마감일 기반, 둘 다 없으면 숨김) *@
                    @if (proj.StartDate.HasValue && proj.EndDate.HasValue)
                    {
                        var total   = (proj.EndDate.Value - proj.StartDate.Value).TotalDays;
                        var elapsed = (DateTime.Today    - proj.StartDate.Value).TotalDays;
                        var pct     = total > 0 ? Math.Clamp(elapsed / total * 100, 0, 100) : 0;
                        <div style="background:var(--ivory-mid);border-radius:4px;height:4px;margin-bottom:10px;overflow:hidden;">
                            <div style="height:4px;border-radius:4px;width:@(pct.ToString("F0"))%;background:var(--theme-light);transition:width 0.3s;"></div>
                        </div>
                    }

                    @* 하단: 시작일 + 상태 칩 *@
                    <div style="display:flex;align-items:center;justify-content:space-between;">
                        <span style="font-size:0.78rem;color:var(--text-light);">
                            @(proj.StartDate.HasValue ? proj.StartDate.Value.ToString("yyyy.MM.dd") + " 시작" : "")
                        </span>
                        <span class="@statusClass">@statusText</span>
                    </div>
                </a>
            }
        </div>
    }
    else
    {
        <div class="card" style="display:flex;flex-direction:column;align-items:center;padding:40px;">
            <div style="margin-bottom:16px;opacity:0.35;">
                <img src="icons/octopus.svg" class="icon-line-card" style="width:56px;height:56px;" />
            </div>
            <p style="color:var(--text-mid);margin-bottom:16px;">아직 진행중인 프로젝트가 없어요.</p>
            <a href="projects" class="btn btn-primary">첫 문어발 만들기</a>
        </div>
    }
}

<style>
    /* ── 로그인 배너 ── */
    .home-banner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 12px 16px;
        border-radius: var(--radius);
        margin-bottom: 20px;
        background: var(--theme-pale);
        border: 1.5px solid var(--theme-mid);
    }

    /* ── 통계 카드 (아이콘 + 숫자 가로 배치) ── */
    .home-stat-card {
        background: var(--white);
        border-radius: var(--radius);
        border: 1px solid var(--border);
        padding: 14px 16px;
        display: flex;
        align-items: center;
        gap: 12px;
        box-shadow: 0 2px 8px var(--shadow);
        transition: box-shadow 0.18s ease, transform 0.18s ease;
    }
    .home-stat-card:hover {
        box-shadow: 0 6px 20px var(--shadow-md);
        transform: translateY(-2px);
    }
    .home-stat-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .home-stat-num {
        font-size: 1.5rem;
        font-weight: 700;
        line-height: 1;
    }
    .home-stat-label {
        font-size: 0.78rem;
        color: var(--text-mid);
        margin-top: 3px;
    }

    /* ── 섹션 타이틀 ── */
    .home-section-title {
        font-family: 'DM Sans', 'Noto Sans KR', sans-serif;
        font-size: 1rem;
        font-weight: 600;
        color: var(--text-mid);
        margin: 24px 0 12px;
        letter-spacing: 0.02em;
