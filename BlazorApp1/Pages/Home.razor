</style>

@code {
    async Task SignIn() => await Auth.SignInWithGoogleAsync();


    // ── 할 일 체크리스트 ──
    class TodoItem
    {
        public Guid Id { get; set; } = Guid.NewGuid();
        public string Text { get; set; } = "";
        public bool Done { get; set; } = false;
    }
    List<TodoItem> _todoItems = new();
    bool _saving = false;
    bool _checklistExpanded = true;
    bool _todoEditMode = false;
    bool _addingTodo = false;
    string _newTodoText = "";
    Guid? _editingTodoId = null;
    string _editingTodoText = "";

    async Task LoadTodos()
    {
        var json = await JS.InvokeAsync<string?>("knitDB.getData", "knitlog_todos");
        if (!string.IsNullOrEmpty(json))
            try { _todoItems = System.Text.Json.JsonSerializer.Deserialize<List<TodoItem>>(json) ?? new(); } catch { }
    }
    async Task SaveTodos()
    {
        _saving = true; StateHasChanged();
        var json = System.Text.Json.JsonSerializer.Serialize(_todoItems);
        await Storage.SaveTodosAsync(json);
        _saving = false;
        StateHasChanged();
        await JS.InvokeVoidAsync("showToast", "저장됐어요");
    }
    async Task AddTodo()
    {
        if (string.IsNullOrWhiteSpace(_newTodoText)) return;
        _todoItems.Add(new TodoItem { Text = _newTodoText.Trim() });
        _newTodoText = "";
        _addingTodo = false;
        await SaveTodos();
    }

    // ── 홈 화면 독립 카운터 (프로젝트에 안 묶인, 스와치 등에 쓰는 가벼운 플로팅 카운터) ──
    List<HomeCounter> _homeCounters = new();
    int _homeCounterIndex = 0;
    bool _showHomeCounterWidget = false;
    bool _homeCounterEditMode = false;
    bool _addingHomeCounter = false;
    string _newHomeCounterLabel = "";
    int _newHomeCounterStep = 1;
    int _newHomeCounterTarget = 0;

    void StartAddingHomeCounter()
    {
        _addingHomeCounter = true;
        _newHomeCounterLabel = "";
        _newHomeCounterStep = 1;
        _newHomeCounterTarget = 0;
    }

    // 드래그 위치 (기기별 localStorage에 저장 — 위젯 열림 상태도 같이 저장)
    double _hcX = -1, _hcY = -1;
    bool _hcDragging = false;
    double _hcOffX = 0, _hcOffY = 0;

    async Task LoadHomeCounters()
    {
        var json = await JS.InvokeAsync<string?>("knitDB.getData", "knitlog_home_counters");
        if (!string.IsNullOrEmpty(json))
            try { _homeCounters = System.Text.Json.JsonSerializer.Deserialize<List<HomeCounter>>(json) ?? new(); } catch { }
        if (_homeCounterIndex >= _homeCounters.Count) _homeCounterIndex = Math.Max(0, _homeCounters.Count - 1);

        var shown = await JS.InvokeAsync<string?>("localStorage.getItem", "knitday_home_counter_shown");
        _showHomeCounterWidget = shown == "1";
        var xStr = await JS.InvokeAsync<string?>("localStorage.getItem", "knitday_home_counter_x");
        var yStr = await JS.InvokeAsync<string?>("localStorage.getItem", "knitday_home_counter_y");
        if (double.TryParse(xStr, out var x) && double.TryParse(yStr, out var y)) { _hcX = x; _hcY = y; }
    }

    async Task SaveHomeCounters()
    {
        var json = System.Text.Json.JsonSerializer.Serialize(_homeCounters);
        await Storage.SaveHomeCountersAsync(json);
        StateHasChanged();
    }

    async Task SaveHomeCounterWidgetPrefs()
    {
        await JS.InvokeVoidAsync("localStorage.setItem", "knitday_home_counter_shown", _showHomeCounterWidget ? "1" : "0");
        if (_hcX >= 0)
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "knitday_home_counter_x", _hcX.ToString());
            await JS.InvokeVoidAsync("localStorage.setItem", "knitday_home_counter_y", _hcY.ToString());
        }
    }

    async Task OpenHomeCounterWidget() { _showHomeCounterWidget = true; await SaveHomeCounterWidgetPrefs(); }
    async Task CloseHomeCounterWidget() { _showHomeCounterWidget = false; await SaveHomeCounterWidgetPrefs(); }

    void HcDragStart(MouseEventArgs e)
    {
        if (_hcX < 0) { _hcX = 16; _hcY = 400; } // 기본 위치(우하단 고정)에서 드래그 시작하면 좌표를 실좌표로 전환
        _hcDragging = true;
        _hcOffX = e.ClientX - _hcX;
        _hcOffY = e.ClientY - _hcY;
    }
    void HcTouchStart(TouchEventArgs e)
    {
        if (_hcX < 0) { _hcX = 16; _hcY = 400; }
        _hcDragging = true;
        _hcOffX = e.Touches[0].ClientX - _hcX;
        _hcOffY = e.Touches[0].ClientY - _hcY;
    }
    void HcOnGlobalMouseMove(MouseEventArgs e)
    {
        if (_hcDragging) { _hcX = e.ClientX - _hcOffX; _hcY = e.ClientY - _hcOffY; StateHasChanged(); }
    }
    async Task HcOnGlobalMouseUp(MouseEventArgs e)
    {
        if (_hcDragging) { _hcDragging = false; await SaveHomeCounterWidgetPrefs(); StateHasChanged(); }
    }
    void HcOnGlobalTouchMove(TouchEventArgs e)
    {
        if (_hcDragging && e.Touches.Length > 0) { _hcX = e.Touches[0].ClientX - _hcOffX; _hcY = e.Touches[0].ClientY - _hcOffY; StateHasChanged(); }
    }
    async Task HcOnGlobalTouchEnd(TouchEventArgs e)
    {
        if (_hcDragging) { _hcDragging = false; await SaveHomeCounterWidgetPrefs(); StateHasChanged(); }
    }

    void MoveHomeCounter(int delta)
    {
        if (_homeCounters.Count == 0) return;
        _homeCounterIndex = (_homeCounterIndex + delta + _homeCounters.Count) % _homeCounters.Count;
    }

    async Task ChangeHomeCounterValue(HomeCounter counter, int delta)
    {
        counter.Value = Math.Max(0, counter.Value + delta);
        counter.LastUpdatedAt = DateTime.Now;
        await SaveHomeCounters();
    }

    async Task ResetHomeCounter(HomeCounter counter)
    {
        counter.Value = 0;
        counter.LastUpdatedAt = DateTime.Now;
        await SaveHomeCounters();
    }

    bool _addingHomeCounterInFlight = false;
    async Task AddHomeCounter()
    {
        if (string.IsNullOrWhiteSpace(_newHomeCounterLabel)) return;
        if (_addingHomeCounterInFlight) return; // 연타로 카운터가 중복 생성되는 것 방지
        _addingHomeCounterInFlight = true;
        try
        {
            _homeCounters.Add(new HomeCounter
            {
                Label = _newHomeCounterLabel.Trim(),
                Step = _newHomeCounterStep > 0 ? _newHomeCounterStep : 1,
                Target = Math.Max(0, _newHomeCounterTarget)
            });
            _homeCounterIndex = _homeCounters.Count - 1;
            _newHomeCounterLabel = "";
            _newHomeCounterStep = 1;
            _newHomeCounterTarget = 0;
            _addingHomeCounter = false;
            await SaveHomeCounters();
        }
        finally { _addingHomeCounterInFlight = false; }
    }

    async Task HcAddKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddHomeCounter();
        else if (e.Key == "Escape") { _addingHomeCounter = false; _newHomeCounterLabel = ""; }
    }

    async Task RemoveHomeCounter(HomeCounter counter)
    {
        _homeCounters.Remove(counter);
        if (_homeCounterIndex >= _homeCounters.Count) _homeCounterIndex = Math.Max(0, _homeCounters.Count - 1);
        await SaveHomeCounters();
    }
    async Task SaveTodoLabel(TodoItem item)
    {
        if (!string.IsNullOrWhiteSpace(_editingTodoText))
            item.Text = _editingTodoText.Trim();
        _editingTodoId = null;
        await SaveTodos();
    }

    void EnterTodoEditMode() { _todoEditMode = true; _editingTodoId = null; }
    async Task ExitTodoEditMode() { _todoEditMode = false; _editingTodoId = null; _addingTodo = false; await SaveTodos(); }
    void CancelTodoEdit() { _editingTodoId = null; _editingTodoText = ""; }
    void StartAddTodo() { _addingTodo = true; }

    // 인증 상태 변경 콜백 — 로딩 플래그 해제 (데이터 재로딩은 sync 완료 후)
    void OnAuthChanged()
    {
        _authLoading = false;
        InvokeAsync(StateHasChanged);
    }

    // 동기화 완료 콜백 — sync 완료 후 데이터 재로딩
    async void OnSyncCompleted()
    {
        await LoadDataAsync();
        // 수정 모드 중엔 덮어쓰지 않음 (작업 중 데이터 날아가는 것 방지)
        if (!_todoEditMode)
            await LoadTodos();
        if (!_homeCounterEditMode)
            await LoadHomeCounters();
        await InvokeAsync(StateHasChanged);
    }

    bool _loading = true;
    bool _authLoading = true; // Firebase 세션 복원 대기 중
    bool _isPremium = false;

    int _inProgress, _finished, _wishlist, _yarns, _swatches, _tools;
    List<KnitProject> _recentProjects = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var p = await JS.InvokeAsync<string?>("localStorage.getItem", "knitday_premium");
            _isPremium = p == "1";
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Auth.OnAuthChanged += OnAuthChanged;
        Storage.OnSyncCompleted += OnSyncCompleted;
        await LoadTodos();
        await LoadHomeCounters();
        // Firebase 초기화 완료 대기 (최대 6초)
        if (!Auth.IsInitialized)
        {
            var waited = 0;
            while (!Auth.IsInitialized && waited < 60) { await Task.Delay(100); waited++; }
        }
        _authLoading = false;
        await LoadDataAsync();
    }

    // 데이터 로딩 로직을 별도 메서드로 분리
    async Task LoadDataAsync()
    {
        _loading = true;
        await InvokeAsync(StateHasChanged);

        var projects = await Storage.GetProjectsAsync();
        _inProgress = projects.Count(p => p.Status == ProjectStatus.진행중 || p.Status == ProjectStatus.일시중단);
        _finished   = projects.Count(p => p.Status == ProjectStatus.완료);
        _wishlist   = projects.Count(p => p.Status == ProjectStatus.위시리스트);
        _recentProjects = projects
            .Where(p => p.Status == ProjectStatus.진행중 || p.Status == ProjectStatus.일시중단)
            .OrderByDescending(p => p.UpdatedAt)
            .Take(3)
            .ToList();

        var yarns = await Storage.GetYarnsAsync();
        _yarns = yarns.Count;
        var swatches = await Storage.GetSwatchesAsync();
        _swatches = swatches.Count;
        var tools = await Storage.GetToolsAsync();
        _tools = tools.Count;

        _loading = false;
    }

    public void Dispose()
    {
        Auth.OnAuthChanged -= OnAuthChanged;
        Storage.OnSyncCompleted -= OnSyncCompleted;
    }
}
