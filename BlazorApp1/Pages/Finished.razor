@* =====================================================================
   Pages/Finished.razor  —  완성작 갤러리
   ===================================================================== *@
@page "/finished"
@using KnitLog.Models
@using KnitLog.Services
@inject StorageService Storage
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="page-header">
    <div>
        <h1 class="page-title"><img src="icons/t-shirt.svg" class="icon-line" style="width:36px;height:36px;" />완성작</h1>
        <p class="page-subtitle">지금까지 완성한 작품들</p>
    </div>
    <button class="btn btn-primary" @onclick="OpenAddCompleted" style="display:inline-flex;align-items:center;gap:5px;"><img src="icons/plus.svg" class="icon-line" style="width:14px;height:14px;flex-shrink:0;" />완성작 추가</button>
</div>

@if (_loading)
{
    <div class="loading">불러오는 중...</div>
}
else if (_projects.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon"><img src="icons/t-shirt.svg" class="icon-line" style="width:48px;height:48px;" /></div>
        <p>아직 완성작이 없어요.<br/>뜨케줄에서 작품을 완성하면 여기로 이동하거나, 직접 등록할 수 있어요!</p>
        <button class="btn btn-primary" @onclick="OpenAddCompleted" style="margin-top:12px; display:inline-flex;align-items:center;gap:5px;"><img src="icons/plus.svg" class="icon-line" style="width:14px;height:14px;flex-shrink:0;" />완성작 추가</button>
    </div>
}
else
{
    <div class="filter-sort-bar swatch-filter-bar" style="margin-bottom:16px;">
        <div class="filter-sort-group">
            <img src="icons/arrows-down-up.svg" class="icon-line" style="width:14px;height:14px;flex-shrink:0;opacity:0.45;" />
            @foreach (var (label, baseVal) in new[]{("시작일","start"),("완성일","end"),("이름순","name")})
            {
                var ascVal  = baseVal + "_asc";
                var descVal = baseVal + "_desc";
                var isActive = _finSort == ascVal || _finSort == descVal;
                var isAsc   = _finSort == ascVal;
                <button class="btn btn-sm @(isActive?"btn-sage":"btn-ghost")" style="flex-shrink:0;"
                        @onclick="async () => await SetFinSort(isActive ? (isAsc ? descVal : ascVal) : descVal)">
                    @label @if (isActive) { <img src="@(isAsc?"icons/arrow-up.svg":"icons/arrow-down.svg")" class="icon-line" style="width:11px;height:11px;margin-left:2px;" /> }
                </button>
            }
        </div>
        <div class="filter-sort-divider"></div>
        <div class="filter-sort-group swatch-needle-wrapper">
            <select class="form-control swatch-needle-select" style="flex-shrink:0;" @bind="_finCategory" @bind:after="SetFinCategory">
                <option value="all">전체 카테고리</option>
                @foreach (var cat in Enum.GetValues<ProjectCategory>())
                {
                    <option value="@cat.ToString()">@cat</option>
                }
            </select>
        </div>
    </div>
    <div class="grid-3">
        @foreach (var proj in SortedProjects)
        {
            <div class="card" style="cursor:pointer;" @onclick="() => OpenDetail(proj)">
                @if (proj.Photos.Count > 0 && proj.Photos.Any(p => !string.IsNullOrEmpty(p.Base64Data) || !string.IsNullOrEmpty(p.StorageUrl)))
                {
                    <div style="width:100%; aspect-ratio:4/3; border-radius:var(--radius-sm); overflow:hidden; margin-bottom:12px; background:var(--ivory-dark);">
                        <img src="@(!string.IsNullOrEmpty(proj.Photos[0].StorageUrl) ? proj.Photos[0].StorageUrl : proj.Photos[0].Base64Data)"
                             style="width:100%; height:100%; object-fit:cover; display:block;"
                             alt="완성 사진" />
                    </div>
                }
                else
                {
                }
                <div class="card-title">@proj.PatternName</div>
                @if (proj.EndDate.HasValue)
                {
                    <div style="font-size:0.78rem; color:var(--text-light); margin-top:6px;">
                        완성일: @proj.EndDate.Value.ToString("yyyy년 M월 d일")
                    </div>
                }
                @if (proj.StartDate.HasValue && proj.EndDate.HasValue)
                {
                    var days = (proj.EndDate.Value - proj.StartDate.Value).Days;
                    <div style="font-size:0.78rem; color:#8a6a08; margin-top:2px;">총 @(days)일 소요</div>
                }
            </div>
        }
    </div>
}

<!-- 상세 팝업 (CompletedPopup 컴포넌트) -->
<CompletedPopup Show="_showDetail" Project="_selectedProject"
    Yarns="_allYarns" Tools="_allTools" AllSwatches="_allSwatches" AllProjects="_projects"
    StartInEditMode="_addingCompleted"
    OnClose="CloseDetail" OnSaved="OnPopupSaved"
    OnDelete="DeleteFromPopup" OnMoveBack="MoveBackFromPopup"
    OnDeletePdf="DeletePdfFromFinished" />


@code {
    bool _loading = true;
    bool _showDetail = false;
    List<KnitProject> _projects = new();
    string _finSort = "end_desc";
    string _finCategory = "all";
    IEnumerable<KnitProject> FilteredProjects =>
        _finCategory == "all" ? _projects : _projects.Where(p => p.Category.ToString() == _finCategory);
    IEnumerable<KnitProject> SortedProjects => _finSort switch
    {
        "start_asc"  => FilteredProjects.OrderBy(p => p.StartDate),
        "start_desc" => FilteredProjects.OrderByDescending(p => p.StartDate),
        "end_asc"   => FilteredProjects.OrderBy(p => p.EndDate),
        "name_asc"  => FilteredProjects.OrderBy(p => p.PatternName),
        "name_desc" => FilteredProjects.OrderByDescending(p => p.PatternName),
        _           => FilteredProjects.OrderByDescending(p => p.EndDate),
    };
    KnitProject? _selectedProject;
    bool _addingCompleted = false;
    List<Yarn> _allYarns = new();
    List<KnitTool> _allTools = new();
    List<Swatch> _allSwatches = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        _finSort     = await JS.InvokeAsync<string?>("localStorage.getItem", "fin_sort") ?? "end_desc";
        _finCategory = await JS.InvokeAsync<string?>("localStorage.getItem", "fin_category") ?? "all";
        _loading = false;
    }

    async Task SetFinSort(string val)
    {
        _finSort = val;
        await JS.InvokeVoidAsync("localStorage.setItem", "fin_sort", val);
    }

    async Task SetFinCategory()
    {
        await JS.InvokeVoidAsync("localStorage.setItem", "fin_category", _finCategory);
    }

    async Task LoadData()
    {
        var all = await Storage.GetProjectsAsync();
        _projects = all.Where(p => p.Status == ProjectStatus.완료)
                       .OrderByDescending(p => p.EndDate)
                       .ToList();
        _allYarns = await Storage.GetYarnsAsync();
        _allTools = await Storage.GetToolsAsync();
        _allSwatches = await Storage.GetSwatchesAsync();
    }

    void OpenDetail(KnitProject proj)
    {
        // 취소 시 원본이 오염되지 않도록 JSON 딥카피해서 편집 (저장 버튼을 눌러야만 실제 반영됨)
        var json = System.Text.Json.JsonSerializer.Serialize(proj);
        _selectedProject = System.Text.Json.JsonSerializer.Deserialize<KnitProject>(json)!;
        _addingCompleted = false;
        _showDetail = true;
    }

    void OpenAddCompleted()
    {
        // 프로젝트 과정 없이, 완성작만 바로 등록 (CompletedPopup을 새 항목 등록용으로 재사용)
        // ID를 미리 발급해둬야 편집 중 업로드하는 사진이 올바른 폴더로 저장됨
        _selectedProject = new KnitProject
        {
            Id = Guid.NewGuid(),
            Status = ProjectStatus.완료,
            StartDate = DateTime.Today,
            EndDate = DateTime.Today,
        };
        _addingCompleted = true;
        _showDetail = true;
    }

    void CloseDetail()
    {
        _showDetail = false;
        _selectedProject = null;
        _addingCompleted = false;
    }

    async Task OnPopupSaved()
    {
        await LoadData();
        // 선택된 프로젝트 갱신
        if (_selectedProject != null)
            _selectedProject = _projects.FirstOrDefault(p => p.Id == _selectedProject.Id) ?? _selectedProject;
        _addingCompleted = false; // 저장 후엔 StartInEditMode를 계속 유지할 필요 없음 (재렌더 시 다시 수정모드로 강제되는 것 방지)
    }

    async Task MoveBackFromPopup()
    {
        if (_selectedProject == null) return;
        _selectedProject.Status = ProjectStatus.진행중;
        _selectedProject.EndDate = null;
        await Storage.SaveProjectAsync(_selectedProject);
        CloseDetail();
        Nav.NavigateTo("projects");
    }

    async Task DeleteFromPopup()
    {
        if (_selectedProject == null) return;
        var id = _selectedProject.Id;
        CloseDetail();
        await JS.InvokeVoidAsync("showToast", "삭제하는 중...", "info");
        await Storage.DeleteProjectAsync(id);
        await LoadData();
    }

    async Task DeletePdfFromFinished()
    {
        if (_selectedProject == null) return;
        try
        {
            await JS.InvokeAsync<bool>("patternViewer.deleteSavedPdf", _selectedProject.Id.ToString());
            if (!string.IsNullOrEmpty(_selectedProject.PatternCloudUrl))
                await Storage.DeletePdfAsync(_selectedProject.Id.ToString(), _selectedProject.PatternFileSizeBytes);
            _selectedProject.HasSavedPattern = false;
            _selectedProject.PatternFileName = "";
            _selectedProject.PatternCloudUrl = "";
            _selectedProject.PatternFileSizeBytes = 0;
            await Storage.SaveProjectAsync(_selectedProject);
            await JS.InvokeVoidAsync("showToast", "도안 파일을 삭제했어요");
        }
        catch
        {
            await JS.InvokeVoidAsync("showToast", "도안 삭제에 실패했어요", "error");
        }
    }
}
