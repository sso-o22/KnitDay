@inherits LayoutComponentBase
@using KnitLog.Models
@using KnitLog.Services
@inject StorageService Storage
@inject AuthService Auth
@inject IJSRuntime JS
@inject HttpClient Http
@inject NavigationManager Nav
@implements IAsyncDisposable

<div class="app-shell">
    <nav class="sidebar">
        <div class="sidebar-brand" style="position:relative;">
            <img src="images/logo.png" class="sidebar-logo" alt="KnitLog" />
            @if (_syncStatus == "syncing")
            {
                <span style="position:absolute;bottom:4px;right:4px;"><img src="icons/cloud-arrow-up.svg" class="icon-line" style="width:14px;height:14px;opacity:0.7;animation:pulse 1s infinite;" /></span>
            }
            else if (_syncStatus == "done")
            {
                <span style="position:absolute;bottom:4px;right:4px;"><img src="icons/cloud-check.svg" class="icon-line" style="width:14px;height:14px;opacity:0.6;" /></span>
            }
        </div>

        <ul class="nav-list">
            <li><NavLink href="" Match="NavLinkMatch.All" class="nav-item"><span class="nav-icon"><img src="icons/house-line.svg" class="icon-line" style="width:20px;height:20px;" /></span><span class="nav-label">홈</span></NavLink></li>
            <li><NavLink href="schedule" class="nav-item"><span class="nav-icon"><img src="icons/calendar-dots.svg" class="icon-line" style="width:20px;height:20px;" /></span><span class="nav-label">뜨케줄</span></NavLink></li>
            <li><NavLink href="projects" class="nav-item"><span class="nav-icon"><img src="icons/octopus.svg" class="icon-line" style="width:24px;height:24px;" /></span><span class="nav-label">문어발</span></NavLink></li>
            <li><NavLink href="finished" class="nav-item"><span class="nav-icon"><img src="icons/t-shirt.svg" class="icon-line" style="width:20px;height:20px;" /></span><span class="nav-label">완성작</span></NavLink></li>
            <li><NavLink href="wishlist" class="nav-item"><span class="nav-icon"><img src="icons/shooting-star.svg" class="icon-line" style="width:20px;height:20px;" /></span><span class="nav-label">위시리스트</span></NavLink></li>
            <li><NavLink href="yarns" class="nav-item"><span class="nav-icon"><img src="icons/yarn.svg" class="icon-line" style="width:20px;height:20px;" /></span><span class="nav-label">실 창고</span></NavLink></li>
            <li><NavLink href="swatches" class="nav-item"><span class="nav-icon"><img src="icons/swatches.svg" class="icon-line" style="width:20px;height:20px;" /></span><span class="nav-label">스와치</span></NavLink></li>
            <li><NavLink href="tools" class="nav-item"><span class="nav-icon"><img src="icons/toolbox.svg" class="icon-line" style="width:20px;height:20px;" /></span><span class="nav-label">도구</span></NavLink></li>
            <li><NavLink href="stats" class="nav-item"><span class="nav-icon"><img src="icons/chart-bar.svg" class="icon-line" style="width:20px;height:20px;" /></span><span class="nav-label">통계</span></NavLink></li>
            <li><NavLink href="settings" class="nav-item"><span class="nav-icon"><img src="icons/gear.svg" class="icon-line" style="width:20px;height:20px;" /></span><span class="nav-label">설정</span></NavLink></li>
        </ul>

        <!-- 사이드바 하단 통계 + 다크 토글 -->
        <div class="sidebar-stats">
            <div class="sidebar-stat-row">
                <span><img src="icons/check-square.svg" class="icon-line" style="width:16px;height:16px;margin-right:4px;" /> 완성작</span>
                <strong>@(_finished)개</strong>
            </div>
            <div class="sidebar-stat-row">
                <span><img src="icons/clock.svg" class="icon-line" style="width:16px;height:16px;margin-right:4px;" /> 오늘</span>
                <strong>@_todayTime</strong>
            </div>
            <div class="sidebar-dark-toggle" @onclick="ToggleDark" title="@(_isDark ? "라이트 모드" : "다크 모드")">
                @if (_isDark)
                {
                    <img src="icons/sun.svg" class="icon-line" style="width:24px;height:24px;" />
                }
                else
                {
                    <img src="icons/moon.svg" class="icon-line" style="width:24px;height:24px;" />
                }
            </div>
        </div>
    </nav>

    <main class="main-content">@Body</main>

    @* 클라우드 마이그레이션 진행률 오버레이 *@
    @if (_migration != null && (_migration.IsRunning || _migration.Total > 0))
    {
        <div style="position:fixed;bottom:80px;left:50%;transform:translateX(-50%);z-index:8000;
                    background:var(--white);border-radius:16px;padding:16px 20px;
                    box-shadow:0 8px 32px rgba(0,0,0,0.18);min-width:260px;max-width:320px;width:90%;">
            <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;">
                <img src="icons/cloud-arrow-up.svg" class="icon-line @(_migration.IsRunning ? "migration-pulse" : "")" style="width:18px;height:18px;flex-shrink:0;" />
                <span style="font-size:0.88rem;font-weight:700;color:var(--text-dark);flex:1;">
                    @if (_migration.IsRunning)
                    {
                        <span>클라우드 이전 중...</span>
                    }
                    else if (_migration.QuotaReached)
                    {
                        <span>저장공간 한도 초과</span>
                    }
                    else if (_migration.Failed > 0)
                    {
                        <span>이전 완료 (일부 실패)</span>
                    }
                    else
                    {
                        <span>클라우드 이전 완료 ✓</span>
                    }
                </span>
                <span style="font-size:0.8rem;font-weight:600;color:var(--theme-active);">@(_migration.Percent)%</span>
            </div>
            @* 게이지바 *@
            <div style="height:6px;background:var(--border);border-radius:99px;overflow:hidden;margin-bottom:8px;">
                <div style="height:100%;width:@(_migration.Percent)%;border-radius:99px;transition:width 0.4s;
                            background:@(_migration.QuotaReached ? "#c03030" : _migration.Failed > 0 ? "#e6a817" : "var(--theme-active)");"></div>
            </div>
            <div style="font-size:0.75rem;color:var(--text-light);display:flex;justify-content:space-between;">
                @if (_migration.IsRunning && !string.IsNullOrEmpty(_migration.CurrentLabel))
                {
                    <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:180px;">↑ @_migration.CurrentLabel</span>
                }
                @if (_migration.IsRunning)
                {
                    <div style="font-size:0.73rem;color:var(--text-light);margin-top:6px;line-height:1.5;">
                        완료될 때까지 다른 앱으로 이동하거나 종료하지 말아 주세요.<br />
                        사진·도안이 많을수록 시간이 걸려요.
                    </div>
                }
                else if (_migration.QuotaReached)
                {
                    <span style="color:#c03030;">@(Storage.PerUserLimitBytes >= 1024L*1024*1024 ? $"{Storage.PerUserLimitBytes/1024.0/1024/1024:F0}GB" : $"{Storage.PerUserLimitBytes/1024.0/1024:F0}MB") 한도에 도달했어요</span>
                }
                else if (_migration.Failed > 0)
                {
                    <span>@(_migration.Failed)개 실패 — 로컬에 보존됨</span>
                }
                else if (!_migration.IsRunning)
                {
                    <span>사진·도안이 클라우드에 저장됐어요</span>
                }
                <span style="flex-shrink:0;">@(_migration.Done)/@(_migration.Total)</span>
            </div>
        </div>
    }

    @* 업데이트 알림 토스트 *@
    @if (_showUpdateToast)
    {

    @* 홈화면 추가 안내 팝업 *@
    @if (_showInstallGuide)
    {
        <div style="position:fixed;inset:0;background:rgba(0,0,0,0.45);z-index:99999;display:flex;align-items:flex-end;justify-content:center;padding-bottom:env(safe-area-inset-bottom,0px);">
            <div style="background:var(--white);border-radius:20px 20px 0 0;padding:24px 20px 28px;width:100%;max-width:480px;box-shadow:0 -4px 32px rgba(0,0,0,0.18);"
                 @onclick:stopPropagation="true">
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;">
                    <img src="icon-192.png" style="width:44px;height:44px;border-radius:12px;flex-shrink:0;" />
                    <div>
                        <div style="font-weight:700;font-size:1rem;color:var(--text-dark);">KnitDay를 홈 화면에 추가하세요</div>
                        <div style="font-size:0.8rem;color:var(--text-mid);margin-top:2px;">앱처럼 빠르고 편하게 사용할 수 있어요</div>
                    </div>
                </div>
                @if (!_isAndroidInstall)
                {
                    @* iOS Safari 수동 안내 *@
                    <div style="background:var(--ivory-dark);border-radius:12px;padding:14px 16px;margin-bottom:16px;font-size:0.85rem;color:var(--text-mid);line-height:1.7;">
                        <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;">
                            <span style="font-size:1.1rem;">①</span>
                            <span>하단 <strong style="color:var(--text-dark);">공유 버튼</strong> <img src="icons/export.svg" class="icon-line" style="width:15px;height:15px;display:inline;vertical-align:middle;opacity:0.7;" /> 클릭</span>
                        </div>
                        <div style="display:flex;align-items:center;gap:8px;">
                            <span style="font-size:1.1rem;">②</span>
                            <span><strong style="color:var(--text-dark);">"홈 화면에 추가"</strong> 선택</span>
                        </div>
                    </div>
                }
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:16px;cursor:pointer;" @onclick="ToggleNeverShowInstall">
                    @{
                        var chkBorder = _neverShowInstall ? "var(--theme-active)" : "var(--border)";
                        var chkBg = _neverShowInstall ? "var(--theme-active)" : "transparent";
                    }
                    <div style="width:18px;height:18px;border-radius:4px;border:1.5px solid @chkBorder;background:@chkBg;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:all 0.15s;">
                        @if (_neverShowInstall)
                        {
                            <img src="icons/check.svg" class="icon-line" style="width:11px;height:11px;filter:invert(1);opacity:1;" />
                        }
                    </div>
                    <span style="font-size:0.82rem;color:var(--text-mid);">다시는 열지 않음</span>
                </div>
                @if (_isAndroidInstall)
                {
                    <div style="display:flex;gap:10px;">
                        <button class="btn btn-secondary" style="flex:1;justify-content:center;padding:12px;"
                                @onclick="DismissInstallGuide">닫기</button>
                        <button class="btn btn-primary" style="flex:1;justify-content:center;padding:12px;"
                                @onclick="TriggerAndroidInstall">홈 화면에 추가</button>
                    </div>
                }
                else
                {
                    <button class="btn btn-primary" style="width:100%;justify-content:center;padding:12px;"
                            @onclick="DismissInstallGuide">닫기</button>
                }
            </div>
        </div>
    }
        <div style="position:fixed;bottom:calc(env(safe-area-inset-bottom,0px) + 80px);left:50%;transform:translateX(-50%);z-index:99990;
                    background:var(--white);border-radius:14px;padding:10px 16px;
                    box-shadow:0 4px 20px rgba(0,0,0,0.16);display:flex;align-items:center;gap:10px;
                    cursor:pointer;white-space:nowrap;border:1px solid var(--border);"
             @onclick="OnUpdateToastClick">
            <img src="icons/rocket-launch.svg" class="icon-line" style="width:16px;height:16px;flex-shrink:0;" />
            <span style="font-size:0.83rem;font-weight:600;color:var(--text-dark);">KnitDay @_newVersion 업데이트됐어요! 앱을 재실행해 주세요.</span>
            <button style="background:none;border:none;padding:0;cursor:pointer;display:flex;align-items:center;"
                    @onclick:stopPropagation="true" @onclick="DismissUpdateToast">
                <img src="icons/x.svg" class="icon-line" style="width:13px;height:13px;opacity:0.4;" />
            </button>
        </div>
    }

    <nav class="bottom-nav">
        @if (_syncStatus == "syncing")
        {
            <span class="bottom-nav-sync" style="position:absolute;top:4px;right:8px;pointer-events:none;"><img src="icons/cloud-arrow-up.svg" class="icon-line" style="width:14px;height:14px;opacity:0.8;animation:pulse 1s infinite;" /></span>
        }
        else if (_syncStatus == "done")
        {
            <span class="bottom-nav-sync" style="position:absolute;top:4px;right:8px;pointer-events:none;"><img src="icons/cloud-check.svg" class="icon-line" style="width:14px;height:14px;opacity:0.6;" /></span>
        }
        else if (_syncStatus == "error")
        {
            <span class="bottom-nav-sync" style="position:absolute;top:4px;right:8px;pointer-events:none;"><img src="icons/cloud-slash.svg" class="icon-line" style="width:14px;height:14px;opacity:0.7;color:#c03030;" /></span>
        }
        <NavLink href="" Match="NavLinkMatch.All" class="bottom-nav-item">
            <span class="bottom-nav-icon"><img src="icons/house-line.svg" class="icon-line" style="width:24px;height:24px;" /></span><span class="bottom-nav-label">홈</span>
        </NavLink>
        <NavLink href="schedule" class="bottom-nav-item">
            <span class="bottom-nav-icon"><img src="icons/calendar-dots.svg" class="icon-line" style="width:24px;height:24px;" /></span><span class="bottom-nav-label">뜨케줄</span>
        </NavLink>
        <NavLink href="stats" class="bottom-nav-item">
            <span class="bottom-nav-icon"><img src="icons/chart-bar.svg" class="icon-line" style="width:24px;height:24px;" /></span><span class="bottom-nav-label">통계</span>
        </NavLink>
        <NavLink href="settings" class="bottom-nav-item">
            <span class="bottom-nav-icon"><img src="icons/gear.svg" class="icon-line" style="width:24px;height:24px;" /></span><span class="bottom-nav-label">설정</span>
        </NavLink>
    </nav>
</div>

@code {
    string _currentTheme = "mono";
    bool _isDark = false;

    // 다크모드/테마 변경 이벤트 (Settings 등 다른 페이지에서 구독)
    public static event Action<bool>? OnDarkChanged;
    public static event Action<string>? OnThemeChanged;
    public static void InvokeDarkChanged(bool isDark) => OnDarkChanged?.Invoke(isDark);
    public static async Task ForceShowInstallGuideAsync() { await Task.CompletedTask; } // JS interop으로 대체됨
    int _finished;
    string _todayTime = "0분";
    private PeriodicTimer? _sidebarTimer;
    private PeriodicTimer? _pollTimer;
    bool _isSyncing = false;
    string _syncStatus = "";
    System.Threading.CancellationTokenSource? _syncDoneCts;
    DotNetObjectReference<MainLayout>? _visibilityRef;
    MigrationProgress? _migration;
    bool _showUpdateToast = false;
    string _newVersion = "";
    bool _showInstallGuide = false;
    bool _neverShowInstall = false;

    protected override async Task OnInitializedAsync()
    {
        await RefreshStats();
        StartSidebarTimer();
        StartPollTimer();
        Auth.OnAuthChanged += OnAuthChanged;
        Storage.OnMigrationProgress += OnMigrationProgress;
    }

    void OnAuthChanged()
    {
        InvokeAsync(async () =>
        {
            StateHasChanged();
            if (Auth.IsLoggedIn)
                await SyncWithStatusAsync();
        });
    }

    async Task SignIn()
    {
        await Auth.SignInWithGoogleAsync();
    }

    async Task SignOut()
    {
        await Auth.SignOutAsync();
        StateHasChanged();
    }

    async Task RefreshStats()
    {
        var projects = await Storage.GetProjectsAsync();
        _finished = projects.Count(p => p.Status == ProjectStatus.완료);

        // 완료된 세션 + 현재 진행 중인 세션(실시간) 합산
        var todaySecs = projects
            .SelectMany(p => p.Sessions)
            .Where(s => s.StartTime.Date == DateTime.Today)
            .Sum(s =>
            {
                var end = s.EndTime ?? (s.IsActive ? DateTime.Now : s.StartTime);
                return (int)((end - s.StartTime).TotalSeconds);
            });
        _todayTime = FormatTime(todaySecs);
    }

    // ── 동기화 헬퍼 (상태 표시 포함) ──────────────────────────────
    async Task SyncWithStatusAsync(bool push = false)
    {
        if (!Auth.IsLoggedIn || _isSyncing) return;
        _isSyncing = true;
        _syncStatus = "syncing";
        _syncDoneCts?.Cancel();
        StateHasChanged();
        bool syncOk = true;
        try
        {
            if (push)
                await Storage.PushLocalToFirebaseAsync();
            else
                await Storage.SyncOnLoginAsync();
            await RefreshStats();
        }
        catch { syncOk = false; }
        _isSyncing = false;
        _syncStatus = syncOk ? "done" : "error";
        if (!syncOk)
        {
            await JS.InvokeVoidAsync("showToast", "동기화 실패", "error");
        }
        StateHasChanged();
        // 2초 후 상태 아이콘 사라짐
        _syncDoneCts = new System.Threading.CancellationTokenSource();
        var token = _syncDoneCts.Token;
        _ = Task.Delay(2000, token).ContinueWith(t =>
        {
            if (!t.IsCanceled) InvokeAsync(() => { _syncStatus = ""; StateHasChanged(); });
        });
    }

    // ── 2분 폴링 타이머 ────────────────────────────────────────────
    void StartPollTimer()
    {
        _pollTimer = new PeriodicTimer(TimeSpan.FromMinutes(5));
        _ = RunPollTimerAsync();
    }

    async Task RunPollTimerAsync()
    {
        try
        {
            while (_pollTimer is not null && await _pollTimer.WaitForNextTickAsync())
            {
                // 로그인 상태이고 앱이 포그라운드일 때만 sync
                var isVisible = await JS.InvokeAsync<bool>("eval", "document.visibilityState === 'visible'");
                if (isVisible)
                    await SyncWithStatusAsync();
            }
        }
        catch (OperationCanceledException) { }
    }

    void StartSidebarTimer()
    {
        _sidebarTimer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        _ = RunSidebarTimerAsync();
    }

    async Task RunSidebarTimerAsync()
    {
        try
        {
            while (_sidebarTimer is not null && await _sidebarTimer.WaitForNextTickAsync())
            {
                await RefreshStats();
                StateHasChanged();
            }
        }
        catch (OperationCanceledException) { }
    }

    string FormatTime(int secs)
    {
        var h = secs / 3600;
        var m = (secs % 3600) / 60;
        var s = secs % 60;
        if (h > 0) return $"{h}시간 {m:D2}분 {s:D2}초";
        if (m > 0) return $"{m}분 {s:D2}초";
        return secs > 0 ? $"{s}초" : "0분";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Auth.InitAsync();
            var theme = await JS.InvokeAsync<string?>("localStorage.getItem", "knitlog_theme");
            if (!string.IsNullOrEmpty(theme)) _currentTheme = theme;
            var dark = await JS.InvokeAsync<string?>("localStorage.getItem", "knitlog_dark");
            _isDark = dark == "true";
            await ApplyTheme(_currentTheme);
            await ApplyDark(_isDark);
            // 앱 포그라운드 복귀 감지 등록
            _visibilityRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("registerVisibilitySync", _visibilityRef);
            await JS.InvokeVoidAsync("registerOnlineSync", _visibilityRef);
            // 업데이트 버전 체크
            await CheckVersionUpdateAsync();
            // 홈화면 추가 안내 팝업 체크
            await JS.InvokeVoidAsync("registerInstallGuideListener", _visibilityRef);
            await Task.Delay(2000);
            await CheckInstallGuideAsync();
            StateHasChanged();
        }
    }

    async Task ToggleDark()
    {
        _isDark = !_isDark;
        await JS.InvokeVoidAsync("localStorage.setItem", "knitlog_dark", _isDark.ToString().ToLower());
        await ApplyDark(_isDark);
        OnDarkChanged?.Invoke(_isDark);
    }

    async Task ApplyTheme(string id) =>
        await JS.InvokeVoidAsync("eval", $"document.documentElement.setAttribute('data-theme','{id}')");

    async Task ApplyDark(bool dark)
    {
        await JS.InvokeVoidAsync("eval", $"document.documentElement.setAttribute('data-dark','{dark.ToString().ToLower()}')");
        var color = dark ? "#1a1a1a" : "#ffffff";
        await JS.InvokeVoidAsync("eval", $"(function(){{var m=document.querySelector('meta[name=\"theme-color\"]');if(m)m.setAttribute('content','{color}');}})()");
    }

    void OnMigrationProgress(MigrationProgress p)
    {
        _migration = p.Total == 0 ? null : p;
        InvokeAsync(StateHasChanged);
    }

    bool _isAndroidInstall = false; // true면 Android 프롬프트 방식

    [Microsoft.JSInterop.JSInvokable]
    public async Task HandleForceShowInstall()
    {
        _isAndroidInstall = false;
        _showInstallGuide = true;
        await InvokeAsync(StateHasChanged);
    }

    async Task CheckInstallGuideAsync()
    {
        try
        {
            var never = await JS.InvokeAsync<string?>("localStorage.getItem", "knitday_install_guide_dismissed");
            if (never == "1") return;

            // 이미 standalone(홈화면 앱)이면 표시 안 함
            var isStandalone = await JS.InvokeAsync<bool>("pwaInstall.isStandalone");
            if (isStandalone) return;

            // Android Chrome만: beforeinstallprompt 이벤트 확인 (PC 제외)
            try
            {
                var isAndroid = await JS.InvokeAsync<bool>("pwaInstall.isAndroid");
                if (isAndroid)
                {
                    var canPrompt = await JS.InvokeAsync<bool>("pwaInstall.canPrompt");
                    if (canPrompt)
                    {
                        _isAndroidInstall = true;
                        _showInstallGuide = true;
                        return;
                    }
                }
            }
            catch { }

            // iOS Safari 수동 안내
            var isIosSafari = await JS.InvokeAsync<bool>("pwaInstall.isIosSafari");
            if (isIosSafari)
            {
                _isAndroidInstall = false;
                _showInstallGuide = true;
                StateHasChanged();
            }
        }
        catch { }
    }

    async Task DismissInstallGuide()
    {
        if (_neverShowInstall)
            await JS.InvokeVoidAsync("localStorage.setItem", "knitday_install_guide_dismissed", "1");
        _showInstallGuide = false;
        StateHasChanged();
    }

    async Task TriggerAndroidInstall()
    {
        try
        {
            await JS.InvokeAsync<bool>("pwaInstall.prompt");
        }
        catch { }
        _showInstallGuide = false;
        StateHasChanged();
    }

    void ToggleNeverShowInstall()
    {
        _neverShowInstall = !_neverShowInstall;
        StateHasChanged();
    }

    async Task CheckVersionUpdateAsync()
    {
        try
        {
            var lastSeen = await JS.InvokeAsync<string?>("localStorage.getItem", "knitday_last_version");
            var info = await Http.GetFromJsonAsync<VersionInfo>("version.json");
            if (info == null) return;
            // 처음 실행이거나 버전이 달라졌으면 토스트 표시
            if (!string.IsNullOrEmpty(lastSeen) && lastSeen != info.Version)
            {
                _newVersion = info.Version;
                _showUpdateToast = true;
            }
            // 현재 버전을 저장 (다음 실행 시 비교 기준)
            await JS.InvokeVoidAsync("localStorage.setItem", "knitday_last_version", info.Version);
        }
        catch { }
    }

    async Task OnUpdateToastClick()
    {
        _showUpdateToast = false;
        Nav.NavigateTo("settings");
        await Task.CompletedTask;
    }

    void DismissUpdateToast() => _showUpdateToast = false;

    record VersionInfo(
        [property: System.Text.Json.Serialization.JsonPropertyName("version")] string Version,
        [property: System.Text.Json.Serialization.JsonPropertyName("date")] string Date,
        [property: System.Text.Json.Serialization.JsonPropertyName("updates")] List<string> Updates
    );

    [Microsoft.JSInterop.JSInvokable]
    public async Task OnAppResumed()
    {
        // 포그라운드 복귀 시 즉시 pull
        await SyncWithStatusAsync();
    }

    [Microsoft.JSInterop.JSInvokable]
    public async Task OnAppHidden()
    {
        // 백그라운드 진입 / 앱 종료 시: 진행 중인 세션 자동 종료 후 저장
        try
        {
            var projects = await Storage.GetProjectsAsync();
            bool changed = false;
            foreach (var p in projects)
            {
                var active = p.Sessions.FirstOrDefault(s => s.IsActive);
                if (active != null)
                {
                    active.EndTime = DateTime.Now;
                    await Storage.SaveProjectAsync(p);
                    changed = true;
                }
            }
            if (changed)
                await Storage.PushLocalToFirebaseAsync();
        }
        catch { }
    }

    [Microsoft.JSInterop.JSInvokable]
    public async Task OnBackOnline()
    {
        // 온라인 복귀 시 로컬 내용 push 후 최신 pull
        await SyncWithStatusAsync(push: true);
        // 오프라인 중 놓쳤을 수 있는 업데이트 체크
        await CheckVersionUpdateAsync();
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        _sidebarTimer?.Dispose();
        _sidebarTimer = null;
        _pollTimer?.Dispose();
        _pollTimer = null;
        _syncDoneCts?.Cancel();
        _syncDoneCts?.Dispose();
        Auth.OnAuthChanged -= OnAuthChanged;
        Storage.OnMigrationProgress -= OnMigrationProgress;
        _visibilityRef?.Dispose();
        _visibilityRef = null;
        try { await JS.InvokeVoidAsync("unregisterOnlineSync"); } catch { }
        return;
    }
}
